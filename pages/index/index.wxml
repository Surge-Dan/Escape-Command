<!-- 出逃指令 · 首页 v20: 3D骰子 + 冰蓝背景 -->
<view class="home-page {{theme}}">
  <view class="status-bar" style="height:{{statusBarHeight}}px"></view>

  <scroll-view class="home-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- ===== Hero 首屏：标题 + 日期 + 问候 + 3D骰子 ===== -->
    <view class="hero-section">
      <!-- 居中标题 -->
      <view class="hero-title">出逃指令</view>

      <!-- 日期胶囊 -->
      <view class="date-pill">
        <text>{{dateText}}</text>
      </view>

      <!-- 问候语 -->
      <view class="greeting-area">
        <text class="greeting-prefix">{{greetingText}}，</text>
        <text class="greeting-emphasis">{{heroEmphasis}}</text>
        <text class="greeting-suffix">{{heroTail}}</text>
      </view>
      <view class="hero-sub">{{heroSubText}}</view>

      <!-- 3D骰子舞台（预渲染斜角图 + CSS变换模拟3D） -->
      <view
        class="dice-stage-3d"
        bindtouchstart="onTouchStart"
        bindtouchend="onTouchEnd"
        bindtap="onRollTap"
      >
        <view
          wx:for="{{diceList}}"
          wx:key="id"
          class="die-item die-pos-{{dicePositions[item.id]}}"
          data-dice-id="{{item.id}}"
          data-index="{{index}}"
          catchtap="onDiceTap"
        >
          <image
            class="die-img"
            src="{{currentDiceFace[item.id]}}"
            mode="aspectFit"
            binderror="onDiceImgError"
            bindload="onDiceImgLoad"
            data-dice-id="{{item.id}}"
            data-dice-index="{{index}}"
          ></image>
        </view>
      </view>

      <!-- 模式名称胶囊（点击投掷） -->
      <view class="mode-name-pill" bindtap="onRollTap">{{currentModeName}}</view>
      <view class="roll-hint-text" bindtap="onRollTap">点击投掷</view>

      <!-- 圆点指示器 -->
      <view class="dice-indicators">
        <view
          wx:for="{{diceList}}"
          wx:key="id"
          class="indicator-dot {{currentDiceIndex === index ? 'active' : ''}}"
          data-index="{{index}}"
          bindtap="onDiceIndicatorTap"
        ></view>
      </view>
    </view>

    <!-- ===== 下方内容区（下滑可见） ===== -->
    <view class="below-fold">
      <!-- 收藏入口 -->
      <view wx:if="{{collectedCount === 0}}" class="collect-entry-mini" bindtap="goCollection">
        <image class="collect-mini-ico" src="/assets/icons/bookmark.svg" mode="aspectFit"></image>
        <text class="collect-mini-text">还没有收藏的指令，摇一个收藏吧</text>
        <image class="collect-mini-arrow" src="/assets/icons/chevron-right-faint.svg" mode="aspectFit"></image>
      </view>
      <view wx:else class="collect-entry-card" bindtap="goCollection">
        <view class="collect-entry-icon-wrap">
          <image class="collect-entry-ico" src="/assets/icons/bookmark-brand.svg" mode="aspectFit"></image>
        </view>
        <view class="collect-entry-text">
          <text class="collect-entry-title">我的收藏</text>
          <text class="collect-entry-sub">已收藏 {{collectedCount}} 条出逃指令</text>
        </view>
        <image class="collect-arrow" src="/assets/icons/chevron-right-brand.svg" mode="aspectFit"></image>
      </view>

      <!-- 上次出逃记录 -->
      <view wx:if="{{lastRecord}}" class="last-record-card" bindtap="goRecordDetail" data-id="{{lastRecord.id}}">
        <view class="last-record-head">
          <view class="last-record-tag" style="background:{{lastRecord.typeColor}}20; color:{{lastRecord.typeColor}}">
            {{lastRecord.typeName}}
          </view>
          <text class="last-record-date">{{lastRecord.dateLabel}}</text>
        </view>
        <text class="last-record-title">{{lastRecord.commandTitle}}</text>
        <view class="last-record-meta">
          <view class="last-record-meta-item">
            <image class="last-record-meta-ico" src="/assets/icons/clock-brand.svg" mode="aspectFit"></image>
            <text>{{lastRecord.duration}}分钟</text>
          </view>
          <view wx:if="{{lastRecord.mood}}" class="last-record-meta-item">
            <text>{{lastRecord.mood}}</text>
          </view>
        </view>
      </view>

      <!-- 今日推荐 -->
      <view wx:if="{{dailyRecommend.length > 0}}" class="recommend-section">
        <view class="section-header">
          <text class="section-title">今日推荐</text>
          <text class="section-sub">基于{{weatherText || '天气'}}和时间为你挑选</text>
        </view>
        <scroll-view class="daily-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view
            wx:for="{{dailyRecommend}}"
            wx:key="id"
            class="rec-card"
            bindtap="onRecommendTap"
            data-id="{{item.id}}"
          >
            <view class="rec-type" style="background:{{item.typeColor}}20; color:{{item.typeColor}}">
              {{item.typeName}}
            </view>
            <text class="rec-title">{{item.title}}</text>
            <view class="rec-meta">
              <text class="rec-duration">{{item.duration}}分钟</text>
              <text class="rec-dist">{{item.distance || '附近'}}</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- 最近出逃 -->
      <view wx:if="{{recentRecords.length > 0}}" class="recent-section">
        <view class="section-header">
          <text class="section-title">最近出逃</text>
        </view>
        <scroll-view class="daily-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view
            wx:for="{{recentRecords}}"
            wx:key="id"
            class="daily-card"
            bindtap="goRecordDetail"
            data-id="{{item.id}}"
          >
            <view class="daily-type" style="background:{{item.typeColor}}20; color:{{item.typeColor}}">
              {{item.typeName}}
            </view>
            <text class="daily-title">{{item.commandTitle}}</text>
            <text class="daily-meta">{{item.dateLabel}} · {{item.duration}}分钟</text>
          </view>
        </scroll-view>
      </view>

      <view class="bottom-spacer"></view>
    </view>
  </scroll-view>

  <!-- ===== 指令详情卡（遮罩+卡片） ===== -->
  <view wx:if="{{selectedCommand}}" class="cmd-overlay" catchtap="closeCommand">
    <view class="cmd-sheet" catchtap="noop">
      <view class="cmd-card">
        <view class="cmd-close" catchtap="closeCommand">
          <image src="/assets/icons/x-ink-faint.svg" mode="aspectFit"></image>
        </view>
        <view class="favorite-toggle {{collected ? 'active' : ''}}" catchtap="collectCmd">
          <image src="{{collected ? '/assets/icons/bookmark-brand.svg' : '/assets/icons/bookmark.svg'}}" mode="aspectFit"></image>
        </view>

        <view wx:if="{{friendRollHint}}" class="invite-tag friend-roll-tag">🎲 朋友替你摇的</view>
        <view wx:elif="{{invitedByFriend}}" class="invite-tag">来自朋友的邀请</view>

        <view class="cmd-type-row">
          <view class="cmd-type" style="background:{{selectedCommand.typeColor}}20; color:{{selectedCommand.typeColor}}">
            <image class="type-ico" src="{{selectedCommand.typeIcon}}" mode="aspectFit"></image>
            <text>{{selectedCommand.typeName}}</text>
          </view>
        </view>

        <text class="cmd-title">{{selectedCommand.title || selectedCommand.content}}</text>

        <view class="cmd-image-wrap">
          <view class="cmd-image-bg">
            <image class="cmd-image-icon" src="{{selectedCommand.typeIcon}}" mode="aspectFit"></image>
          </view>
          <image class="cmd-image" src="{{selectedCommand.illustration}}" mode="aspectFill"></image>
        </view>

        <view class="cmd-meta">
          <view class="meta-item">
            <image src="/assets/icons/clock-brand.svg" mode="aspectFit"></image>
            <text>{{selectedCommand.duration}}分钟</text>
          </view>
          <view class="meta-item">
            <image src="/assets/icons/navigation-brand.svg" mode="aspectFit"></image>
            <text>{{selectedCommand.distance || '附近'}}</text>
          </view>
          <view class="meta-item">
            <image src="/assets/icons/users-lavender.svg" mode="aspectFit"></image>
            <text>{{selectedCommand.people || '1人'}}</text>
          </view>
        </view>

        <view class="tip-box">
          <view class="tip-head">
            <view class="tip-icon-dot"></view>
            <text class="tip-label">小贴士</text>
          </view>
          <text class="tip-text">{{selectedCommand.tip || '按自己的节奏，享受这段出逃时光。'}}</text>
        </view>

        <view class="cmd-actions">
          <button class="action-btn secondary" catchtap="reroll">
            <image src="/assets/icons/refresh-cw-ink-soft.svg" mode="aspectFit"></image>
          </button>
          <button class="action-btn primary" catchtap="startCommand">开始出逃</button>
        </view>

        <view class="reroll-hint">重掷消耗一次机会，次数每日0点重置</view>
      </view>
    </view>
  </view>

  <!-- ===== 微逃时长选择弹窗（dice-micro-7d 已替代，保留兜底） ===== -->
  <!-- 微逃改走 dice-micro-7d 页面，不再使用此弹窗 -->

  <!-- ===== 同频骰子入口选择弹层 ===== -->
  <view wx:if="{{showDiceSheet}}" class="dice-sheet-mask" bindtap="onDiceSheetMaskTap">
    <view class="dice-sheet-panel" catchtap="noop">
      <view class="dice-sheet-handle"></view>
      <view class="dice-sheet-header">
        <text class="dice-sheet-title">选择出逃方式</text>
        <view class="dice-sheet-close" bindtap="onDiceSheetClose">✕</view>
      </view>
      <view class="dice-sheet-option" bindtap="onInviteFriendsTap">
        <text class="dice-option-icon">👥</text>
        <view class="dice-option-info">
          <text class="dice-option-label">邀请好友</text>
          <text class="dice-option-desc">创建房间，邀请朋友一起出逃</text>
        </view>
        <text class="dice-option-arrow">›</text>
      </view>
      <view class="dice-sheet-option" bindtap="onEnterHallTap">
        <text class="dice-option-icon">🏛</text>
        <view class="dice-option-info">
          <text class="dice-option-label">出逃大厅</text>
          <text class="dice-option-desc">加入公开房间，认识新朋友</text>
        </view>
        <text class="dice-option-arrow">›</text>
      </view>
      <view class="dice-sheet-option dice-sheet-option-highlight" bindtap="onQuickMatchTap">
        <text class="dice-option-icon">🤖</text>
        <view class="dice-option-info">
          <text class="dice-option-label">AI 快速匹配</text>
          <text class="dice-option-desc">根据画像为你匹配同频伙伴</text>
        </view>
        <text class="dice-option-arrow">›</text>
      </view>
      <view class="dice-sheet-cancel" bindtap="onDiceSheetClose">取消</view>
    </view>
  </view>

  <!-- 自定义 TabBar 由框架自动注入，通过 getTabBar().setData() 控制显隐 -->
</view>
