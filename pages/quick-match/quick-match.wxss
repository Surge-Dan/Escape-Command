/* packageSync/pages/quick-match/quick-match.wxss */
/* B3 同频骰子 AI 快速匹配结果页样式 */

.qm-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: var(--bg-gradient);
}

.status-bar { flex-shrink: 0; background: transparent; }

/* 导航栏复用全局 .nav-header / .nav-header-back / .nav-header-title / .nav-header-divider
   仅补 flex-shrink:0 让它在 flex 列布局里不被挤压 */
.nav-header { flex-shrink: 0; }

.qm-scroll {
  flex: 1;
  height: 0;
  padding: 0 32rpx 32rpx;
}

/* ===== 加载态 ===== */
.qm-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.loading-dice-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.loading-dice {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-2xl);
  background: var(--white);
  box-shadow: 0 4rpx 24rpx rgba(91, 143, 185, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: diceSpin 1.6s ease-in-out infinite;
  z-index: 1;
}

.loading-dice-ico {
  width: 72rpx;
  height: 72rpx;
}

@keyframes diceSpin {
  0% { transform: rotate(0deg) scale(1); }
  25% { transform: rotate(-90deg) scale(1.05); }
  50% { transform: rotate(-180deg) scale(0.95); }
  75% { transform: rotate(-270deg) scale(1.05); }
  100% { transform: rotate(-360deg) scale(1); }
}

.loading-pulse-ring {
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(91, 143, 185, 0.3);
  animation: loadingPulse 2s ease-in-out infinite;
}

.loading-pulse-ring-delay {
  animation-delay: 1s;
}

@keyframes loadingPulse {
  0%, 100% { opacity: 0; transform: scale(0.85); }
  50% { opacity: 0.6; transform: scale(1.15); }
}

.loading-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
  font-family: var(--serif);
}

.loading-sub {
  font-size: 24rpx;
  color: var(--ink-soft);
  letter-spacing: 0.5rpx;
}

/* ===== 错误态 ===== */
.qm-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 180rpx;
}

.error-emoji {
  font-size: 96rpx;
  margin-bottom: 32rpx;
}

.error-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 16rpx;
  font-family: var(--serif);
}

.error-desc {
  font-size: 26rpx;
  color: var(--ink-soft);
  text-align: center;
  margin-bottom: 48rpx;
  padding: 0 40rpx;
}

.error-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
  padding: 0 40rpx;
}

.error-retry-btn {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand);
  color: var(--white);
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--radius-lg);
  letter-spacing: 1rpx;
  box-shadow: var(--shadow-btn);
}

.error-back-btn {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: var(--ink-soft);
  font-size: 28rpx;
  border-radius: var(--radius-lg);
}

/* ===== 成功态：主题标签 ===== */
.qm-theme-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 16rpx;
}

.qm-theme-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
}

.qm-theme-icon {
  font-size: 28rpx;
}

.qm-theme-name {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.qm-meta-row {
  display: flex;
  align-items: center;
}

.qm-meta-text {
  font-size: 22rpx;
  color: var(--ink-faint);
}

/* ===== 任务卡 ===== */
.qm-task-card {
  background: var(--white);
  border: var(--border);
  border-radius: var(--radius-xl);
  padding: 32rpx 28rpx 24rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 24rpx;
}

.qm-task-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.qm-task-type-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  font-weight: 600;
}

.qm-task-type-ico {
  width: 24rpx;
  height: 24rpx;
}

.qm-task-match-badge {
  padding: 6rpx 14rpx;
  border-radius: var(--radius-pill);
  background: var(--brand-weak);
  font-size: 20rpx;
  color: var(--ink-faint);
  letter-spacing: 0.5rpx;
}

.qm-task-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.4;
  margin-bottom: 12rpx;
  letter-spacing: 0.5rpx;
  font-family: var(--serif);
}

.qm-task-distance {
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-bottom: 16rpx;
}

.qm-task-steps {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.qm-step {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.qm-step-num {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  margin-top: 2rpx;
}

.qm-step-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.5;
}

.qm-task-actions {
  display: flex;
  justify-content: flex-end;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--line);
}

.qm-regenerate-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: var(--canvas);
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  color: var(--ink-soft);
  transition: all 150ms var(--ease-standard);
}

.qm-regenerate-btn:active { transform: scale(0.96); }

.qm-regenerate-btn.is-disabled {
  opacity: 0.5;
  pointer-events: none;
}

.qm-regenerate-ico {
  width: 24rpx;
  height: 24rpx;
}

/* ===== 搭子卡 ===== */
.qm-partners-card {
  background: var(--white);
  border: var(--border);
  border-radius: var(--radius-xl);
  padding: 28rpx 24rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-card);
}

.qm-section-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  font-family: var(--serif);
}

.qm-section-sub {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--ink-faint);
}

.qm-partners-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.qm-partners-empty-emoji {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.qm-partners-empty-text {
  font-size: 24rpx;
  color: var(--ink-soft);
  text-align: center;
}

.qm-partners-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.qm-partner-item {
  width: calc((100% - 20rpx) / 2);
  background: var(--brand-weak);
  border: 1rpx solid var(--border-soft);
  border-radius: var(--radius-lg);
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 150ms var(--ease-standard);
}

.qm-partner-item:active { transform: scale(0.96); }

.qm-partner-avatar-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 12rpx;
}

.qm-partner-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--brand-tint);
}

.qm-partner-real-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: var(--brand);
  color: var(--white);
  font-size: 16rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--white);
}

.qm-partner-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 4rpx;
}

.qm-partner-bio {
  font-size: 20rpx;
  color: var(--ink-faint);
  text-align: center;
  line-height: 1.4;
}

/* ===== 开始出逃按钮 ===== */
.qm-start-btn {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-lg);
  color: var(--white);
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: var(--shadow-btn);
  transition: all 200ms var(--ease-standard);
}

.qm-start-btn:active { transform: scale(0.98); }

.qm-start-btn.is-disabled {
  opacity: 0.6;
  pointer-events: none;
}

.qm-disclaimer {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-faint);
  padding: 24rpx 0 16rpx;
  letter-spacing: 0.5rpx;
}

.bottom-spacer { height: calc(32rpx + var(--safe-bottom)); }
