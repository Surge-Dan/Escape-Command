<view class="custom-tabbar">
  <view
    wx:for="{{list}}"
    wx:key="index"
    class="tabbar-item {{selected === index ? 'active' : ''}}"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tabbar-icon-wrap">
      <image
        class="tabbar-icon"
        src="{{selected === index ? item.iconActive : item.icon}}"
        mode="aspectFit"
      ></image>
    </view>
    <text class="tabbar-label">{{item.text}}</text>
  </view>
</view>
<view class="tabbar-placeholder"></view>
