/* ===== 成就系统页 · 浅雾蓝设计系统 ===== */
.page-scroll { padding: 0; }
.ach-body { padding: 24rpx 40rpx 0; }

/* ===== 顶部总览卡 ===== */
.overview-card {
  position: relative;
  background: linear-gradient(135deg, #FFFFFF 0%, var(--brand-tint) 100%);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
  padding: 40rpx 32rpx;
  margin-bottom: 40rpx;
  overflow: hidden;
  text-align: center;
}
.overview-glow {
  position: absolute;
  top: -100rpx;
  right: -80rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(91, 143, 185, 0.18) 0%, transparent 70%);
  filter: blur(20rpx);
  pointer-events: none;
}
.overview-eyebrow {
  display: block;
  font-size: 24rpx;
  color: var(--ink-soft);
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 2;
}
.overview-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 2;
}
.overview-big {
  font-size: 96rpx;
  font-weight: 700;
  color: var(--brand-strong);
  line-height: 1;
  font-family: var(--serif);
}
.overview-unit {
  font-size: 28rpx;
  color: var(--ink-soft);
}
.overview-sub {
  display: block;
  font-size: 24rpx;
  color: var(--ink-soft);
  position: relative;
  z-index: 2;
  letter-spacing: 0.3rpx;
}

/* ===== Section 标题 ===== */
.section-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 8rpx 4rpx 20rpx;
}
.section-title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 2rpx;
  font-family: var(--serif);
}
.section-title-meta {
  font-size: 24rpx;
  color: var(--ink-faint);
  letter-spacing: 0.5rpx;
}

/* ===== 里程碑卡 ===== */
.milestone-list { display: flex; flex-direction: column; gap: 20rpx; margin-bottom: 40rpx; }

.milestone-card {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 28rpx 24rpx;
  border-radius: var(--radius-xl);
  background: var(--white);
  border: var(--border);
  box-shadow: var(--shadow-card);
  transition: transform 150ms var(--ease-standard), box-shadow 150ms var(--ease-standard);
}
.milestone-card.unlocked {
  background: linear-gradient(135deg, #FFFBF0 0%, #FFFFFF 100%);
  border: 2rpx solid rgba(212, 160, 86, 0.35);
  box-shadow: 0 4rpx 20rpx rgba(212, 160, 86, 0.15);
}
.milestone-card:active { transform: scale(0.99); box-shadow: var(--shadow-elevated); }

.milestone-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--brand-weak);
  box-shadow: inset 0 0 0 2rpx rgba(91, 143, 185, 0.08);
}
.milestone-card.unlocked .milestone-icon-wrap {
  background: linear-gradient(135deg, var(--gold-tint) 0%, var(--white) 100%);
  box-shadow: 0 4rpx 16rpx rgba(255, 211, 107, 0.4);
}
.milestone-icon-wrap image { width: 44rpx; height: 44rpx; }

.milestone-body { flex: 1; min-width: 0; }
.milestone-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}
.milestone-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
  font-family: var(--serif);
}
.milestone-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  background: var(--gold-tint);
  color: var(--gold);
  font-weight: 600;
  flex-shrink: 0;
  letter-spacing: 0.3rpx;
}
.milestone-tag.ghost {
  background: var(--canvas);
  color: var(--ink-faint);
}
.milestone-desc {
  display: block;
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.6;
  margin-bottom: 12rpx;
  letter-spacing: 0.3rpx;
}
.milestone-progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.milestone-track {
  flex: 1;
  height: 12rpx;
  background: var(--canvas);
  border-radius: 6rpx;
  overflow: hidden;
}
.milestone-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--brand), var(--brand-strong));
  border-radius: 6rpx;
  transition: width 600ms var(--ease-standard);
  box-shadow: 0 0 8rpx rgba(91, 143, 185, 0.3);
}
.milestone-percent {
  font-size: 22rpx;
  color: var(--ink-faint);
  width: 64rpx;
  text-align: right;
  letter-spacing: 0.3rpx;
}
.milestone-date {
  display: block;
  font-size: 22rpx;
  color: var(--gold);
  margin-top: 4rpx;
  font-weight: 500;
  letter-spacing: 0.3rpx;
}

/* ===== 连击记录卡 ===== */
.streak-card {
  background: var(--white);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
  padding: 32rpx 28rpx;
  margin-bottom: 40rpx;
}
.streak-top {
  display: flex;
  align-items: stretch;
  margin-bottom: 32rpx;
}
.streak-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.streak-divider {
  width: 2rpx;
  background: var(--line);
  margin: 0 24rpx;
}
.streak-label {
  font-size: 24rpx;
  color: var(--ink-soft);
  letter-spacing: 0.5rpx;
}
.streak-num-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}
.streak-num {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--brand-strong);
  line-height: 1;
  font-family: var(--serif);
}
.streak-num-unit {
  font-size: 26rpx;
  color: var(--ink-soft);
}

.streak-week {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 4rpx 0;
}
.streak-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.streak-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-weak);
  box-shadow: inset 0 0 0 2rpx rgba(91, 143, 185, 0.08);
  transition: transform 200ms var(--ease-bounce);
}
.streak-dot image { width: 28rpx; height: 28rpx; }
.streak-day.on .streak-dot {
  background: linear-gradient(135deg, var(--brand-tint) 0%, var(--white) 100%);
  box-shadow: 0 4rpx 14rpx rgba(91, 143, 185, 0.3);
}
.streak-day-label {
  font-size: 20rpx;
  color: var(--ink-faint);
  letter-spacing: 0.5rpx;
}

/* ===== 统计数据网格 ===== */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 40rpx;
}
.stats-cell {
  width: calc(50% - 8rpx);
  background: var(--white);
  border-radius: var(--radius-lg);
  border: var(--border);
  box-shadow: var(--shadow-card);
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  transition: transform 150ms var(--ease-standard), box-shadow 150ms var(--ease-standard);
}
.stats-cell:active { transform: scale(0.98); box-shadow: var(--shadow-elevated); }
.stats-value {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1;
  font-family: var(--serif);
}
.stats-value-sub {
  font-size: 22rpx;
  color: var(--ink-faint);
  margin-top: -4rpx;
  letter-spacing: 0.3rpx;
}
.stats-label {
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-top: 4rpx;
  letter-spacing: 0.5rpx;
}

.bottom-spacer { height: calc(80rpx + var(--safe-bottom)); }
