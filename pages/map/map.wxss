/* v4 重构 · 浅雾蓝设计系统改造 */
.map-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: var(--bg-gradient);
}

/* 地图页顶部状态栏与导航栏统一白色背景（不再透出页面蓝色渐变） */
.map-page .status-bar { background: #ffffff; }

/* 地图页导航栏：白色背景（与地图卡片融为一体，不再透出页面蓝底） */
.map-page .nav-header {
  background: #ffffff;
  border-bottom: 1rpx solid rgba(91, 143, 185, 0.08);
  margin-bottom: 0;
}

/* ===== 简洁主题区：标题与城市 pill 左右排列 ===== */
.map-theme {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  padding: 28rpx 24rpx 28rpx 40rpx;
  background: transparent;
}

.map-theme-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.map-theme-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
  font-family: var(--serif);
  letter-spacing: 1rpx;
}

.map-theme-sub {
  display: block;
  font-size: 24rpx;
  color: var(--ink-faint);
  line-height: 1.4;
}

/* ===== 城市入口 pill ===== */
.map-city-pill {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid var(--border-soft);
  gap: 8rpx;
  margin-left: auto;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  transition: transform 150ms var(--ease-standard), background 150ms var(--ease-standard);
}

.map-city-pill:active {
  transform: scale(0.96);
  background: var(--brand-tint);
}

.city-ico {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

.city-name {
  font-size: 24rpx;
  color: var(--ink);
  font-weight: 500;
  max-width: 200rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.city-arrow {
  width: 20rpx;
  height: 20rpx;
  flex-shrink: 0;
}

/* ===== 原生地图 ===== */
.map-native {
  width: 100%;
  flex-shrink: 0;
}

/* ===== 悬浮控件（cover-view，有限 CSS） ===== */

.map-controls {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  flex-direction: column;
  background-color: rgba(255, 255, 255, 0.92);
  border-radius: var(--radius-xl);
  padding: 16rpx;
  border: 1rpx solid var(--border-soft);
  box-shadow: var(--shadow-elevated);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.map-tabs {
  display: flex;
  flex-direction: row;
  background-color: var(--brand-weak);
  border-radius: var(--radius-md);
  padding: 4rpx;
}

.map-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: var(--radius-sm);
  transition: background 200ms var(--ease-standard);
}

.map-tab-text {
  font-size: 26rpx;
  color: var(--ink-soft);
  text-align: center;
}

.map-tab.active {
  background-color: var(--brand);
  box-shadow: 0 2rpx 8rpx rgba(91, 143, 185, 0.25);
}

.map-tab.active .map-tab-text {
  color: var(--white);
  font-weight: 600;
}

.time-chips {
  display: flex;
  flex-direction: row;
  margin-top: 12rpx;
}

.time-chip {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  margin-right: 12rpx;
  border-radius: var(--radius-pill);
  background-color: rgba(255, 255, 255, 0.8);
  border: 1rpx solid var(--border-soft);
  transition: all 180ms var(--ease-standard);
}

.time-chip-text {
  font-size: 24rpx;
  color: var(--ink-soft);
  text-align: center;
}

.time-chip.active {
  background-color: var(--ink);
  border-color: var(--ink);
}

.time-chip.active .time-chip-text {
  color: var(--white);
  font-weight: 500;
}

/* ===== 定位按钮 ===== */
/* v21: summary-bar 顶部 = 288 + 60(高) + safe = 348rpx + safe，locate-btn 留 20rpx 间隙 */
.map-locate-btn {
  position: absolute;
  right: 24rpx;
  bottom: calc(368rpx + env(safe-area-inset-bottom, 34rpx));
  width: 80rpx;
  height: 80rpx;
  background-color: rgba(255, 255, 255, 0.96);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--border-soft);
  box-shadow: 0 4rpx 16rpx rgba(45, 90, 123, 0.12);
  transition: transform 200ms var(--ease-standard), background 200ms var(--ease-standard);
  z-index: 101;
}

.map-locate-btn:active {
  transform: scale(0.92);
  background-color: var(--brand-tint);
  box-shadow: 0 2rpx 8rpx rgba(45, 90, 123, 0.16);
}

/* 定位图标（cover-view + CSS 绘制） */
.locate-icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
}

.locate-ring {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border-width: 4rpx;
  border-style: solid;
  border-color: var(--brand);
  background-color: transparent;
}

.locate-center {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: var(--brand);
}

/* 加号图标（cover-view + CSS 绘制） */
.plus-icon {
  position: relative;
  width: 40rpx;
  height: 40rpx;
}

.plus-h {
  position: absolute;
  top: 18rpx;
  left: 0;
  width: 40rpx;
  height: 4rpx;
  background-color: var(--brand);
  border-radius: 2rpx;
}

.plus-v {
  position: absolute;
  left: 18rpx;
  top: 0;
  width: 4rpx;
  height: 40rpx;
  background-color: var(--brand);
  border-radius: 2rpx;
}

/* ===== 添加/编辑出发点按钮（加号）===== */
/* v21: locate-btn 顶部 = 368 + 80(高) + safe = 448rpx + safe，home-btn 留 20rpx 间隙 */
.map-home-btn {
  position: absolute;
  right: 24rpx;
  bottom: calc(468rpx + env(safe-area-inset-bottom, 34rpx));
  width: 80rpx;
  height: 80rpx;
  background-color: rgba(255, 255, 255, 0.96);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--border-soft);
  box-shadow: 0 4rpx 16rpx rgba(45, 90, 123, 0.12);
  transition: transform 200ms var(--ease-standard), background 200ms var(--ease-standard);
  z-index: 101;
}

.map-home-btn:active {
  transform: scale(0.92);
  background-color: var(--brand-tint);
  box-shadow: 0 2rpx 8rpx rgba(45, 90, 123, 0.16);
}

/* ===== 底部统计条：紧贴 TabBar 上方，与 TabBar 等宽 ===== */
/* v21: 使用 calc + env(safe-area-inset-bottom) 适配不同设备，避免固定值在 iPhone 上与 TabBar 重叠 */
/* TabBar 顶部 = 72rpx(bottom) + 96rpx(height) + safe = 168rpx + safe，stats-bar 留 20rpx 间隙 */
.map-stats-bar {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(188rpx + env(safe-area-inset-bottom, 34rpx));
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid var(--border-soft);
  border-radius: 100rpx;
  padding: 16rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(45, 90, 123, 0.12);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  z-index: 100;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.1;
  letter-spacing: 1rpx;
  font-family: var(--serif);
}

.stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-faint);
}

/* ===== 空状态 ===== */
.map-empty {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.96);
  border-radius: var(--radius-2xl);
  padding: 48rpx 56rpx;
  border: 1rpx solid var(--border-soft);
  box-shadow: var(--shadow-elevated);
}

.empty-illust {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 8rpx;
  text-align: center;
  font-family: var(--serif);
}

.empty-sub {
  font-size: 24rpx;
  color: var(--ink-soft);
  text-align: center;
}

.empty-cta {
  margin-top: 28rpx;
  padding: 18rpx 56rpx;
  background: var(--brand);
  color: var(--white);
  font-size: 28rpx;
  font-weight: 600;
  border-radius: var(--radius-pill);
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(91, 143, 185, 0.30);
}

/* ===== 标记弹窗 ===== */
.map-popup {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 180rpx;
  background-color: var(--white);
  border-radius: var(--radius-2xl);
  padding: 28rpx 28rpx 0;
  border: 1rpx solid var(--border-soft);
  box-shadow: 0 12rpx 40rpx rgba(45, 90, 123, 0.18);
  z-index: 110;
}

.popup-inner {
  display: flex;
  flex-direction: column;
}

/* 顶部头：类型名 + 模式 pill 左右分布 */
.popup-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.popup-type {
  font-size: 22rpx;
  font-weight: 600;
}

.popup-mode-pill {
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  font-size: 20rpx;
  font-weight: 600;
}

.popup-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 6rpx;
  font-family: var(--serif);
}

.popup-date {
  font-size: 22rpx;
  color: var(--ink-faint);
  margin-bottom: 14rpx;
}

/* 缩略图：宽屏横图，圆角 */
.popup-thumb {
  width: 100%;
  height: 200rpx;
  border-radius: var(--radius-md);
  margin-bottom: 14rpx;
  background-color: var(--brand-weak);
}

/* 信息行：搭子 / 时长 / 心情 / 天气 */
.popup-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-bottom: 18rpx;
}

.popup-meta-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.popup-meta-label {
  font-size: 22rpx;
  color: var(--ink-faint);
  width: 80rpx;
  flex-shrink: 0;
}

.popup-meta-val {
  font-size: 24rpx;
  color: var(--ink);
  flex: 1;
}

/* 查看完整记录按钮 */
.popup-cta {
  border-top: 1rpx solid var(--line);
  padding: 22rpx 0;
  margin: 0 -28rpx;
  text-align: center;
}

.popup-cta-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand);
  text-align: center;
}

/* ===== 重返此地按钮 ===== */
.popup-revisit-btn {
  margin-top: 16rpx;
  padding: 12rpx 24rpx;
  background: var(--brand);
  border-radius: var(--radius-pill);
  align-self: flex-start;
}

.popup-revisit-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--white);
  line-height: 1;
}

/* ===== 情绪筛选切换 ===== */
.mood-toggle {
  background: rgba(255, 255, 255, 0.7);
}

.mood-toggle.active {
  background: var(--brand);
}

/* ===== 城市关系总结条（位于统计条上方，互不重叠）===== */
/* v21: stats-bar 顶部 = 188 + 80(高) + safe = 268rpx + safe，summary-bar 留 20rpx 间隙 */
.map-summary-bar {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(288rpx + env(safe-area-inset-bottom, 34rpx));
  padding: 12rpx 24rpx;
  background: rgba(45, 90, 123, 0.85);
  border-radius: 100rpx;
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  z-index: 99;
  overflow: hidden;
  white-space: nowrap;
}

/* 走马灯轨道：宽度 = 2 份文本 + 间隔，无限循环左移 */
.summary-text-track {
  display: flex;
  flex-direction: row;
  align-items: center;
  white-space: nowrap;
  /* 关键：让 track 整体从右向左平移，2 份文本长度循环 */
  animation: summaryMarquee 16s linear infinite;
  will-change: transform;
}

/* 走马灯关键帧：0% 时 track 起点在屏幕外，100% 时向左移动 50%（恰好一份文本的距离） */
@keyframes summaryMarquee {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.summary-text {
  display: inline-block;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #FFFFFF;
  line-height: 1.5;
  /* 两份文本之间留出 40rpx 间隙，避免视觉粘连 */
  padding-right: 40rpx;
  white-space: nowrap;
}

/* ===== 重返此地确认弹窗 ===== */
.revisit-modal {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(45, 90, 123, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.revisit-card {
  width: 560rpx;
  background: var(--white);
  border-radius: var(--radius-2xl);
  padding: 40rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 48rpx rgba(45, 90, 123, 0.24);
}

.revisit-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 16rpx;
  font-family: var(--serif);
}

.revisit-subtitle {
  font-size: 26rpx;
  color: var(--ink-soft);
  line-height: 1.6;
  text-align: center;
  margin-bottom: 32rpx;
}

.revisit-actions {
  display: flex;
  gap: 24rpx;
  width: 100%;
}

.revisit-cancel {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-pill);
  background: var(--brand-weak);
  font-size: 28rpx;
  color: var(--ink-soft);
}

.revisit-confirm {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-pill);
  background: var(--brand);
  font-size: 28rpx;
  font-weight: 600;
  color: var(--white);
  box-shadow: 0 6rpx 20rpx rgba(91, 143, 185, 0.30);
}
