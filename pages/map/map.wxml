<view class="map-page paper-texture theme-{{theme}}">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

  <view class="nav-header" style="{{navHeaderStyle}}">
    <text class="nav-header-title">出逃地图</text>
    <view class="nav-header-divider"></view>
  </view>

  <!-- 简洁主题区：v13 移除 navHeaderStyle，主题区在导航栏下方无需避让胶囊按钮 -->
  <view class="map-theme">
    <view class="map-theme-text">
      <text class="map-theme-title">城市记忆</text>
      <text class="map-theme-sub">你走过的角落</text>
    </view>
    <view class="map-city-pill" bindtap="openCitySelect">
      <image class="city-ico" src="/assets/icons/map-pin-brand.svg" mode="aspectFit"></image>
      <text class="city-name">{{currentCity}}</text>
      <image class="city-arrow" src="/assets/icons/chevron-down-ink.svg" mode="aspectFit"></image>
    </view>
  </view>

  <!-- 原生地图：悬浮 UI 必须用 cover-view / cover-image -->
  <map
    id="escapeMap"
    class="map-native"
    latitude="{{mapCenter.latitude}}"
    longitude="{{mapCenter.longitude}}"
    scale="{{mapScale}}"
    markers="{{mapMarkers}}"
    polyline="{{mapPolyline}}"
    enable-satellite="{{activeTab === 'satellite'}}"
    show-location
    enable-zoom
    enable-scroll
    bindmarkertap="onMarkerTap"
    bindcallouttap="onMarkerTap"
    bindtap="closePopup"
    style="width: 100%; height: {{mapHeight}}px;"
  >
    <!-- 顶部模式 tab + 时间筛选 -->
    <cover-view class="map-controls">
      <cover-view class="map-tabs">
        <cover-view
          wx:for="{{mapTabs}}"
          wx:key="key"
          class="map-tab {{activeTab === item.key ? 'active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onTabTap"
        >
          <cover-view class="map-tab-text">{{item.name}}</cover-view>
        </cover-view>
      </cover-view>
      <cover-view class="time-chips">
        <cover-view
          wx:for="{{timeFilters}}"
          wx:key="key"
          class="time-chip {{activeTime === item.key ? 'active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onTimeTap"
        >
          <cover-view class="time-chip-text">{{item.name}}</cover-view>
        </cover-view>
      </cover-view>
      <!-- 类型筛选（微逃/破圈/同频）-->
      <cover-view class="time-chips">
        <cover-view
          wx:for="{{typeFilters}}"
          wx:key="key"
          class="time-chip type-chip {{activeType === item.key ? 'active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onTypeTap"
        >
          <cover-view class="time-chip-text">{{item.name}}</cover-view>
        </cover-view>
      </cover-view>
      <!-- 心情筛选 -->
      <cover-view class="time-chips">
        <cover-view
          wx:for="{{moodFilters}}"
          wx:key="key"
          class="time-chip mood-chip {{activeMood === item.key ? 'active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onMoodTap"
        >
          <cover-view class="time-chip-text">{{item.name}}</cover-view>
        </cover-view>
      </cover-view>
    </cover-view>

    <!-- v13: 定位按钮 —— CSS 绘制图标，不依赖 cover-image + SVG -->
    <cover-view class="map-locate-btn" bindtap="locate">
      <cover-view class="locate-icon">
        <cover-view class="locate-ring"></cover-view>
        <cover-view class="locate-center"></cover-view>
      </cover-view>
    </cover-view>

    <!-- v13: 添加/编辑出发点按钮 —— CSS 绘制加号 -->
    <cover-view class="map-home-btn" bindtap="setHomePoint">
      <cover-view class="plus-icon">
        <cover-view class="plus-h"></cover-view>
        <cover-view class="plus-v"></cover-view>
      </cover-view>
    </cover-view>

    <!-- 底部统计条 -->
    <cover-view class="map-stats-bar">
      <cover-view class="stat-item">
        <cover-view class="stat-num">{{totalCount}}</cover-view>
        <cover-view class="stat-label">总出逃</cover-view>
      </cover-view>
      <cover-view class="stat-item">
        <cover-view class="stat-num">{{uniquePlaces}}</cover-view>
        <cover-view class="stat-label">地点</cover-view>
      </cover-view>
      <cover-view class="stat-item">
        <cover-view class="stat-num">{{totalDistance}}</cover-view>
        <cover-view class="stat-label">公里</cover-view>
      </cover-view>
      <cover-view class="stat-item">
        <cover-view class="stat-num">{{cityCount}}</cover-view>
        <cover-view class="stat-label">城市</cover-view>
      </cover-view>
    </cover-view>

    <!-- 空状态 -->
    <cover-view wx:if="{{totalCount === 0}}" class="map-empty">
      <cover-image class="empty-illust" src="/assets/icons/empty-map.svg"></cover-image>
      <cover-view wx:if="{{!hasLocation}}" class="empty-text">开启定位，查看你的出逃地图</cover-view>
      <cover-view wx:else class="empty-text">还没有出逃记忆</cover-view>
      <cover-view wx:if="{{!hasLocation}}" class="empty-sub">授权定位后，会显示你周边的出逃足迹</cover-view>
      <cover-view wx:else class="empty-sub">完成第一次出逃，这里会留下你的足迹</cover-view>
      <cover-view class="empty-cta" catchtap="goEscape">去出逃</cover-view>
    </cover-view>

    <!-- 标记弹窗（C-12 富化：出逃模式 / 搭子 / 时长 / 心情 / 天气 / 缩略图） -->
    <cover-view wx:if="{{popupRecord}}" class="map-popup" catchtap="closePopup">
      <cover-view class="popup-inner">
        <!-- 顶部：类型 + 模式 pill -->
        <cover-view class="popup-head">
          <cover-view class="popup-type" style="color: {{popupRecord.typeColor}};">{{popupRecord.typeName}}</cover-view>
          <cover-view class="popup-mode-pill" style="background: {{popupRecord.typeColor}}1A; color: {{popupRecord.typeColor}};">{{popupRecord.modeName}}</cover-view>
        </cover-view>
        <cover-view class="popup-title">{{popupRecord.commandTitle}}</cover-view>
        <cover-view wx:if="{{popupRecord.dateText}}" class="popup-date">{{popupRecord.dateText}}</cover-view>

        <!-- 缩略图（同频聚合无图时不展示） -->
        <cover-image wx:if="{{popupRecord.photoThumb}}" class="popup-thumb" src="{{popupRecord.photoThumb}}" mode="aspectFill"></cover-image>

        <!-- 信息行：搭子 / 时长 / 心情 / 天气 -->
        <cover-view class="popup-meta">
          <cover-view wx:if="{{popupRecord.partnersText}}" class="popup-meta-row">
            <cover-view class="popup-meta-label">搭子</cover-view>
            <cover-view class="popup-meta-val">{{popupRecord.partnersText}}</cover-view>
          </cover-view>
          <cover-view wx:if="{{popupRecord.durationText}}" class="popup-meta-row">
            <cover-view class="popup-meta-label">时长</cover-view>
            <cover-view class="popup-meta-val">{{popupRecord.durationText}}</cover-view>
          </cover-view>
          <cover-view wx:if="{{popupRecord.moodName}}" class="popup-meta-row">
            <cover-view class="popup-meta-label">心情</cover-view>
            <cover-view class="popup-meta-val">{{popupRecord.moodName}}</cover-view>
          </cover-view>
          <cover-view wx:if="{{popupRecord.weatherText}}" class="popup-meta-row">
            <cover-view class="popup-meta-label">天气</cover-view>
            <cover-view class="popup-meta-val">{{popupRecord.weatherText}}</cover-view>
          </cover-view>
        </cover-view>

        <!-- 查看完整记录按钮（同频聚合无单条记录，不展示） -->
        <cover-view wx:if="{{!popupRecord.isGroupAgg}}" class="popup-cta" catchtap="goRecordDetailFromMap">
          <cover-view class="popup-cta-text">查看完整记录 ›</cover-view>
        </cover-view>
      </cover-view>
    </cover-view>
  </map>

  <view class="tabbar-placeholder"></view>

  <!-- 自定义 TabBar -->
  <custom-tab-bar selected="{{1}}"></custom-tab-bar>
</view>
