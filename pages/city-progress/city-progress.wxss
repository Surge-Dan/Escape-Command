/* ===== 城市探索进度 ===== */
.status-bar { flex-shrink: 0; }

.page-scroll {
  padding: 0 40rpx;
}

.city-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 16rpx 0 24rpx;
}

/* 城市 hero */
.city-hero {
  background: linear-gradient(135deg, var(--brand-tint), var(--brand-weak));
  border-radius: var(--radius-xl);
  border: var(--border);
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  position: relative;
  overflow: hidden;
}

.city-hero::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(200, 149, 110, 0.18);
}

.city-hero::after {
  content: '';
  position: absolute;
  bottom: -60rpx;
  left: -20rpx;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(212, 138, 90, 0.10);
}

.hero-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  position: relative;
  z-index: 1;
}

.hero-label {
  font-size: 22rpx;
  color: var(--ink-soft);
  padding: 4rpx 14rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: var(--radius-pill);
}

.hero-city {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--brand-dark);
  line-height: 1.2;
}

.hero-stats {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.85);
  border-radius: var(--radius-lg);
  padding: 20rpx 8rpx;
  position: relative;
  z-index: 1;
  box-shadow: var(--shadow-card);
}

.hero-stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.hero-stat-num {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1;
}

.hero-stat-label {
  font-size: 22rpx;
  color: var(--ink-soft);
}

.hero-stat-divider {
  width: 2rpx;
  height: 56rpx;
  background: var(--line);
}

/* 通用图表卡 */
.chart-card {
  padding: 28rpx;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.card-head-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.2;
}

.card-sub {
  font-size: 22rpx;
  color: var(--ink-faint);
}

/* 热力图图例 */
.heat-legend {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.legend-label {
  font-size: 20rpx;
  color: var(--ink-faint);
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
}

/* 6x8 热力网格 */
.heatmap-grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  grid-template-rows: repeat(6, 1fr);
  gap: 6rpx;
  background: var(--canvas);
  padding: 8rpx;
  border-radius: var(--radius-md);
  aspect-ratio: 8 / 6;
}

.heat-cell {
  background: var(--brand);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 150ms var(--ease-standard);
  position: relative;
  min-height: 60rpx;
}

.heat-cell.level-0 {
  background: var(--brand);
  opacity: 0.06 !important;
}

.heat-cell:active {
  transform: scale(0.92);
}

.heat-cell.hot {
  box-shadow: 0 0 0 3rpx rgba(200, 149, 110, 0.45) inset;
}

.cell-count {
  font-size: 22rpx;
  color: var(--white);
  font-weight: 700;
  font-family: "SF Mono", monospace;
  line-height: 1;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.2);
}

.heatmap-foot {
  margin-top: 16rpx;
  text-align: center;
}

.foot-text {
  font-size: 22rpx;
  color: var(--ink-faint);
}

/* 角落收集进度 */
.progress-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  margin-bottom: 24rpx;
}

.progress-num-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.progress-current {
  font-size: 80rpx;
  font-weight: 700;
  color: var(--brand-dark);
  line-height: 1;
  letter-spacing: -2rpx;
}

.progress-sep {
  font-size: 44rpx;
  color: var(--ink-faint);
}

.progress-target {
  font-size: 36rpx;
  color: var(--ink-soft);
}

.progress-label {
  font-size: 24rpx;
  color: var(--ink-soft);
}

.progress-track {
  position: relative;
  height: 28rpx;
  background: var(--canvas);
  border-radius: 14rpx;
  overflow: visible;
  margin-bottom: 28rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--brand), var(--brand-dark));
  border-radius: 14rpx;
  transition: width 600ms var(--ease-out);
  position: relative;
  overflow: hidden;
}

.progress-fill::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
  animation: shimmer 2.4s linear infinite;
}

@keyframes shimmer {
  from { transform: translateX(-100%); }
  to { transform: translateX(100%); }
}

.progress-marker {
  position: absolute;
  top: -8rpx;
  transform: translateX(-50%);
}

.progress-percent {
  font-size: 22rpx;
  color: var(--brand-dark);
  font-weight: 700;
  font-family: "SF Mono", monospace;
  background: var(--white);
  padding: 4rpx 10rpx;
  border-radius: var(--radius-pill);
  box-shadow: var(--shadow-float);
  margin-top: -36rpx;
  display: block;
}

.progress-tiers {
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
}

.tier {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 12rpx 4rpx;
  background: var(--canvas);
  border-radius: var(--radius-sm);
  border: 2rpx solid transparent;
  transition: all 200ms var(--ease-standard);
}

.tier.active {
  background: var(--brand-tint);
  border-color: var(--brand);
}

.tier-name {
  font-size: 22rpx;
  color: var(--ink-soft);
  font-weight: 600;
}

.tier.active .tier-name {
  color: var(--brand-dark);
}

.tier-num {
  font-size: 20rpx;
  color: var(--ink-faint);
  font-family: "SF Mono", monospace;
}

.tier.active .tier-num {
  color: var(--brand-dark);
}

/* 高频角落 Top3 */
.hot-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hot-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 18rpx;
  background: var(--canvas);
  border-radius: var(--radius-md);
  transition: all 150ms var(--ease-standard);
}

.hot-row:active {
  transform: scale(0.98);
  background: var(--brand-weak);
}

.hot-rank {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--white);
  flex-shrink: 0;
  font-family: "SF Mono", monospace;
}

.hot-rank.rank-1 { background: linear-gradient(135deg, #FFD36B, #E0A92E); box-shadow: 0 2rpx 8rpx rgba(224, 169, 46, 0.32); }
.hot-rank.rank-2 { background: linear-gradient(135deg, #C8D0DA, #9AA8BA); box-shadow: 0 2rpx 8rpx rgba(154, 168, 186, 0.32); }
.hot-rank.rank-3 { background: linear-gradient(135deg, #E8B594, #D98A5C); box-shadow: 0 2rpx 8rpx rgba(217, 138, 92, 0.32); }

.hot-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}

.hot-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.hot-meta {
  font-size: 22rpx;
  color: var(--ink-soft);
}

.hot-heat {
  display: flex;
  gap: 4rpx;
  flex-shrink: 0;
}

.heat-bar-mini {
  width: 8rpx;
  height: 24rpx;
  border-radius: 2rpx;
}

/* 区域列表 */
.area-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.area-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 16rpx;
  background: var(--canvas);
  border-radius: var(--radius-md);
  transition: all 150ms var(--ease-standard);
}

.area-row:active {
  transform: scale(0.98);
  background: var(--brand-weak);
}

.area-pin {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  flex-shrink: 0;
}

.area-pin image {
  width: 28rpx;
  height: 28rpx;
}

.area-pin.level-hot {
  background: var(--brand);
}

.area-pin.level-warm {
  background: var(--brand-tint);
}

.area-pin.level-cool {
  background: var(--canvas);
}

.area-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.area-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.area-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.area-tag {
  font-size: 18rpx;
  color: var(--ink-faint);
  background: rgba(122, 78, 43, 0.06);
  padding: 2rpx 8rpx;
  border-radius: var(--radius-pill);
  flex-shrink: 0;
}

.area-meta-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.area-count {
  font-size: 22rpx;
  color: var(--ink-soft);
  font-weight: 500;
}

.area-dot {
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: var(--ink-faint);
  opacity: 0.5;
}

.area-last {
  font-size: 22rpx;
  color: var(--ink-faint);
}

.area-heat-bar {
  width: 80rpx;
  height: 8rpx;
  background: var(--line);
  border-radius: 4rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.area-heat-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 400ms var(--ease-out);
}

.area-heat-fill.level-hot { background: var(--brand); }
.area-heat-fill.level-warm { background: var(--brand-dark); opacity: 0.7; }
.area-heat-fill.level-cool { background: var(--brand); opacity: 0.4; }

.bottom-spacer {
  height: 60rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  padding: 0 40rpx;
  text-align: center;
}

.empty-illust-wrap {
  margin-bottom: 32rpx;
}

.empty-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  width: 240rpx;
  padding: 12rpx;
  background: var(--white);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  animation: floatSoft 3s var(--ease-standard) infinite;
}

.empty-cell {
  width: 100%;
  aspect-ratio: 1;
  background: var(--brand);
  opacity: 0.08;
  border-radius: 6rpx;
}

.empty-cell:nth-child(odd) {
  opacity: 0.16;
  animation: cellPulse 2s var(--ease-standard) infinite;
}

@keyframes cellPulse {
  0%, 100% { opacity: 0.16; }
  50% { opacity: 0.4; }
}

@keyframes floatSoft {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.empty-desc {
  font-size: 26rpx;
  color: var(--ink-soft);
  margin-top: 12rpx;
}

.empty-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 48rpx;
  padding: 22rpx 60rpx;
  min-height: 88rpx;
  background: var(--brand);
  color: var(--white);
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(200, 149, 110, 0.24);
  transition: transform 150ms var(--ease-standard);
}

.empty-btn:active {
  transform: scale(0.97);
}
