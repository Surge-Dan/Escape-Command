/* ===== 徽章详情页 · 浅雾蓝设计系统 ===== */

.page-scroll { padding: 0; }

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 80rpx;
  text-align: center;
}
.empty-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--canvas);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  border: 2rpx solid var(--border-soft);
}
.empty-circle image { width: 64rpx; height: 64rpx; }
.empty-title { font-size: 36rpx; font-weight: 700; color: var(--ink); margin-bottom: 16rpx; font-family: var(--serif); }
.empty-sub { font-size: 26rpx; color: var(--ink-soft); line-height: 1.6; margin-bottom: 48rpx; letter-spacing: 0.3rpx; }
.empty-back { padding: 0 48rpx; }

.detail-body { padding: 24rpx 40rpx 0; }

/* ===== 大徽章视觉 ===== */
.hero-wrap {
  position: relative;
  height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}
.hero-glow {
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  filter: blur(40rpx);
  opacity: 0;
  transition: opacity 600ms var(--ease-standard);
  z-index: 1;
}
.hero-glow.glow-on { opacity: 0.55; }
.hero-badge {
  position: relative;
  z-index: 2;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(91, 143, 185, 0.18);
  overflow: hidden;
  transform-origin: center center;
  border: 4rpx solid rgba(255,255,255,0.8);
}
.hero-badge.unlocked {
  box-shadow: 0 8rpx 40rpx rgba(91, 143, 185, 0.35);
}
.hero-badge.locked {
  background: var(--canvas);
  box-shadow: inset 0 0 0 2rpx var(--border-soft);
  filter: grayscale(0.8);
  opacity: 0.7;
}
.hero-icon { width: 96rpx; height: 96rpx; position: relative; z-index: 2; }
.hero-lock { width: 72rpx; height: 72rpx; opacity: 0.5; }
.hero-shine {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.55) 0%, transparent 55%);
  pointer-events: none;
}

/* 重放动画 */
.hero-badge.replay {
  animation: heroPop 1100ms var(--ease-bounce);
}
.hero-glow.replay {
  animation: glowPulse 1100ms var(--ease-standard);
}
@keyframes heroPop {
  0%   { transform: scale(0); }
  40%  { transform: scale(1.3); }
  60%  { transform: scale(0.92); }
  80%  { transform: scale(1.06); }
  100% { transform: scale(1); }
}
@keyframes glowPulse {
  0%   { opacity: 0; transform: scale(0.6); }
  40%  { opacity: 0.9; transform: scale(1.4); }
  100% { opacity: 0.55; transform: scale(1); }
}

/* 闪烁星点 */
.hero-sparkle {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--sun);
  box-shadow: 0 0 12rpx rgba(255, 211, 107, 0.85);
  z-index: 3;
  opacity: 0;
  animation: sparkleBlink 2.4s ease-in-out infinite;
}
.sparkle-1 { top: 30rpx; left: 130rpx; animation-delay: 0.2s; }
.sparkle-2 { top: 80rpx; right: 110rpx; animation-delay: 0.9s; }
.sparkle-3 { bottom: 50rpx; left: 160rpx; animation-delay: 1.6s; }
@keyframes sparkleBlink {
  0%, 100% { opacity: 0; transform: scale(0.4); }
  50% { opacity: 1; transform: scale(1); }
}

/* ===== 标题块 ===== */
.title-block {
  text-align: center;
  margin-bottom: 40rpx;
}
.badge-h1 {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.2;
  margin-bottom: 12rpx;
  font-family: var(--serif);
  letter-spacing: 1rpx;
}
.badge-caption {
  display: block;
  font-size: 26rpx;
  color: var(--ink-soft);
  line-height: 1.6;
  margin-bottom: 20rpx;
  letter-spacing: 0.3rpx;
}
.category-pill {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  font-weight: 600;
  opacity: 0.9;
  letter-spacing: 0.5rpx;
}

/* ===== 通用 Section Card ===== */
.section-card {
  background: var(--white);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}
.section-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.section-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  box-shadow: 0 0 8rpx currentColor;
}
.section-label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 2rpx;
  font-family: var(--serif);
}

/* ===== 解锁状态卡 ===== */
.status-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.status-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.status-icon-wrap image { width: 44rpx; height: 44rpx; }
.status-text { display: flex; flex-direction: column; flex: 1; }
.status-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
  font-family: var(--serif);
}
.status-card.is-unlocked .status-title { color: var(--brand-strong); }
.status-sub {
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-top: 4rpx;
  line-height: 1.5;
  letter-spacing: 0.3rpx;
}

/* ===== 故事卡 ===== */
.story-body { padding-left: 4rpx; }
.story-paragraph {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--ink);
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}
.story-paragraph:last-child { margin-bottom: 0; }

/* ===== 解锁条件卡 ===== */
.condition-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.75;
  color: var(--ink);
  margin-bottom: 24rpx;
  letter-spacing: 0.5rpx;
}
.progress-block { padding-top: 8rpx; }
.progress-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 14rpx;
}
.progress-label {
  font-size: 24rpx;
  color: var(--ink-soft);
  letter-spacing: 0.5rpx;
}
.progress-count {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  font-family: var(--serif);
}
.progress-track {
  width: 100%;
  height: 16rpx;
  background: var(--canvas);
  border-radius: 8rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 600ms var(--ease-standard);
  box-shadow: 0 0 8rpx rgba(91, 143, 185, 0.3);
}
.progress-hint {
  display: block;
  font-size: 22rpx;
  color: var(--ink-faint);
  margin-top: 14rpx;
  line-height: 1.5;
  letter-spacing: 0.5rpx;
}

/* ===== 重放按钮 ===== */
.replay-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  margin-top: 8rpx;
  min-height: 88rpx;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
  color: var(--white);
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: var(--shadow-btn);
}
.replay-btn image { width: 32rpx; height: 32rpx; }
.replay-btn:active { transform: scale(0.97); }

.bottom-spacer { height: calc(80rpx + var(--safe-bottom)); }
