/* ===== 指令详情卡（遮罩+卡片） ===== */
/* 关键修复：弹窗用 absolute + bottom 强制避让 TabBar，不用 flex + margin-bottom（不稳） */
/* TabBar 占位计算：bottom 72rpx + safe-area 34rpx + 高度 100rpx + 1rpx border = 207rpx，留 240rpx 安全 */
.cmd-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(45, 90, 123, 0.5);
  z-index: 999;
  pointer-events: auto;
  animation: cmdMaskIn 200ms ease-out;
}

@keyframes cmdMaskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 弹层用 fixed 定位，确保相对视口而非滚动容器 */
/* v17: TabBar 弹出时已隐藏，cmd-sheet 贴底显示 + max-height 留 80rpx 安全余量 */
.cmd-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: calc(100vh - 80rpx);
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  animation: cmdSheetUp 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 -8rpx 32rpx rgba(45, 90, 123, 0.15);
  z-index: 1001;
}

@keyframes cmdSheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.cmd-card {
  position: relative;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  /* v17: 贴底显示时，padding-bottom 必须兜底 34rpx（无安全区设备也能呼吸） */
  padding: 28rpx 28rpx calc(40rpx + env(safe-area-inset-bottom, 34rpx));
  flex: 1;
  min-height: 0;
  overflow-y: scroll;
  -webkit-overflow-scrolling: touch;
  box-sizing: border-box;
}

.cmd-close {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  z-index: 5;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
