/* ===== 拍照后编辑页 ===== */
.page-scroll { width: 100%; }
.edit-body { padding: 32rpx 40rpx 0; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 80rpx;
  text-align: center;
}
.empty-illust { width: 160rpx; height: 160rpx; margin-bottom: 32rpx; }
.empty-title { font-size: 30rpx; font-weight: 600; color: var(--ink); }
.empty-desc { margin-top: 12rpx; font-size: 26rpx; color: var(--ink-soft); line-height: 1.5; }
.empty-btn { margin-top: 32rpx; min-width: 200rpx; }

/* 照片预览区 */
.preview-area {
  position: relative;
  width: 100%;
  height: 560rpx;
  border-radius: var(--radius-xl);
  overflow: hidden;
  background: var(--canvas);
  box-shadow: var(--shadow-card);
  border: var(--border);
}
.preview-photo {
  width: 100%;
  height: 100%;
  transition: filter 200ms var(--ease-standard);
}
.placed-sticker {
  position: absolute;
  transform: translate(-50%, -50%);
  font-size: 72rpx;
  line-height: 1;
  padding: 8rpx 12rpx;
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.6);
  box-shadow: var(--shadow-float);
  z-index: 2;
  transition: transform 150ms var(--ease-standard);
}
.placed-sticker:active { transform: translate(-50%, -50%) scale(0.9); }
.preview-hint {
  position: absolute;
  left: 50%;
  bottom: 20rpx;
  transform: translateX(-50%);
  padding: 6rpx 18rpx;
  border-radius: var(--radius-pill);
  background: rgba(46, 47, 51, 0.5);
  color: var(--white);
  font-size: 22rpx;
  z-index: 3;
}

/* 区块 */
.section { margin-top: 40rpx; }
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.section-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}
.section-head .section-title { margin-bottom: 0; }
.clear-btn {
  color: var(--ink-faint);
  padding: 8rpx 12rpx;
}
.clear-btn:active { color: var(--ink-soft); }

/* 滤镜缩略图横滑 */
.filter-scroll { width: 100%; white-space: nowrap; }
.filter-list {
  display: inline-flex;
  gap: 20rpx;
  padding: 4rpx;
}
.filter-thumb {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  width: 140rpx;
  transition: transform 150ms var(--ease-standard);
}
.filter-thumb:active { transform: scale(0.95); }
.thumb-img-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 3rpx solid transparent;
  transition: border-color 200ms var(--ease-standard);
}
.thumb-img { width: 100%; height: 100%; }
.filter-thumb.on .thumb-img-wrap {
  border-color: var(--brand);
  box-shadow: 0 0 0 4rpx var(--brand-tint);
}
.thumb-name {
  font-size: 22rpx;
  color: var(--ink-soft);
}
.filter-thumb.on .thumb-name {
  color: var(--brand-dark);
  font-weight: 600;
}

/* 贴纸横滑 */
.sticker-scroll { width: 100%; white-space: nowrap; }
.sticker-list {
  display: inline-flex;
  gap: 20rpx;
  padding: 4rpx;
}
.sticker-item {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--white);
  border: var(--border);
  box-shadow: var(--shadow-float);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  line-height: 1;
  transition: transform 150ms var(--ease-standard);
}
.sticker-item:active {
  transform: scale(0.88);
  background: var(--brand-tint);
}

.bottom-spacer { height: 180rpx; }

/* 底部完成按钮 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  background: var(--canvas);
  border-top: 1rpx solid var(--line);
}
.finish-btn {
  width: 100%;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
}
.finish-btn:active { transform: scale(0.97); }
.finish-btn image { width: 32rpx; height: 32rpx; }
