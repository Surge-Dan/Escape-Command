/* pages/dice-micro-7d/dice-micro-7d.wxss */
/* 微逃骰子（7 维度版）- 条件选择页样式 */
/* 配色对齐 Daniel 暖棕品牌色，复用 app.wxss 全局变量 */
/* 设计差异化：微逃=暖棕卡片式 7D 表单（区别于破圈紫色勇气流 / 同频组局流） */

.page {
  min-height: 100vh;
  background: #f7f5f0;
  /* 底部留足安全距离，避免内容被固定 footer 遮挡 */
  padding: 0 32rpx calc(280rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero {
  padding: 32rpx 0 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.hero__tag {
  font-size: 20rpx;
  color: var(--brand);
  letter-spacing: 6rpx;
  margin-bottom: 28rpx;
  font-weight: 500;
}

.hero__dice {
  font-size: 80rpx;
  margin-bottom: 32rpx;
  line-height: 1;
}

.hero__dice--rolling {
  animation: diceShake 0.5s ease-in-out infinite;
}

@keyframes diceShake {
  0%, 100% { transform: rotate(0deg) scale(1); }
  25% { transform: rotate(-15deg) scale(0.9); }
  75% { transform: rotate(15deg) scale(1.1); }
}

.hero__title {
  font-size: 56rpx;
  color: var(--ink);
  font-weight: 600;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.hero__desc {
  font-size: 26rpx;
  color: var(--ink-soft);
  line-height: 1.5;
  padding: 0 40rpx;
}

.form {
  margin-top: 24rpx;
}

/* 字段卡片：用圆角白卡包裹每组字段，呼应破圈/同频的卡片式做法 */
.form-group {
  background: #ffffff;
  border: 2rpx solid #efeae3;
  border-radius: 24rpx;
  padding: 28rpx 32rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(168, 123, 82, 0.06);
}

.form-group__label {
  display: flex;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.form-group__label-text {
  font-size: 30rpx;
  color: var(--ink);
  font-weight: 600;
  letter-spacing: 1rpx;
}

.form-group__required {
  font-size: 26rpx;
  color: var(--brand);
  margin-left: 8rpx;
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: #f7f5f0;
  border: 2rpx solid #e5e7eb;
  transition: all 0.2s ease;
}

.chip--hover {
  transform: scale(0.96);
  opacity: 0.9;
}

.chip__text {
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 500;
}

.chip--active {
  background: var(--brand);
  border-color: var(--brand);
  box-shadow: 0 6rpx 20rpx rgba(168, 123, 82, 0.25);
}

.chip--active .chip__text {
  color: #ffffff;
}

/* 固定底部摇骰按钮：留足安全距离，避免贴底 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(247, 245, 240, 0) 0%, #f7f5f0 28%);
  pointer-events: none;
}

.cta,
.footer__hint {
  pointer-events: auto;
}

.cta {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
  box-shadow: 0 12rpx 32rpx rgba(168, 123, 82, 0.3);
  transition: all 0.2s ease;
}

.cta--hover {
  transform: scale(0.98);
  opacity: 0.95;
}

.cta--disabled {
  background: #d1d5db;
  box-shadow: none;
}

.cta--rolling {
  background: linear-gradient(135deg, var(--brand) 0%, #e8c9a0 100%);
  box-shadow: 0 12rpx 32rpx rgba(200, 149, 110, 0.4);
}

.cta__icon {
  font-size: 36rpx;
  margin-right: 12rpx;
  line-height: 1;
}

.cta__text {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.cta--disabled .cta__icon,
.cta--disabled .cta__text {
  color: #9ca3af;
}

.footer__hint {
  text-align: center;
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 16rpx;
  letter-spacing: 1rpx;
}
