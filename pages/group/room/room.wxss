/* ===== 导航栏 ===== */
.group-room-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF8F0 0%, #FFFFFF 100%);
}
.nav-header {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 32rpx;
  position: relative;
}
.nav-header-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-back-arrow {
  font-size: 40rpx;
  color: #2C2C2C;
}
.nav-header-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 32rpx;
  font-weight: 600;
  color: #2C2C2C;
}

/* ===== Loading ===== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}
.loading-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #5CBF9E;
  margin: 0 6rpx;
  display: inline-block;
  animation: dotBounce 1.4s infinite ease-in-out both;
}
.loading-dot:nth-child(1) { animation-delay: -0.32s; }
.loading-dot:nth-child(2) { animation-delay: -0.16s; }
.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #999;
}
@keyframes dotBounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

/* ===== Empty ===== */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 300rpx;
}
.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 40rpx;
}
.empty-back-btn {
  padding: 20rpx 60rpx;
  background: #5CBF9E;
  color: #fff;
  font-size: 28rpx;
  border-radius: 8rpx;
}

/* ===== Room Scroll ===== */
.room-scroll {
  height: calc(100vh - 88rpx);
}

/* ===== Room Hero ===== */
.room-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 32rpx 48rpx;
}
.room-id-label {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
  color: #2C2C2C;
}
.room-id-hint {
  font-size: 24rpx;
  color: #BBB;
  margin-top: 8rpx;
}
.room-topic {
  font-size: 36rpx;
  font-weight: 600;
  color: #2C2C2C;
  margin-top: 24rpx;
}
.room-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}
.room-status-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}
.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.room-max-members {
  font-size: 24rpx;
  color: #999;
}

/* ===== Stage Section ===== */
.stage-section {
  padding: 0 32rpx 120rpx;
}

/* ===== Members Section ===== */
.members-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2C2C;
  display: block;
  margin-bottom: 32rpx;
}
.section-subtitle {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 20rpx;
}
.members-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 32rpx 0;
  justify-content: space-around;
}
.member-slot {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 25%;
}
.member-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.member-avatar.empty-avatar {
  border: 2rpx dashed #DDD;
  background: transparent;
}
.member-icon {
  font-size: 36rpx;
  color: #fff;
}
.empty-avatar .member-icon {
  color: #CCC;
}
.member-name {
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
}
.waiting-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 40rpx;
}
.waiting-dot {
  font-size: 40rpx;
  color: #5CBF9E;
  animation: dotPulse 1.5s infinite ease-in-out;
}
.waiting-dot:nth-child(2) { animation-delay: 0.2s; }
.waiting-dot:nth-child(3) { animation-delay: 0.4s; }
.waiting-text {
  font-size: 26rpx;
  color: #999;
  margin-left: 12rpx;
}
@keyframes dotPulse {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 1; }
}

/* ===== Actions ===== */
.actions-section {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}
.invite-btn {
  width: 100%;
  height: 96rpx;
  background: #5CBF9E;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
  line-height: 96rpx;
}
.invite-btn::after { border: none; }
.invite-icon {
  font-size: 32rpx;
}
.demo-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
}
.demo-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  background: #FFF0E5;
  color: #D98A5C;
  font-size: 26rpx;
  border-radius: 8rpx;
}
.demo-btn.outline {
  background: transparent;
  border: 2rpx solid #D98A5C;
}
.start-vote-btn {
  width: 100%;
  height: 96rpx;
  background: #D98A5C;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.start-vote-btn .arrow {
  font-size: 36rpx;
}
.cancel-btn {
  font-size: 26rpx;
  color: #CCC;
  padding: 16rpx 32rpx;
}

/* ===== Preference Section ===== */
.preference-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.interest-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.interest-tag {
  padding: 16rpx 32rpx;
  background: #F5F5F5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
}
.interest-tag.selected {
  background: #5CBF9E1A;
  color: #5CBF9E;
  font-weight: 600;
}
.intensity-row {
  display: flex;
  gap: 16rpx;
}
.intensity-tag {
  flex: 1;
  padding: 20rpx 0;
  text-align: center;
  background: #F5F5F5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
}
.intensity-tag.selected {
  background: #D98A5C1A;
  color: #D98A5C;
  font-weight: 600;
}
.submit-pref-btn {
  margin-top: 32rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #7BAE7F;
  color: #fff;
  font-size: 28rpx;
  border-radius: 8rpx;
}

/* ===== Vote Cards ===== */
.vote-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.vote-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C2C2C;
  display: block;
  margin-bottom: 28rpx;
}
.vote-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.vote-option {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: #F8F8F8;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  gap: 12rpx;
}
.vote-option.selected {
  background: #FFF0E5;
  border-color: #D98A5C;
}
.vote-option-icon {
  font-size: 36rpx;
  margin-right: 8rpx;
}
.vote-option-label {
  font-size: 28rpx;
  color: #2C2C2C;
  font-weight: 500;
}
.vote-option-desc {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}
.vote-count {
  margin-left: auto;
  font-size: 24rpx;
  color: #5CBF9E;
  font-weight: 600;
}

/* ===== Vote Progress ===== */
.vote-progress {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.progress-text {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 16rpx;
}
.progress-bar {
  height: 12rpx;
  background: #F0F0F0;
  border-radius: 6rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #5CBF9E, #7BAE7F);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* ===== Generate Button ===== */
.generate-btn {
  height: 96rpx;
  background: #D98A5C;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.generate-btn.disabled {
  background: #CCC;
}
.generate-btn .arrow {
  font-size: 36rpx;
}
.vote-hint {
  text-align: center;
  font-size: 24rpx;
  color: #BBB;
  margin-top: 16rpx;
}

/* ===== Script Stage ===== */
.script-stage {
  padding-top: 16rpx;
}
.script-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}
.script-badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  background: #5CBF9E1A;
  color: #5CBF9E;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}
.script-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #2C2C2C;
  display: block;
  margin-bottom: 32rpx;
  line-height: 1.4;
}
.script-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx 0;
  padding: 24rpx 0;
  border-top: 2rpx solid #F5F5F5;
  border-bottom: 2rpx solid #F5F5F5;
  margin-bottom: 32rpx;
}
.meta-item {
  width: 50%;
  display: flex;
  flex-direction: column;
}
.meta-label {
  font-size: 22rpx;
  color: #BBB;
}
.meta-value {
  font-size: 28rpx;
  color: #2C2C2C;
  font-weight: 600;
  margin-top: 4rpx;
}
.script-steps {
  margin-bottom: 32rpx;
}
.steps-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2C2C;
  display: block;
  margin-bottom: 24rpx;
}
.step-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.step-num {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  background: #D98A5C;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 50%;
}
.step-text {
  font-size: 28rpx;
  color: #2C2C2C;
  line-height: 1.6;
  padding-top: 4rpx;
}
.script-members {
  padding-top: 24rpx;
  border-top: 2rpx solid #F5F5F5;
}
.script-members-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.script-member-tag {
  padding: 8rpx 20rpx;
  background: #F5F5F5;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
}
.script-cta {
  margin-top: 32rpx;
}
.start-escape-btn {
  height: 100rpx;
  background: linear-gradient(135deg, #5CBF9E, #7BAE7F);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(92, 191, 158, 0.3);
}
.start-escape-btn .arrow {
  font-size: 36rpx;
}
.script-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.regenerate-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #fff;
  border: 2rpx solid #D98A5C;
  color: #D98A5C;
  font-size: 28rpx;
  border-radius: 8rpx;
}
.back-home-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #5CBF9E;
  color: #fff;
  font-size: 28rpx;
  border-radius: 8rpx;
}
