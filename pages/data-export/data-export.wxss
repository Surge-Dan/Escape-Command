.status-bar { flex-shrink: 0; }

.page-scroll {
  width: 100%;
}

.export-body {
  padding: 32rpx 40rpx 0;
}

.section-label {
  display: block;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--ink-faint);
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 120rpx 40rpx 40rpx;
}

.empty-illust {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.85;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-bottom: 40rpx;
  line-height: 1.5;
}

.empty-btn {
  padding: 0 56rpx;
}

/* ===== 预览卡 ===== */
.preview-card {
  padding: 32rpx 28rpx;
  margin-bottom: 40rpx;
}

.preview-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid var(--line);
}

.preview-logo {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  background: var(--brand-tint);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.preview-logo image {
  width: 44rpx;
  height: 44rpx;
}

.preview-title-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.preview-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
}

.preview-sub {
  font-size: 24rpx;
  color: var(--ink-soft);
}

.preview-stats {
  display: flex;
  justify-content: space-around;
  padding: 32rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.ps-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.ps-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.1;
}

.ps-label {
  font-size: 22rpx;
  color: var(--ink-faint);
}

.preview-polaroids {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding-top: 32rpx;
  justify-content: center;
}

.mini-polaroid {
  width: 120rpx;
  background: var(--white);
  padding: 10rpx 10rpx 24rpx;
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--line);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.mp-photo {
  width: 100rpx;
  height: 100rpx;
  border-radius: 6rpx;
  background: var(--canvas);
}

.mp-cap {
  font-size: 18rpx;
  color: var(--ink-soft);
  text-align: center;
  font-family: "SF Mono", "Menlo", "Consolas", monospace;
}

/* ===== 数据统计卡 ===== */
.stats-card {
  padding: 0 28rpx;
  margin-bottom: 40rpx;
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
}

.stats-key {
  font-size: 28rpx;
  color: var(--ink);
}

.stats-val {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.stats-div {
  height: 1rpx;
  background: var(--line);
}

/* ===== 导出按钮 ===== */
.export-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  margin-bottom: 20rpx;
}

.export-ico {
  width: 32rpx;
  height: 32rpx;
}

/* ===== 离屏画布 ===== */
.offscreen-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 600px;
  height: 1200px;
  opacity: 0;
  pointer-events: none;
}

.bottom-spacer {
  height: 64rpx;
}
