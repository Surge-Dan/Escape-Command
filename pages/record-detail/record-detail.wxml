<view class="page-container paper-texture">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  <view class="nav-header" style="{{navHeaderStyle}}">
    <view class="nav-header-back" bindtap="goBack">
      <image src="/assets/icons/chevron-left-ink.svg" mode="aspectFit"></image>
    </view>
    <text class="nav-header-title">出逃记录</text>
    <view class="nav-header-divider"></view>
  </view>

  <scroll-view scroll-y class="page-scroll" style="height: calc(100vh - {{statusBarHeight}}px - 72rpx);">
    <!-- 空状态：未找到记录 -->
    <view wx:if="{{notFound}}" class="empty-state">
      <image class="empty-illust" src="/assets/icons/empty-collection.svg" mode="aspectFit"></image>
      <text class="empty-title">这条记录不见了</text>
      <text class="empty-desc">它可能已被删除</text>
      <view class="empty-btn btn-secondary" bindtap="goBack">返回</view>
    </view>

    <view wx:if="{{record}}" class="rd-body">
      <!-- 拍立得大卡：照片 + 感受 + 日期/天气 -->
      <view class="polaroid-card filter-{{record.filter}}" style="transform: rotate({{record.rotation || -1.5}}deg);">
        <view class="polaroid-photo-area">
          <image wx:if="{{photo}}" class="polaroid-photo" src="{{photo}}" mode="aspectFill"></image>
          <view wx:else class="photo-placeholder">
            <image class="placeholder-ico" src="/assets/icons/empty-collection.svg" mode="aspectFit"></image>
            <text class="placeholder-text">这张没有照片</text>
          </view>
          <view wx:if="{{moodName}}" class="mood-sticker" style="background: {{typeColor}}1A; color: {{typeColor}};">{{moodName}}</view>
        </view>
        <text class="feeling-text">{{record.feeling || '今天出去走了一小段。'}}</text>
        <view class="polaroid-meta font-mono">
          <text>{{dateText}} {{timeText}}</text>
          <text>{{weatherText}}</text>
        </view>
      </view>

      <!-- 详细元信息：4 项均匀分布，图标在上文字在下 -->
      <view class="section">
        <text class="section-title h3">这次出逃</text>
        <view class="meta-grid solid-card">
          <view class="meta-cell">
            <image class="meta-cell-icon" src="/assets/icons/clock.svg" mode="aspectFit"></image>
            <text class="meta-cell-val font-mono">{{dateText}}</text>
            <text class="meta-cell-label">日期</text>
          </view>
          <view class="meta-cell">
            <image class="meta-cell-icon" src="/assets/icons/footprints.svg" mode="aspectFit"></image>
            <text class="meta-cell-val font-mono">{{record.duration}}分</text>
            <text class="meta-cell-label">时长</text>
          </view>
          <view class="meta-cell">
            <image class="meta-cell-icon" src="/assets/icons/sun.svg" mode="aspectFit"></image>
            <text class="meta-cell-val">{{weatherText}}</text>
            <text class="meta-cell-label">天气</text>
          </view>
          <view class="meta-cell">
            <image class="meta-cell-icon" src="/assets/icons/map-pin.svg" mode="aspectFit"></image>
            <text class="meta-cell-val">{{locationText}}</text>
            <text class="meta-cell-label">位置</text>
          </view>
        </view>
      </view>

      <!-- 完成的指令 -->
      <view class="section">
        <text class="section-title h3">完成的指令</text>
        <view class="cmd-card solid-card">
          <view class="cmd-type" style="background: {{typeColor}}14; color: {{typeColor}};">
            <text>{{typeName}}</text>
          </view>
          <text class="cmd-title">{{record.commandTitle}}</text>
          <text wx:if="{{record.commandContent && record.commandContent !== record.commandTitle}}" class="cmd-content body-text">{{record.commandContent}}</text>
        </view>
      </view>

      <!-- C-12: 同频记录 - 和朋友一起（成员列表 + 步骤留痕时间线）-->
      <view wx:if="{{isGroup && groupSummary}}" class="section">
        <text class="section-title h3">和朋友一起</text>
        <view class="solid-card group-card">
          <view class="group-members-row">
            <text wx:for="{{groupSummary.members}}" wx:key="index" class="group-member-tag">{{item}}</text>
          </view>
          <view wx:if="{{groupSummary.stepTraces.length > 0}}" class="group-timeline">
            <view wx:for="{{groupSummary.stepTraces}}" wx:key="index" class="timeline-item">
              <view class="timeline-dot {{item.done ? 'done' : ''}}">{{index + 1}}</view>
              <view class="timeline-body">
                <text class="timeline-text">{{item.text}}</text>
                <text wx:if="{{item.time}}" class="timeline-time font-mono">{{item.time}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="bottom-spacer"></view>
    </view>
  </scroll-view>

  <!-- 底部操作栏：收藏 / 分享 / 删除 -->
  <view wx:if="{{record}}" class="action-bar">
    <view class="action-btn fav-btn {{isFavorite ? 'active' : ''}}" bindtap="toggleFavorite">
      <image src="{{isFavorite ? '/assets/icons/bookmark-brand.svg' : '/assets/icons/bookmark.svg'}}" mode="aspectFit"></image>
      <text>收藏</text>
    </view>
    <button class="action-btn share-btn" open-type="share">
      <image src="/assets/icons/share-2-ink-soft.svg" mode="aspectFit"></image>
      <text>分享</text>
    </button>
    <view class="action-btn delete-btn" bindtap="deleteRecord">
      <image src="/assets/icons/x-ink-faint.svg" mode="aspectFit"></image>
      <text>删除</text>
    </view>
  </view>
</view>
