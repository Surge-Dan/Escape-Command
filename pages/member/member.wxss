/* ===== 会员页 ===== */
.page-container {
  min-height: 100vh;
}

.member-content {
  padding: 32rpx 40rpx 80rpx;
}

/* 已开通会员卡 */
.member-active-card {
  text-align: center;
  padding: 64rpx 48rpx;
  background: linear-gradient(135deg, var(--lemon-tint), var(--brand-tint));
  border-radius: var(--radius-xl);
  margin-bottom: 48rpx;
  box-shadow: var(--shadow-card);
}
.crown-ico {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 24rpx;
}
.member-active-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 12rpx;
}
.member-active-sub {
  display: block;
  font-size: 24rpx;
  color: var(--ink-soft);
}

/* 未开通头部 */
.member-header {
  text-align: center;
  padding: 48rpx 0 40rpx;
}
.member-badge {
  display: inline-block;
  background: linear-gradient(135deg, #d4af37, #e8c84a);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  padding: 8rpx 24rpx;
  border-radius: var(--radius-sm);
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
}
.member-header-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 12rpx;
}
.member-header-sub {
  display: block;
  font-size: 28rpx;
  color: var(--ink-soft);
}

/* 权益列表 */
.benefits-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 48rpx;
}
.benefit-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  background: var(--white);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}
.benefit-ico {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
}
.benefit-text {
  flex: 1;
}
.benefit-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 4rpx;
}
.benefit-desc {
  display: block;
  font-size: 24rpx;
  color: var(--ink-soft);
}

/* 方案选择 */
.plans-section {
  margin-bottom: 40rpx;
}
.plans-label {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--ink-soft);
  margin-bottom: 20rpx;
  padding-left: 8rpx;
  display: block;
}
.plans-grid {
  display: flex;
  gap: 16rpx;
}
.plan-card {
  flex: 1;
  padding: 28rpx 12rpx;
  background: var(--white);
  border: 2rpx solid var(--line);
  border-radius: var(--radius-md);
  text-align: center;
  position: relative;
  box-shadow: var(--shadow-card);
}
.plan-card.plan-selected {
  border-color: var(--brand);
  background: var(--brand-tint);
}
.plan-tag {
  position: absolute;
  top: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #d4af37, #e8c84a);
  color: #fff;
  font-size: 18rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 10rpx;
}
.plan-price {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 8rpx;
}
.price-symbol {
  font-size: 24rpx;
  color: var(--brand-strong);
  font-weight: 600;
}
.price-num {
  font-size: 48rpx;
  color: var(--brand-strong);
  font-weight: 700;
  font-family: "Inter", "DIN", ui-monospace, monospace;
}
.price-unit {
  font-size: 22rpx;
  color: var(--ink-soft);
}
.plan-original {
  display: block;
  font-size: 22rpx;
  color: var(--ink-faint);
  text-decoration: line-through;
  margin-bottom: 8rpx;
}
.plan-desc {
  display: block;
  font-size: 22rpx;
  color: var(--ink-soft);
}
.plan-check {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 40rpx;
  height: 40rpx;
  background: var(--brand);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.check-ico {
  width: 24rpx;
  height: 24rpx;
}

/* 开通按钮 */
.subscribe-section {
  margin-bottom: 20rpx;
}
.subscribe-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-float);
  margin-bottom: 20rpx;
}
.subscribe-btn:active {
  transform: scale(0.98);
  opacity: 0.92;
}
.subscribe-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--white);
  letter-spacing: 2rpx;
}
.agreement-text {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-faint);
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.restore-text {
  text-align: center;
  font-size: 28rpx;
  color: var(--brand);
}

/* 已开通会员底部 */
.member-footer {
  text-align: center;
  padding-top: 40rpx;
}
.valid-info {
  font-size: 24rpx;
  color: var(--ink-soft);
}