# ======================
demo/
screenshots/
recordings/
# 参考视频（大文件，不进 git，不进主包；packOptions.ignore 已排除 *.mp4）
docs/video/
*.mp4

# ======================
# Spec / 文档（团队文档托管在飞书，仓库里只留索引）
# ======================
.trae/specs/*/drafts/
.trae/specs/*/notes/
# TRAE Skill 缓存（IDE 本地 skill 资源，不进 git，避免污染分支）
.trae/skills/

# ======================
# IDE / 工具
# ======================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ======================
# Node（如果未来加 npm 构建）
# ======================
node_modules/
package-lock.json

# ======================
# 云函数依赖（云函数本地 npm install 后产生，部署时云端会重新安装）
# ======================
cloudfunctions/*/node_modules/
cloudfunctions/*/.fun/
cloudfunctions/*/.envrc

# ======================
# 临时 / 备份
# ======================
*.bak
*.tmp
*.log
*.local
.cache/
# 测试运行输出（run-all.js 会写日志）
run-all-output/
# 微信开发者工具 IDE 临时缓存
.ide-cache/

# ======================
# 敏感配置（绝不能进 git）
# ======================
project.private.config.json
.env
.env.local
secrets/
*.pem
*.key

# ======================
# AI 协作产物
# ======================
# 协作规范/功能表等由团队维护，xlsx 放仓库外
*.xlsx
!docs/**/*.xlsx
