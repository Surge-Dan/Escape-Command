/* 首页 v22: 透明PNG骰子 Cover Flow + 上下悬浮，点击直接跳转 */
.home-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #E8F4FC;
}

.status-bar { flex-shrink: 0; background: transparent; }
.home-scroll { 
  flex: 1; 
  height: 0; 
  padding: 0;
}

/* ===== Hero 首屏区域 ===== */
.hero-section {
  position: relative;
  padding-top: 40rpx;
  padding-bottom: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 标题 —— 严格按 v2 设计：思源宋体 Bold 衬线 */
.hero-title {
  font-size: 72rpx;
  font-weight: 700;
  color: #2D5A7B;
  letter-spacing: 8rpx;
  font-family: var(--serif);
  margin-bottom: 24rpx;
  text-shadow: 0 2rpx 8rpx rgba(45, 90, 123, 0.1);
}

/* 日期胶囊 */
.date-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(91, 143, 185, 0.15);
  margin-bottom: 28rpx;
}

.date-pill text {
  font-size: 24rpx;
  color: #5B8FB9;
  font-weight: 500;
  letter-spacing: 1rpx;
}

/* 问候语区域 */
.greeting-area {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.greeting-prefix {
  font-size: 32rpx;
  color: #4A7A9E;
  font-weight: 500;
  font-family: var(--serif);
}

.greeting-emphasis {
  font-size: 40rpx;
  font-weight: 700;
  color: #2D5A7B;
  margin: 0 4rpx;
  font-family: var(--serif);
}

.greeting-suffix {
  font-size: 32rpx;
  color: #4A7A9E;
  font-weight: 500;
  font-family: var(--serif);
}

.hero-sub {
  font-size: 26rpx;
  color: #6B9DC2;
  letter-spacing: 1rpx;
  margin-bottom: 40rpx;
}

/* ===== 骰子舞台（Cover Flow 布局）- 严格对齐首页.png ===== */
.dice-stage-3d {
  position: relative;
  width: 100%;
  height: 740rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  overflow: visible;
}

/* 骰子容器 - 图片2480x3508，骰子占70%宽/58%高，容器放大补偿透明留白 */
.die-item {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 460rpx;
  height: 650rpx;
  margin-left: -230rpx;
  margin-top: -325rpx;
  transition: transform 500ms cubic-bezier(0.34, 1.3, 0.64, 1), opacity 500ms ease;
  will-change: transform, opacity;
}

.die-img {
  width: 100%;
  height: 100%;
  filter: drop-shadow(0 20rpx 44rpx rgba(45, 90, 123, 0.32));
}

/* 中间骰子 - 最大，呼吸浮动 */
.die-pos-center {
  transform: translateX(0) scale(1);
  z-index: 10;
  opacity: 1;
  animation: dieFloatCenter 3s ease-in-out infinite;
}

/* 左侧骰子 */
.die-pos-left {
  transform: translateX(-240rpx) scale(0.52);
  z-index: 5;
  opacity: 0.92;
  animation: dieFloatLeft 3.2s ease-in-out infinite;
  animation-delay: -0.8s;
}

/* 右侧骰子 */
.die-pos-right {
  transform: translateX(240rpx) scale(0.52);
  z-index: 5;
  opacity: 0.92;
  animation: dieFloatRight 3.4s ease-in-out infinite;
  animation-delay: -1.6s;
}

/* 上下呼吸浮动 - 三颗各自相位/速度/幅度 */
@keyframes dieFloatCenter {
  0%, 100% { transform: translateX(0) scale(1) translateY(0); }
  50%      { transform: translateX(0) scale(1) translateY(-14rpx); }
}
@keyframes dieFloatLeft {
  0%, 100% { transform: translateX(-240rpx) scale(0.52) translateY(0); }
  50%      { transform: translateX(-240rpx) scale(0.52) translateY(-8rpx); }
}
@keyframes dieFloatRight {
  0%, 100% { transform: translateX(240rpx) scale(0.52) translateY(0); }
  50%      { transform: translateX(240rpx) scale(0.52) translateY(-10rpx); }
}

/* 模式名称胶囊 - 白底深色字（对齐首页.png） */
.mode-name-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 48rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.85);
