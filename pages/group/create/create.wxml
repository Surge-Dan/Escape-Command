<view class="page-container group-create-page">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  <view class="nav-header" style="{{navHeaderStyle}}">
    <view class="nav-header-back" catchtap="onBackTap">
      <image src="/assets/icons/chevron-left-ink.svg" mode="aspectFit"></image>
    </view>
    <text class="nav-header-title">创建出逃房间</text>
    <view class="nav-header-divider"></view>
  </view>

  <scroll-view scroll-y class="create-scroll">
    <view class="create-hero">
      <text class="create-hero-title">发起一次同频出逃</text>
      <text class="create-hero-sub">约上朋友，一起掷骰决定今天的出逃任务</text>
    </view>

    <view class="create-card">
      <view class="form-row">
        <text class="form-label">同频主题</text>
        <input class="form-input"
               value="{{topic}}"
               placeholder="比如：周末探店 / 周末出逃"
               placeholder-class="form-input-ph"
               maxlength="20"
               bindinput="onTopicInput" />
        <text class="form-counter">{{topic.length}}/20</text>
      </view>

      <view class="form-divider"></view>

      <view class="form-row">
        <text class="form-label">人数上限</text>
        <picker class="form-picker" mode="selector" range="{{memberOptions}}" value="{{memberIndex}}" bindchange="onMemberChange">
          <view class="form-picker-value">
            <text>{{memberOptions[memberIndex]}} 人</text>
            <image class="form-picker-arrow" src="/assets/icons/chevron-right-faint.svg" mode="aspectFit"></image>
          </view>
        </picker>
        <text class="form-hint">含发起人，3-6 人</text>
      </view>
    </view>

    <view class="create-tips">
      <text class="tips-title">小贴士</text>
      <text class="tips-text">创建后会生成房间号，朋友加入后可以一起投票决定出逃时间、预算和风格。</text>
    </view>

    <view class="bottom-spacer"></view>
  </scroll-view>

  <view class="create-footer">
    <view class="create-btn {{creating ? 'loading' : ''}} {{!topic || creating ? 'disabled' : ''}}"
          bindtap="onCreateTap">
      <view wx:if="{{creating}}" class="create-btn-loading"></view>
      <text>{{creating ? '创建中...' : '创建组局'}}</text>
    </view>
  </view>
</view>
