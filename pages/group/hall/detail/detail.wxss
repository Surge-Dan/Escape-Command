/* ===== C-P3 任务详情页 ===== */

.detail-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, #FFF0E4 0%, #FFF6F0 18%, #F5F3EF 55%, #F5F3EF 100%);
}

.detail-page .nav-header {
  flex-shrink: 0;
  background: transparent;
}

/* 主滚动区 */
.detail-scroll {
  flex: 1;
  height: 0;
  padding: 0 40rpx;
}

.detail-body {
  padding: 24rpx 0 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ===== 1. Hero 卡片 ===== */
.hero-card {
  background: var(--white);
  border: var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.hero-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.hero-topic {
  flex: 1;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 0.5rpx;
  line-height: 1.3;
}

.official-badge {
  flex-shrink: 0;
  background: #FFF8F0;
  color: var(--brand-dark);
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-xs);
  letter-spacing: 0.5rpx;
}

.hero-poi {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.poi-name {
  font-size: 28rpx;
  color: var(--brand-dark);
  font-weight: 600;
  letter-spacing: 0.3rpx;
}

.poi-address {
  font-size: 24rpx;
  color: var(--ink-soft);
  letter-spacing: 0.3rpx;
  line-height: 1.5;
}

.hero-chips {
  display: flex;
  gap: 12rpx;
}

.chip {
  font-size: 22rpx;
  color: var(--ink-soft);
  background: var(--canvas);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  letter-spacing: 0.3rpx;
}

/* ===== 2. 信息网格 ===== */
.info-grid {
  background: var(--white);
  border: var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: 28rpx;
  display: flex;
  flex-wrap: wrap;
}

.info-item {
  width: 50%;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 8rpx 0;
  padding-right: 16rpx;
}

.info-label {
  font-size: 22rpx;
  color: var(--ink-faint);
  letter-spacing: 0.5rpx;
}

.info-value {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 600;
  letter-spacing: 0.3rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.master-mark {
  font-size: 24rpx;
  line-height: 1;
}

.status-recruiting { color: var(--brand); }
.status-ready { color: var(--accent); }
.status-started { color: var(--ink-soft); }
.status-finished { color: var(--ink-faint); }

/* ===== 通用 Section ===== */
.section {
  background: var(--white);
  border: var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 0.5rpx;
}

/* ===== 3. 当前成员 ===== */
.members-row {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.member {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  width: 96rpx;
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--brand-tint);
  border: 2rpx solid var(--brand-tint);
}

.member-name {
  font-size: 22rpx;
  color: var(--ink-soft);
  max-width: 96rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0.3rpx;
  text-align: center;
}

.host-tag {
  position: absolute;
  top: -6rpx;
  right: 0;
  font-size: 18rpx;
  color: var(--white);
  background: var(--brand);
  padding: 2rpx 8rpx;
  border-radius: var(--radius-xs);
  letter-spacing: 0.3rpx;
  line-height: 1.4;
}

.members-empty {
  font-size: 24rpx;
  color: var(--ink-faint);
  letter-spacing: 0.3rpx;
  padding: 8rpx 0;
}

/* ===== 4. 任务描述 ===== */
.desc-text {
  font-size: 26rpx;
  color: var(--ink-soft);
  line-height: 1.6;
  letter-spacing: 0.3rpx;
}

/* ===== 5. 出逃步骤预览 ===== */
.steps-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.step-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.step-no {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--brand-dark);
  background: var(--brand-tint);
  border-radius: 50%;
  line-height: 1;
}

.step-text {
  flex: 1;
  font-size: 22rpx;
  color: var(--ink-soft);
  line-height: 1.6;
  letter-spacing: 0.3rpx;
  padding-top: 4rpx;
}

/* ===== 6. 标签 ===== */
.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-chip {
  font-size: 22rpx;
  color: var(--ink-soft);
  background: #F5F3EF;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-xs);
  letter-spacing: 0.3rpx;
}

.bottom-spacer {
  height: 80rpx;
}

/* ===== 7. 底部操作栏 ===== */
.footer {
  flex-shrink: 0;
  display: flex;
  gap: 16rpx;
  padding: 24rpx 40rpx 48rpx;
  background: rgba(245, 243, 239, 0.92);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

.footer-actions {
  flex: 1;
  display: flex;
  gap: 16rpx;
}

.footer-btn {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--radius-md);
  letter-spacing: 1rpx;
  transition: opacity 200ms var(--ease-standard), transform 200ms var(--ease-standard);
}

.footer-btn:active {
  transform: scale(0.98);
}

.footer-btn.primary {
  background: var(--brand);
  color: var(--white);
  border: 2rpx solid var(--brand);
}

.footer-btn.ghost {
  background: var(--white);
  border: 2rpx solid var(--brand);
  color: var(--brand-dark);
}

.footer-btn.disabled {
  background: var(--canvas);
  color: var(--ink-faint);
  border: 2rpx solid var(--border);
}
