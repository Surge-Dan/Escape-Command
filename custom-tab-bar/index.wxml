<view class="custom-tabbar">
  <view
    wx:for="{{list}}"
    wx:key="index"
    class="tabbar-item {{selected === index ? 'active' : ''}}"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <text class="tabbar-text">{{item.text}}</text>
  </view>
</view>
<view class="tabbar-placeholder"></view>
