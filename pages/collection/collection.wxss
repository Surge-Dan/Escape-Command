.collection-page {
  min-height: 100vh;
  background: var(--bg-gradient);
}

.status-bar { flex-shrink: 0; background: transparent; }
.collection-page .nav-header {
  background: transparent;
  border-bottom: none;
}

.manage-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: var(--brand);
  font-weight: 500;
  background: var(--brand-weak);
  border-radius: var(--radius-pill);
  transition: all 150ms ease;
}
.manage-btn:active { background: var(--brand-tint); }

/* ===== 顶部筛选条 ===== */
.filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 40rpx 20rpx;
  background: transparent;
  position: relative;
}

.filter-tabs {
  display: flex;
  gap: 12rpx;
  flex: 1;
  overflow-x: auto;
}
.filter-tabs::-webkit-scrollbar { display: none; }

.filter-chip {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid var(--border-soft);
  font-size: 26rpx;
  color: var(--ink-soft);
  font-weight: 500;
  transition: all 180ms var(--ease-standard);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.filter-chip.active {
  background: var(--brand);
  color: var(--white);
  border-color: var(--brand);
  box-shadow: 0 4rpx 12rpx rgba(91, 143, 185, 0.3);
}

.sort-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 22rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid var(--border-soft);
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  color: var(--ink-soft);
  font-weight: 500;
  flex-shrink: 0;
  margin-left: 14rpx;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.sort-ico {
  width: 20rpx;
  height: 20rpx;
  transform: rotate(90deg);
  opacity: 0.5;
}

.sort-menu {
  position: absolute;
  right: 40rpx;
  top: 92rpx;
  z-index: 30;
  background: var(--white);
  border: var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-popup);
  padding: 8rpx 0;
  min-width: 200rpx;
  animation: sortMenuIn 200ms var(--ease-out);
  overflow: hidden;
}

@keyframes sortMenuIn {
  from { opacity: 0; transform: translateY(-8rpx) scale(0.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.sort-menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx;
  font-size: 28rpx;
  color: var(--ink);
  transition: background 150ms ease;
}
.sort-menu-item:active { background: var(--brand-weak); }

.sort-menu-item.active {
  color: var(--brand);
  font-weight: 600;
}

.sort-menu-check {
  color: var(--brand);
  font-size: 28rpx;
  font-weight: 700;
}

/* ===== 列表 ===== */
.collection-scroll {
  padding: 0 40rpx 40rpx;
  box-sizing: border-box;
}

.command-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.command-card {
  display: flex;
  background: var(--white);
  border-radius: var(--radius-xl);
  border: 1rpx solid var(--border-soft);
  overflow: hidden;
  box-shadow: var(--shadow-card);
  transition: all 180ms var(--ease-standard);
  min-height: 220rpx;
}

.command-card:active {
  transform: scale(0.985);
}

.command-card.selected {
  border-color: var(--brand);
  box-shadow: 0 0 0 4rpx var(--brand-tint), var(--shadow-card);
}

.batch-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border-soft);
  background: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 28rpx 0 0 24rpx;
  flex-shrink: 0;
  transition: all 180ms ease;
}

.batch-check.checked {
  background: var(--brand);
  border-color: var(--brand);
  box-shadow: 0 4rpx 12rpx rgba(91, 143, 185, 0.3);
}

.batch-check image {
  width: 24rpx;
  height: 24rpx;
}

.command-card-main {
  flex: 1;
  display: flex;
  background: transparent;
}

.command-card-left {
  flex: 1;
  padding: 24rpx 20rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  justify-content: space-between;
  min-width: 0;
}

.tag-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.command-type-tag,
.command-mode-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-xs);
  font-size: 22rpx;
  font-weight: 600;
}

.tag-icon { width: 20rpx; height: 20rpx; }

.status-tag {
  padding: 6rpx 14rpx;
  border-radius: var(--radius-xs);
  font-size: 22rpx;
  font-weight: 600;
}

.status-tag.done {
  background: var(--accent-tint);
  color: var(--success);
}

.status-tag.fav {
  background: var(--gold-tint);
  color: var(--gold);
}

.command-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  letter-spacing: 0.5rpx;
}

.command-meta-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--ink-faint);
}

.meta-item image { width: 22rpx; height: 22rpx; opacity: 0.7; }

.command-card-right {
  width: 200rpx;
  height: 160rpx;
  position: relative;
  flex-shrink: 0;
  background: linear-gradient(135deg, var(--brand-weak) 0%, var(--brand-tint) 100%);
  align-self: center;
  margin-right: 20rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.remove-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 150ms var(--ease-standard);
}

.remove-btn::before {
  content: '';
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: 0 2rpx 8rpx rgba(91, 143, 185, 0.15);
}

.remove-btn:active::before {
  transform: scale(0.88);
  background: var(--danger-tint);
}

.remove-ico {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  z-index: 1;
  opacity: 0.55;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  padding: 0 40rpx;
  text-align: center;
}

.empty-illust {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 28rpx;
  opacity: 0.5;
  animation: floatSoft 3s ease-in-out infinite;
}

@keyframes floatSoft {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  font-family: var(--serif);
  letter-spacing: 2rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--ink-faint);
  margin-top: 12rpx;
}

.empty-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
  padding: 0 48rpx;
  height: 88rpx;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-light) 100%);
  color: var(--white);
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: var(--shadow-btn);
  transition: transform 180ms var(--ease-standard);
}

.empty-btn:active {
  transform: scale(0.97);
}

.bottom-tip {
  padding: 28rpx 0 40rpx;
  text-align: center;
}

.tip-text {
  font-size: 24rpx;
  color: var(--ink-faint);
  letter-spacing: 0.5rpx;
}

/* ===== 批量管理底栏 ===== */
.batch-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--white);
  border-top: 1rpx solid var(--line);
  box-shadow: 0 -4rpx 24rpx rgba(91, 143, 185, 0.1);
}

.batch-cancel,
.batch-delete {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--radius-pill);
  font-size: 30rpx;
  font-weight: 600;
  transition: transform 150ms var(--ease-standard);
}

.batch-cancel {
  background: var(--brand-weak);
  color: var(--brand);
}

.batch-cancel:active { transform: scale(0.97); background: var(--brand-tint); }

.batch-delete {
  background: linear-gradient(135deg, var(--danger) 0%, #EB7B7B 100%);
  color: var(--white);
  box-shadow: 0 6rpx 16rpx rgba(224, 85, 85, 0.3);
}

.batch-delete.disabled {
  background: var(--ink-faint);
  box-shadow: none;
  opacity: 0.55;
}

.batch-delete:active { transform: scale(0.97); }
