/* 悬浮胶囊式 TabBar - v9 隐藏状态版
   根因：::after 伪元素在部分机型/基础库上 z-index 渲染不可靠，滑块背景会穿透到边框上方。
   修复策略：用真实 <view class="tabbar-border-overlay"> 替代 ::after，确保 z-index 层级生效。
   1. 容器不用 border，用 box-shadow(outset) 做外部投影
   2. 真实 view 绘制描边（z-index:10 渲染在滑块之上，pointer-events:none 不挡点击）
   3. view 只有 border 无 background，不会盖住文字
   4. 滑块高度 72rpx（< 容器 96rpx），留 12rpx 上下间距，物理隔离
   5. v9: 新增 hidden 状态，整组滑出屏幕（弹窗可贴底） */

.custom-tabbar {
  position: fixed;
  bottom: calc(72rpx + env(safe-area-inset-bottom, 34rpx));
  left: 32rpx;
  right: 32rpx;
  z-index: 500;
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 10rpx;
  background: #ffffff;
  border-radius: 100rpx;
  /* 不用 border，用外部 box-shadow 做投影 */
  box-shadow:
    0 10rpx 32rpx rgba(45, 90, 123, 0.10),
    0 2rpx 8rpx rgba(45, 90, 123, 0.05);
  overflow: hidden;
  box-sizing: border-box;
  transition: transform 240ms cubic-bezier(0.34, 1.3, 0.64, 1), opacity 200ms ease;
}

/* 隐藏状态：整组滑出屏幕 + 透明（弹窗可贴底） */
.custom-tabbar.is-hidden {
  opacity: 0;
  transform: translateY(calc(100% + 80rpx));
  pointer-events: none;
}

/* 真实边框层：z-index:10 在滑块(z-index:2)之上，绘制 1rpx 描边
   无 background，不会遮挡文字和滑块内容 */
.tabbar-border-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border: 1rpx solid rgba(91, 143, 185, 0.18);
  border-radius: 100rpx;
  pointer-events: none;
  z-index: 10;
  box-sizing: border-box;
}

.tabbar-item {
  position: relative;
  flex: 1;
  height: 72rpx;                        /* < 容器内高 74rpx，留 1rpx 间距 */
  align-self: center;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 4rpx;
  border-radius: 36rpx;                 /* = 72/2，完美胶囊 */
  transition: all 280ms cubic-bezier(0.34, 1.3, 0.64, 1);
  z-index: 1;                           /* 低于 border-overlay(10) */
  box-sizing: border-box;
}

.tabbar-item.active {
  background: #C9F0FA;
  z-index: 2;                           /* 低于 border-overlay(10)，描边始终在最上层 */
}

.tabbar-item:active {
  transform: scale(0.96);
}

.tabbar-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #5B8FB9;
  letter-spacing: 2rpx;
  transition: color 0.2s ease;
  position: relative;
  z-index: 3;
}

.tabbar-item.active .tabbar-text {
  color: #2D5A7B;
  font-weight: 600;
}

/* 占位元素：固定高度，撑起页面底部内容空间 */
.tabbar-placeholder {
  height: calc(180rpx + env(safe-area-inset-bottom, 34rpx));
  transition: height 240ms cubic-bezier(0.34, 1.3, 0.64, 1);
}

/* 占位在 tabbar 隐藏时也收起（防止弹窗背后被占位影响布局） */
.tabbar-placeholder.is-hidden {
  height: 0;
}
