.status-bar { flex-shrink: 0; }

.page-scroll {
  width: 100%;
}

.help-body {
  padding: 32rpx 40rpx 0;
}

.section-label {
  display: block;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--ink-faint);
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  font-family: var(--serif);
}

/* ===== Accordion ===== */
.accordion {
  padding: 0 28rpx;
  margin-bottom: 40rpx;
  overflow: hidden;
}

.acc-item {
  border-bottom: 1rpx solid var(--line);
}

.acc-item.last {
  border-bottom: 0;
}

.acc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx 0;
  transition: background 150ms var(--ease-standard);
}

.acc-head:active {
  background: var(--canvas);
}

.acc-q {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
  font-family: var(--serif);
}

.acc-chev {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 250ms var(--ease-standard);
}

.acc-chev image {
  width: 32rpx;
  height: 32rpx;
}

.acc-item.open .acc-chev {
  transform: rotate(90deg);
}

.acc-panel {
  max-height: 0;
  overflow: hidden;
  transition: max-height 280ms var(--ease-standard);
}

.acc-item.open .acc-panel {
  max-height: 1200rpx;
}

.acc-panel-inner {
  padding: 0 0 28rpx;
}

.acc-a {
  display: block;
  font-size: 26rpx;
  line-height: 1.65;
  color: var(--ink-soft);
}

/* ===== 6 个模式列表 ===== */
.mode-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
}

.mode-row + .mode-row {
  border-top: 1rpx solid var(--line);
}

.mode-ico {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-md);
  background: var(--brand-tint);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mode-ico image {
  width: 32rpx;
  height: 32rpx;
}

.mode-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.mode-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  font-family: var(--serif);
}

.mode-desc {
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.4;
}

/* ===== 使用技巧 ===== */
.tips-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.tip-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 28rpx;
  background: var(--white);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
}

.tip-ico {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-lg);
  background: var(--brand-tint);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tip-ico image {
  width: 36rpx;
  height: 36rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  font-family: var(--serif);
}

.tip-desc {
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.5;
}

/* ===== 反馈按钮 ===== */
.feedback-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  margin-top: 8rpx;
}

.feedback-ico {
  width: 32rpx;
  height: 32rpx;
}

.bottom-spacer {
  height: calc(64rpx + var(--safe-bottom));
}
