<view class="page-container home-page paper-texture theme-{{theme}} {{fontLoaded ? 'font-loaded' : ''}}">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  <!-- v7: 统一导航栏，与 map/profile 一致，避开胶囊按钮 -->
  <view class="nav-header" style="{{navHeaderStyle}}">
    <text class="nav-header-title">出逃指令</text>
    <view class="nav-header-divider"></view>
  </view>
  <scroll-view scroll-y class="home-scroll" enhanced show-scrollbar="{{false}}">
    <!-- v9: hero 区精简——Pill 改淡灰色 + 真实日期 -->
    <view class="hero-warm">
      <view class="hero-pill">
        <view class="hero-pill-dot"></view>
        <text class="hero-pill-text">{{dateText}}</text>
      </view>
      <view class="hero-title-wrap">
        <text class="hero-title-line">{{greetingText}},</text>
        <text class="hero-title-line hero-title-second">
          <text class="hero-italic">{{heroEmphasis}}</text>
          <text>{{heroTail}}</text>
        </text>
      </view>
      <text class="hero-sub">{{heroSubText}}</text>
    </view>

    <!-- home-dice-entry-01: 单骰居中 + 右划切换 + 点击转动 -->
    <view wx:if="{{!selectedCommand}}" class="dice-stage"
          bindtouchstart="onTouchStart"
          bindtouchend="onTouchEnd">
      <view class="dice-stage-inner">
        <view wx:for="{{diceList}}" wx:key="id"
              class="dice-card {{currentDiceIndex === index ? 'active' : (index < currentDiceIndex ? 'prev' : 'next')}} {{isRolling && currentDiceIndex === index ? 'rolling' : ''}}"
              data-index="{{index}}"
              bindtap="onDiceTap">
          <view class="dice-card-inner" style="background: {{item.color}}1A;">
            <image class="dice-ico" src="{{item.icon}}" mode="aspectFit"></image>
          </view>
          <text class="dice-name">{{item.name}}</text>
          <text class="dice-hint">点击掷骰</text>
        </view>
      </view>
      <view class="dice-dots">
        <view wx:for="{{diceList}}" wx:key="id"
              class="dice-dot {{currentDiceIndex === index ? 'active' : ''}}"></view>
      </view>
      <view class="dice-info">
        <text class="dice-info-name">{{diceList[currentDiceIndex].name}}</text>
        <text class="dice-info-desc">{{diceList[currentDiceIndex].desc}}</text>
      </view>
    </view>

    <!-- v9: 收藏入口——0 条时改为极简一行 -->
    <view wx:if="{{!selectedCommand && collectedCount === 0}}" class="collect-entry-mini" bindtap="goCollection">
      <image class="collect-mini-ico" src="/assets/icons/bookmark.svg" mode="aspectFit"></image>
      <text class="collect-mini-text">还没有收藏，去看看</text>
      <image class="collect-mini-arrow" src="/assets/icons/chevron-right-faint.svg" mode="aspectFit"></image>
    </view>
    <view wx:if="{{!selectedCommand && collectedCount > 0}}" class="collect-entry-card" bindtap="goCollection">
      <view class="collect-entry-icon-wrap">
        <image class="collect-entry-ico" src="/assets/icons/bookmark-brand.svg" mode="aspectFit"></image>
      </view>
      <view class="collect-entry-text">
        <text class="collect-entry-title">我的收藏</text>
        <text class="collect-entry-sub">{{collectedCount}} 条指令</text>
      </view>
      <image class="collect-arrow" src="/assets/icons/chevron-right-faint.svg" mode="aspectFit"></image>
    </view>

    <!-- C-P8: 上次出逃记录（单卡高亮） -->
    <view wx:if="{{!selectedCommand && lastRecord}}" class="last-record-card" data-id="{{lastRecord.id}}" bindtap="goRecordDetail">
      <view class="last-record-head">
        <view class="last-record-tag" style="background: {{lastRecord.typeColor}}14; color: {{lastRecord.typeColor}};">
          <text>{{lastRecord.typeName}}</text>
        </view>
        <text class="last-record-date">{{lastRecord.dateLabel}} · {{lastRecord.time}}</text>
      </view>
      <text class="last-record-title">{{lastRecord.commandTitle}}</text>
      <view class="last-record-meta">
        <view wx:if="{{lastRecord.duration}}" class="last-record-meta-item">
          <image class="last-record-meta-ico" src="/assets/icons/clock-brand.svg" mode="aspectFit"></image>
          <text>约 {{lastRecord.duration}} 分钟</text>
        </view>
        <view wx:if="{{lastRecord.location && lastRecord.location.latitude}}" class="last-record-meta-item">
          <image class="last-record-meta-ico" src="/assets/icons/map-pin-brand.svg" mode="aspectFit"></image>
          <text>已留痕</text>
        </view>
      </view>
    </view>

    <!-- C-P8: 最近出逃记录（横向滚动） -->
    <view wx:if="{{!selectedCommand && recentRecords.length}}" class="daily-section recent-section">
      <view class="section-header">
        <text class="section-title">最近出逃</text>
        <text class="section-sub">{{recentRecords.length}} 条记录</text>
      </view>
      <scroll-view scroll-x class="daily-scroll" enhanced show-scrollbar="{{false}}">
        <view wx:for="{{recentRecords}}" wx:key="id" class="daily-card recent-card" data-id="{{item.id}}" bindtap="goRecordDetail">
          <view class="daily-type" style="background: {{item.typeColor}}14; color: {{item.typeColor}};">
            <text>{{item.typeName}}</text>
          </view>
          <text class="daily-title">{{item.commandTitle}}</text>
          <text class="daily-meta">{{item.dateLabel}}{{item.duration ? ' · ' + item.duration + '分钟' : ''}}</text>
        </view>
      </scroll-view>
    </view>

    <!-- 每日推荐（v9：进入首屏，即"推荐出逃任务"） -->
    <view wx:if="{{!selectedCommand && dailyRecommend.length}}" class="daily-section">
      <view class="section-header">
        <text class="section-title">今日推荐</text>
        <text class="section-sub">基于天气和时间</text>
      </view>
      <scroll-view scroll-x class="daily-scroll" enhanced show-scrollbar="{{false}}">
        <view wx:for="{{dailyRecommend}}" wx:key="id" class="daily-card" data-id="{{item.id}}" bindtap="goCommandDetail">
          <view class="daily-type" style="background: {{item.typeColor}}14; color: {{item.typeColor}};">
            <text>{{item.typeName}}</text>
          </view>
          <text class="daily-title">{{item.title}}</text>
          <text class="daily-meta">{{item.duration ? '约 ' + item.duration + ' 分钟' : ''}}</text>
        </view>
      </scroll-view>
    </view>

    <!-- 指令详情卡 -->
    <view wx:if="{{selectedCommand}}" class="command-sheet">
      <view class="cmd-card">
        <!-- v12: 关闭按钮左上角，收藏按钮右上角，分别绝对定位 -->
        <view class="cmd-close" catchtap="closeCommand">
          <image src="/assets/icons/x-ink-faint.svg" mode="aspectFit"></image>
        </view>
        <view class="favorite-toggle {{collected ? 'active' : ''}}" catchtap="collectCmd">
          <image src="{{collected ? '/assets/icons/bookmark-brand.svg' : '/assets/icons/bookmark.svg'}}" mode="aspectFit"></image>
        </view>
        <!-- 类型标签 -->
        <view class="cmd-type-row">
          <view class="cmd-type" style="background: {{selectedCommand.typeColor}}14; color: {{selectedCommand.typeColor}};">
            <image class="type-ico" src="{{selectedCommand.typeIcon}}" mode="aspectFit"></image>
            <text>{{selectedCommand.typeName}}</text>
          </view>
        </view>

        <!-- 标题 -->
        <view wx:if="{{invitedByFriend}}" class="invite-tag">
          <text>来自朋友的邀请</text>
        </view>
        <text class="cmd-title">{{selectedCommand.title}}</text>

        <!-- 场景插画 -->
        <view class="cmd-image-wrap">
          <view class="cmd-image-bg" style="background: linear-gradient(135deg, {{selectedCommand.typeColor}}40, {{selectedCommand.typeColor}}10);">
            <image class="cmd-image-icon" src="{{selectedCommand.typeIcon}}" mode="aspectFit"></image>
          </view>
          <image class="cmd-image" src="{{selectedCommand.illustration}}" mode="aspectFill" wx:if="{{selectedCommand.illustration}}"></image>
          <view class="cmd-image-badge" style="background: {{selectedCommand.typeColor}};">
            <image class="badge-mini-ico" src="{{selectedCommand.typeIcon}}" mode="aspectFit"></image>
          </view>
        </view>

        <!-- 元信息 -->
        <view class="cmd-meta">
          <view wx:if="{{selectedCommand.duration}}" class="meta-item">
            <image src="/assets/icons/clock-brand.svg" mode="aspectFit"></image>
            <text>约 {{selectedCommand.duration}} 分钟</text>
          </view>
          <view class="meta-item">
            <image src="/assets/icons/map-pin-brand.svg" mode="aspectFit"></image>
            <text>{{selectedCommand.distance}}</text>
          </view>
          <view class="meta-item">
            <image src="/assets/icons/user-brand.svg" mode="aspectFit"></image>
            <text>{{selectedCommand.people}}</text>
          </view>
        </view>

        <!-- 小贴士 -->
        <view class="tip-box">
          <view class="tip-head">
            <view class="tip-icon-dot"></view>
            <text class="tip-label">小贴士</text>
          </view>
          <text class="tip-text">{{selectedCommand.tip || '慢慢走，留意街边的细节。'}}</text>
        </view>
      </view>

      <!-- 操作区：邀请朋友 + 重摇 + 接受指令 -->
      <view class="cmd-actions">
        <button wx:if="{{selectedCommand.double || selectedCommand.social}}" class="invite-btn" open-type="share">
          <image src="/assets/icons/users-white.svg" mode="aspectFit"></image>
          <text>邀请朋友</text>
        </button>
        <view class="action-btn secondary" catchtap="reroll">
          <image src="/assets/icons/refresh-cw-ink-soft.svg" mode="aspectFit"></image>
        </view>
        <view class="action-btn primary" catchtap="startCommand">
          <image src="/assets/icons/check-white.svg" mode="aspectFit"></image>
          <text>接受指令</text>
        </view>
      </view>
      <view wx:if="{{remainCount === 0}}" class="reroll-hint">
        <text>次数用完，可自定义</text>
      </view>
    </view>
    <view class="bottom-spacer"></view>
  </scroll-view>

  <!-- sync-dice-sheet: 同频骰子入口选择弹层 -->
  <view wx:if="{{showDiceSheet}}" class="dice-sheet-mask" bindtap="onDiceSheetMaskTap">
    <view class="dice-sheet-panel" catchtap="">
      <view class="dice-sheet-handle"></view>
      <view class="dice-sheet-header">
        <text class="dice-sheet-title">选择出逃方式</text>
        <text class="dice-sheet-close" bindtap="onDiceSheetClose">✕</text>
      </view>
      <view class="dice-sheet-option" bindtap="onInviteFriendsTap">
        <text class="dice-option-icon">👥</text>
        <view class="dice-option-info">
          <text class="dice-option-label">邀请好友组局</text>
          <text class="dice-option-desc">约上熟人，一起掷骰决定今天的出逃任务</text>
        </view>
        <text class="dice-option-arrow">›</text>
      </view>
      <view class="dice-sheet-option" bindtap="onEnterHallTap">
        <text class="dice-option-icon">🎲</text>
        <view class="dice-option-info">
          <text class="dice-option-label">进入任务大厅找搭子</text>
          <text class="dice-option-desc">找到官方或用户创建的出逃任务，人齐就出发</text>
        </view>
        <text class="dice-option-arrow">›</text>
      </view>
      <view class="dice-sheet-cancel" bindtap="onDiceSheetClose">取消</view>
    </view>
  </view>

  <!-- 自定义 TabBar -->
  <custom-tab-bar selected="{{0}}"></custom-tab-bar>
</view>
