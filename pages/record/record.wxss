/* ===== 记录页 · 浅雾蓝设计系统 ===== */
/* v3 重跑：.nav-header 迁移 + 9 照片横滑 + 6 滤镜 + 贴纸库 + 位置卡 + 手写感受 */

.record-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: var(--bg-gradient);
}

.status-bar { width: 100%; }

.record-scroll { flex: 1; height: 0; }
.record-body { padding: 32rpx 40rpx; }

/* ===== 拍立得卡片 ===== */
.polaroid-card {
  width: 560rpx;
  margin: 0 auto;
  padding: 28rpx 28rpx 36rpx;
  border-radius: var(--radius-lg);
  background: var(--white);
  box-shadow: 0 12rpx 40rpx rgba(91, 143, 185, 0.18);
  transform: rotate(-1.5deg);
  animation: polaroidIn 500ms var(--ease-bounce);
  border: 1rpx solid var(--border-soft);
}

@keyframes polaroidIn {
  from { opacity: 0; transform: scale(0.9) rotate(-1.5deg); }
  to { opacity: 1; transform: scale(1) rotate(-1.5deg); }
}

.polaroid-photo-area {
  position: relative;
  height: 480rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--canvas);
}

.polaroid-photo { width: 100%; height: 100%; }

/* 心情贴纸角标 */
.photo-mood-sticker {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-float);
  border: 3rpx solid rgba(255,255,255,0.9);
  background: var(--white);
}

.photo-mood-sticker image { width: 44rpx; height: 44rpx; }

/* emoji 贴纸叠加层（点击移除） */
.photo-emoji-sticker {
  position: absolute;
  transform: translate(-50%, -50%);
  font-size: 56rpx;
  line-height: 1;
  z-index: 5;
  filter: drop-shadow(0 2rpx 6rpx rgba(45, 90, 123, 0.25));
  transition: transform 150ms var(--ease-standard);
  -webkit-tap-highlight-color: transparent;
  touch-action: none;
}

/* 拖拽中：放大 1.25 倍 + 取消过渡 */
.photo-emoji-sticker.dragging {
  transform: translate(-50%, -50%) scale(1.25);
  transition: none;
  z-index: 8;
  filter: drop-shadow(0 4rpx 12rpx rgba(45, 90, 123, 0.35));
}

.photo-emoji-sticker:active { transform: translate(-50%, -50%) scale(0.85); }

/* 感受输入（inline on polaroid，手写风） */
.feeling-input {
  width: 100%;
  min-height: 96rpx;
  margin-top: 20rpx;
  padding: 0 8rpx;
  font-size: 30rpx;
  color: var(--ink);
  line-height: 1.5;
  font-style: italic;
  font-family: "Kaiti", "STKaiti", "Songti SC", "Noto Serif SC", "Caveat", cursive;
  letter-spacing: 0.5rpx;
}

.polaroid-meta {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 14rpx;
  padding: 0 8rpx;
  font-size: 20rpx;
  color: var(--ink-faint);
  letter-spacing: 0.5rpx;
}

/* ===== 位置卡片 ===== */
.location-card {
  margin: 24rpx auto 0;
  width: 560rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 24rpx;
  border-radius: var(--radius-xl);
  background: var(--white);
  border: 2rpx solid var(--border-soft);
  box-shadow: var(--shadow-card);
}

.location-card image { width: 32rpx; height: 32rpx; flex-shrink: 0; opacity: 0.7; }

.location-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-weight: 500;
}

/* ===== Section 通用 ===== */
.section { margin-top: 48rpx; }

.section-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  font-family: var(--serif);
  letter-spacing: 1rpx;
}

/* ===== 照片缩略图横滑条 ===== */
.photo-strip { width: 100%; }

.photo-strip-list {
  display: flex;
  gap: 12rpx;
  padding: 4rpx 6rpx;
}

.photo-strip-thumb {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--canvas);
  border: 3rpx solid transparent;
  flex-shrink: 0;
  transition: all 150ms var(--ease-standard);
}

.photo-strip-thumb.active {
  border-color: var(--brand);
  box-shadow: var(--shadow-elevated);
}

.photo-strip-thumb:active { transform: scale(0.95); }

.photo-strip-thumb image { width: 100%; height: 100%; }

.photo-strip-remove {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(45, 90, 123, 0.7);
  color: var(--white);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-shadow: 0 2rpx 8rpx rgba(45, 90, 123, 0.3);
}

.photo-strip-add {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-md);
  border: 2rpx dashed var(--ink-faint);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-soft);
  font-size: 48rpx;
  flex-shrink: 0;
  transition: all 150ms var(--ease-standard);
  background: var(--brand-weak);
}

.photo-strip-add:active {
  background: var(--brand-tint);
  border-color: var(--brand);
  transform: scale(0.97);
}

/* ===== 滤镜选择 ===== */
.filter-row { width: 100%; }

.filter-row-list {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 6rpx;
}

.filter-thumb {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  transition: all 200ms var(--ease-standard);
}

.filter-thumb-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-md);
  background: var(--canvas);
  border: 3rpx solid transparent;
  overflow: hidden;
  transition: all 200ms var(--ease-standard);
}

.filter-thumb.active .filter-thumb-img {
  border-color: var(--brand);
  box-shadow: var(--shadow-card);
  transform: scale(1.05);
}

.filter-thumb:active .filter-thumb-img { transform: scale(0.95); }

.filter-thumb-name {
  font-size: 22rpx;
  color: var(--ink-soft);
  letter-spacing: 0.3rpx;
}

.filter-thumb.active .filter-thumb-name {
  color: var(--brand-strong);
  font-weight: 600;
}

/* ===== emoji 贴纸库 ===== */
.sticker-row { width: 100%; }

.sticker-list {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 6rpx;
}

.sticker-item {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
  background: var(--white);
  border: 2rpx solid var(--border-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  line-height: 1;
  flex-shrink: 0;
  transition: all 150ms var(--ease-standard);
}

.sticker-item:active {
  background: var(--brand-tint);
  border-color: var(--brand);
  transform: scale(0.92);
}

/* ===== 心情贴纸 ===== */
.mood-row {
  display: flex;
  justify-content: space-between;
}

.mood-item {
  min-width: 96rpx;
  min-height: 128rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
  transition: all 200ms var(--ease-standard);
  letter-spacing: 0.3rpx;
}

.mood-circle {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid transparent;
  background: var(--brand-weak);
  transition: all 200ms var(--ease-standard);
}

.mood-circle.picked {
  border-color: var(--brand);
  background: var(--white);
  transform: scale(1.12);
  box-shadow: var(--shadow-card);
}

.mood-circle:active { transform: scale(0.92); }
.mood-circle image { width: 44rpx; height: 44rpx; }

.mood-item.active {
  color: var(--brand-dark);
  font-weight: 600;
}

/* ===== 底部保存按钮 ===== */
.save-bar {
  padding: 24rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(232, 244, 252, 0) 0%, var(--canvas) 40%);
}

.save-btn {
  width: 100%;
  min-height: 88rpx;
  border-radius: var(--radius-pill);
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
  color: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 150ms var(--ease-standard);
  box-shadow: var(--shadow-btn);
  letter-spacing: 1rpx;
}

.save-btn.loading { opacity: 0.75; }
.save-btn:active {
  background: linear-gradient(135deg, var(--brand-dark) 0%, var(--brand) 100%);
  transform: scale(0.97);
}
.save-btn image { width: 32rpx; height: 32rpx; }

/* ===== 分享画布 ===== */
.share-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 600px;
  height: 900px;
}

/* ===== 保存成功弹层 ===== */
.saved-overlay {
  position: fixed;
  inset: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 64rpx;
  background: rgba(45, 90, 123, 0.5);
  backdrop-filter: blur(8rpx);
}

.saved-card {
  width: 100%;
  padding: 48rpx;
  border-radius: var(--radius-2xl);
  background: var(--white);
  box-shadow: 0 16rpx 48rpx rgba(45, 90, 123, 0.28);
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: savedPop 350ms var(--ease-bounce);
  border: 2rpx solid rgba(255,255,255,0.9);
}

@keyframes savedPop {
  from { opacity: 0; transform: scale(0.92); }
  to { opacity: 1; transform: scale(1); }
}

.saved-check {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(91, 143, 185, 0.4);
}

.saved-check image { width: 48rpx; height: 48rpx; }

.saved-title {
  margin-top: 24rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  font-family: var(--serif);
  letter-spacing: 1rpx;
}

.saved-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
  letter-spacing: 0.3rpx;
}

.saved-actions {
  width: 100%;
  display: flex;
  gap: 16rpx;
  margin-top: 36rpx;
}

.saved-btn {
  flex: 1;
  min-height: 88rpx;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  transition: transform 150ms var(--ease-standard);
  letter-spacing: 0.5rpx;
}

.saved-btn:active { transform: scale(0.97); }
.saved-btn.ghost { background: var(--brand-tint); color: var(--brand); border: 2rpx solid var(--brand); }
.saved-btn.primary {
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
  color: var(--white);
  box-shadow: var(--shadow-btn);
}

.saved-later {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  color: var(--ink-faint);
  font-size: 28rpx;
  letter-spacing: 0.5rpx;
}

.bottom-spacer { height: 24rpx; }
