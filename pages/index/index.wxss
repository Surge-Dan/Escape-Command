/* ===== 出逃方式弹窗（同频骰子入口选择弹层）===== */
/* 弹窗遮罩：fixed 全屏 */
.dice-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(45, 90, 123, 0.5);
  z-index: 1000;
  pointer-events: auto;
  animation: maskIn 200ms ease-out;
}

@keyframes maskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 弹层用 fixed 定位，确保相对视口 */
/* v16: TabBar 弹出时已隐藏，弹窗直接贴底，只需避让安全区 */
.dice-sheet-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: calc(100vh - 80rpx);
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 32rpx calc(40rpx + env(safe-area-inset-bottom, 34rpx));
  box-shadow: 0 -8rpx 32rpx rgba(45, 90, 123, 0.15);
  animation: sheetUp 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  box-sizing: border-box;
  z-index: 1001;
}

@keyframes sheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.dice-sheet-handle {
  width: 56rpx;
  height: 6rpx;
  background: #D4E8F5;
  border-radius: 3rpx;
  margin: 0 auto 24rpx;
}

.dice-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid #E8F4FC;
}

.dice-sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D5A7B;
  letter-spacing: 0.5rpx;
}

.dice-sheet-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #9BB8CC;
  border-radius: 50%;
  background: #F0F7FC;
  transition: all 200ms ease;
}

.dice-sheet-close:active {
  transform: scale(0.92);
  background: #D4E8F5;
}

.dice-sheet-option {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 16rpx;
  margin-top: 8rpx;
  border-radius: 16rpx;
  border-bottom: 1rpx solid #F0F7FC;
  transition: background 180ms ease;
}

.dice-sheet-option:last-of-type {
  border-bottom: none;
}

.dice-sheet-option:active {
  background: #F0F7FC;
}

.dice-sheet-option-highlight {
  position: relative;
  background: linear-gradient(135deg, rgba(91, 143, 185, 0.06), rgba(92, 191, 158, 0.04));
  border-radius: 20rpx;
  margin: 8rpx 0;
  border: 1rpx solid rgba(91, 143, 185, 0.12);
}

.dice-sheet-option-highlight:active {
  background: linear-gradient(135deg, rgba(91, 143, 185, 0.12), rgba(92, 191, 158, 0.08));
}

.dice-option-icon {
  font-size: 48rpx;
  line-height: 1;
  flex-shrink: 0;
}

.dice-option-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.dice-option-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D5A7B;
  letter-spacing: 0.5rpx;
}

.dice-option-desc {
  font-size: 24rpx;
  color: #7BAFD4;
  line-height: 1.4;
}

.dice-option-arrow {
  font-size: 32rpx;
  font-weight: 700;
  color: #9BB8CC;
  flex-shrink: 0;
  line-height: 1;
}

.dice-sheet-cancel {
  margin-top: 16rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F0F7FC;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #5B8FB9;
  font-weight: 600;
}

.dice-sheet-cancel:active {
  background: #D4E8F5;
}
