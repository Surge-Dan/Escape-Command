.profile-page { min-height: 100vh; background: var(--bg-gradient); }

.scroll-area { height: calc(100vh - var(--safe-bottom, 0px)); }

.body { padding: 0 32rpx 40rpx; }

/* 头部 */
.header-section { padding: 24rpx 0 32rpx; }
.header-title { display: block; font-size: 36rpx; font-weight: 600; color: var(--ink); line-height: 1.4; margin-bottom: 12rpx; font-family: var(--serif); }
.header-desc { display: block; font-size: 28rpx; color: var(--ink-soft); line-height: 1.5; }

/* 问题卡片 */
.question-card {
  background: var(--white);
  border-radius: var(--radius-xl);
  border: var(--border);
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}
.question-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 20rpx;
  font-family: var(--serif);
}
.option-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.option-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 28rpx;
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  color: var(--ink-soft);
  background: var(--canvas);
  border: 2rpx solid transparent;
  transition: all 200ms var(--ease-standard);
}
.option-pill.active {
  color: var(--brand-dark);
  background: var(--brand-tint);
  border-color: var(--brand);
}
.option-pill.multi.active {
  color: var(--brand-dark);
  background: var(--brand-tint);
  border-color: var(--brand);
}

/* 底部按钮 */
.bottom-area { padding: 20rpx 32rpx calc(48rpx + var(--safe-bottom)); }
.save-btn {
  width: 100%;
  height: 96rpx;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
  color: var(--white);
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: var(--shadow-btn);
  transition: transform 150ms var(--ease-standard);
}
.save-btn:active { transform: scale(0.97); }
.save-btn.disabled {
  background: var(--line);
  color: var(--ink-faint);
  box-shadow: none;
}
