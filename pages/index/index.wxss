  transition: all 200ms ease;
}

.cmd-close:active {
  transform: scale(0.92);
  background: #D4E8F5;
}

.cmd-close image {
  width: 32rpx;
  height: 32rpx;
}

.favorite-toggle {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  z-index: 5;
