.profile-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  /* v11: 背景使用主题变量，切换主题时自动跟随 */
  background: var(--bg-gradient);
}

.status-bar { flex-shrink: 0; background: transparent; }
.profile-page .nav-header {
  flex-shrink: 0;
  background: transparent;
  border-bottom: none;
}

.profile-scroll {
  flex: 1;
  height: 0;
}

.profile-body {
  padding: 40rpx 40rpx 0;
}

/* ===== 用户信息卡 ===== */
.profile-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.45);
  border-radius: 28rpx;
  border: var(--border);
  box-shadow: none;
  margin-bottom: 36rpx;
}

.avatar-wrap {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(200, 149, 110, 0.25);
  box-shadow: var(--shadow-card);
  background: var(--brand-tint);
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.user-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
  padding-right: 96rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-code {
  font-size: 24rpx;
  color: var(--ink-faint);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* v6: 编辑按钮 56rpx 圆形，绝对定位右上 */
.edit-btn {
  position: absolute;
  right: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-tint);
  flex-shrink: 0;
  transition: transform 150ms var(--ease-standard);
}

.edit-btn:active { transform: translateY(-50%) scale(0.92); }

.ico-pencil {
  width: 28rpx;
  height: 28rpx;
}

/* ===== 会员卡：统一白色卡片风格，与统计卡一致 ===== */
.member-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: var(--white);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
  margin-bottom: 32rpx;
  transition: transform 200ms var(--ease-standard);
}

.member-card:active { transform: scale(0.98); }

.member-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.member-icon {
  width: 72rpx;
  height: 72rpx;
}

.member-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.member-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.member-sub {
  font-size: 24rpx;
  color: var(--ink-faint);
}

.member-cta {
  padding: 12rpx 28rpx;
  background: var(--canvas);
  color: var(--ink-soft);
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  font-weight: 500;
  flex-shrink: 0;
}

/* ===== 数据统计：4 列 ===== */
.stats-card {
  background: var(--white);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
  padding: 32rpx 20rpx;
  margin-bottom: 40rpx;
  display: flex;
  justify-content: space-around;
}

.stats-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  flex: 1;
}

.stats-num-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.stats-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.1;
  letter-spacing: 1rpx;
}

.stats-unit {
  font-size: 20rpx;
  color: var(--ink-soft);
}

.stats-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-faint);
}

/* ===== 5 分类卡片：统一白色干净风格，去掉五颜六色 ===== */
.categories-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 40rpx;
}

.category-card {
  position: relative;
  background: var(--white);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
  transition: transform 200ms var(--ease-standard);
}

.category-card:active { transform: scale(0.99); }

.category-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx 20rpx;
}

.category-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--canvas);
}

.category-icon {
  width: 44rpx;
  height: 44rpx;
}

.category-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.category-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.3;
  letter-spacing: 0.5rpx;
}
.category-sub {
  font-size: 24rpx;
  color: var(--ink-faint);
  line-height: 1.4;
}

.category-items {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  padding: 8rpx 24rpx 28rpx;
}

.cat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  border-radius: var(--radius-md);
  transition: all 200ms var(--ease-standard);
  gap: 12rpx;
}
.cat-item:active {
  background: var(--canvas);
  transform: scale(0.95);
}

.cat-item-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--canvas);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 200ms var(--ease-standard);
}
.cat-item:active .cat-item-icon-wrap {
  background: rgba(46, 47, 51, 0.08);
}
.cat-item-icon {
  width: 40rpx;
  height: 40rpx;
}

.cat-item-label {
  font-size: 22rpx;
  color: var(--ink-soft);
  text-align: center;
  line-height: 1.3;
  letter-spacing: 0.5rpx;
}

.bottom-spacer {
  height: calc(var(--tabbar-floating-height) + var(--tabbar-bottom-gap) + var(--safe-bottom));
}

.tabbar-placeholder {
  height: calc(var(--tabbar-floating-height) + var(--tabbar-bottom-gap) + var(--safe-bottom));
}
