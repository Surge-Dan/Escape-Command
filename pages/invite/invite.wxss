.status-bar { flex-shrink: 0; }

.page-scroll {
  padding: 0 40rpx;
  box-sizing: border-box;
}

/* ===== Hero ===== */
.invite-hero {
  padding: 24rpx 8rpx 32rpx;
  background: linear-gradient(135deg, var(--accent-tint) 0%, var(--brand-tint) 100%);
  border-radius: var(--radius-xl);
  margin: 24rpx 0 28rpx;
  text-align: center;
  box-shadow: var(--shadow-card);
}

.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.hero-sub {
  display: block;
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-top: 12rpx;
  line-height: 1.5;
  padding: 0 24rpx;
}

/* ===== Polaroid 邀请卡 ===== */
.polaroid {
  background: var(--white);
  border-radius: var(--radius-xl);
  padding: 24rpx;
  box-shadow: var(--shadow-elevated);
  margin-bottom: 28rpx;
  transform: rotate(-1.2deg);
}

.polaroid-inner {
  background: var(--canvas);
  border-radius: var(--radius-lg);
  padding: 32rpx 28rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.polaroid-head {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.polaroid-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.polaroid-code {
  font-size: 22rpx;
  color: var(--ink-faint);
  margin-top: 8rpx;
}

.polaroid-command {
  width: 100%;
  background: var(--white);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  border: var(--border);
}

.command-label {
  display: block;
  font-size: 20rpx;
  color: var(--brand-dark);
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.command-text {
  display: block;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.5;
}

.qr-mini {
  width: 240rpx;
  height: 240rpx;
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  grid-template-rows: repeat(12, 1fr);
  gap: 2rpx;
  background: var(--white);
  padding: 12rpx;
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--ink);
}

.qr-mini-cell {
  background: transparent;
}

.qr-mini-cell.on {
  background: var(--ink);
}

.polaroid-footer {
  display: block;
  font-size: 22rpx;
  color: var(--ink-soft);
  margin-top: 20rpx;
  letter-spacing: 1rpx;
}

/* ===== 分享方式行 ===== */
.share-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.share-method {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  background: var(--white);
  border-radius: var(--radius-lg);
  border: var(--border);
  box-shadow: var(--shadow-card);
  transition: transform 150ms var(--ease-standard), background 150ms var(--ease-standard);
  min-height: 140rpx;
}

.share-method:active {
  transform: scale(0.97);
  background: var(--brand-weak);
}

.share-method::after { border: 0; }

.share-ico {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 12rpx;
}

.share-label {
  font-size: 24rpx;
  color: var(--ink);
  font-weight: 500;
}

/* ===== 统计卡片 ===== */
.stats-card {
  display: flex;
  align-items: center;
  background: var(--white);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
  padding: 28rpx 0;
  margin-bottom: 28rpx;
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--brand-dark);
  font-family: "SF Mono", "Menlo", "Consolas", monospace;
}

.stat-label {
  font-size: 22rpx;
  color: var(--ink-soft);
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: var(--line);
}

/* ===== 二维码区 ===== */
.qr-section {
  margin-bottom: 28rpx;
}

.section-label {
  display: block;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--ink-faint);
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
}

.qr-card {
  background: var(--white);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-grid {
  width: 360rpx;
  height: 360rpx;
  display: grid;
  grid-template-columns: repeat(21, 1fr);
  grid-template-rows: repeat(21, 1fr);
  gap: 1rpx;
  background: var(--white);
  padding: 12rpx;
  border: 2rpx solid var(--ink);
  border-radius: var(--radius-sm);
}

.qr-cell {
  background: transparent;
}

.qr-cell.on {
  background: var(--ink);
}

.qr-code-display {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  margin-top: 24rpx;
  letter-spacing: 2rpx;
}

.qr-tip {
  display: block;
  font-size: 22rpx;
  color: var(--ink-faint);
  margin-top: 8rpx;
}

/* ===== 规则区 ===== */
.rules-section {
  margin-bottom: 28rpx;
}

.rules-card {
  background: var(--white);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
  padding: 8rpx 28rpx;
}

.rule-row {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.rule-row:last-child {
  border-bottom: none;
}

.rule-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--brand-tint);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.rule-num-text {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--brand-dark);
}

.rule-text {
  flex: 1;
}

.rule-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.rule-desc {
  display: block;
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.6;
}

.bottom-spacer { height: 64rpx; }
