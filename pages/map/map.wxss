/* v4 重构：地图类型扩展为 3 类（普通 / 卫星 / 路线）；圆角统一收紧；定位按钮加 :active 反馈 */
.map-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  /* v9: 顶部暖色渐变，与全局统一 */
  background: linear-gradient(180deg, #FFF0E4 0%, #FFF6F0 18%, #F5F3EF 55%, #F5F3EF 100%);
}

.status-bar { flex-shrink: 0; background: transparent; }
.map-page .nav-header {
  background: transparent;
  border-bottom: none;
}

/* ===== 简洁主题区：v10 标题与城市 pill 左右排列 ===== */
.map-theme {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  padding: 32rpx 24rpx 32rpx 40rpx;
  background: transparent;
}

.map-theme-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.map-theme-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
}

.map-theme-sub {
  display: block;
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.4;
}

/* ===== 城市入口 pill（v10 下放到主题区右侧；v11 紧贴右边缘） ===== */
.map-city-pill {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 100rpx;
  background: var(--canvas);
  border: 2rpx solid var(--line);
  gap: 8rpx;
  margin-left: auto;
  transition: transform 150ms var(--ease-standard);
}

.map-city-pill:active {
  transform: scale(0.96);
  background: var(--brand-tint);
}

.city-ico {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

.city-name {
  font-size: 24rpx;
  color: var(--ink);
  font-weight: 500;
  max-width: 200rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.city-arrow {
  width: 20rpx;
  height: 20rpx;
  flex-shrink: 0;
}

/* ===== 原生地图 ===== */
.map-native {
  width: 100%;
  flex-shrink: 0;
}

/* ===== 悬浮控件（cover-view，有限 CSS） ===== */

.map-controls {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  flex-direction: column;
  background-color: rgba(255, 255, 255, 0.96);
  border-radius: 24rpx;
  padding: 16rpx;
  border-width: 2rpx;
  border-style: solid;
  border-color: var(--line);
  box-shadow: var(--shadow-elevated);
}

.map-tabs {
  display: flex;
  flex-direction: row;
  background-color: var(--canvas);
  border-radius: var(--radius-md);
  padding: 4rpx;
}

.map-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: var(--radius-sm);
}

.map-tab-text {
  font-size: 26rpx;
  color: var(--ink-soft);
  text-align: center;
}

.map-tab.active {
  background-color: var(--brand);
}

.map-tab.active .map-tab-text {
  color: var(--white);
  font-weight: 600;
}

.time-chips {
  display: flex;
  flex-direction: row;
  margin-top: 12rpx;
}

.time-chip {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  margin-right: 12rpx;
  border-radius: var(--radius-pill);
  background-color: var(--white);
  border-width: 2rpx;
  border-style: solid;
  border-color: var(--line);
}

.time-chip-text {
  font-size: 24rpx;
  color: var(--ink-soft);
  text-align: center;
}

.time-chip.active {
  background-color: var(--ink);
  border-color: var(--ink);
}

.time-chip.active .time-chip-text {
  color: var(--white);
}

/* v4: 定位按钮 —— 圆形 88rpx，移到右下角，:active 加深阴影 */
.map-locate-btn {
  position: absolute;
  right: 24rpx;
  bottom: calc(var(--page-pad-bottom) + 148rpx);
  width: 88rpx;
  height: 88rpx;
  background-color: var(--white);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border-width: 2rpx;
  border-style: solid;
  border-color: var(--line);
  box-shadow: 0 4rpx 16rpx rgba(46, 47, 51, 0.14);
  transition: transform 200ms var(--ease-standard), box-shadow 200ms var(--ease-standard);
  z-index: 101;
}

.map-locate-btn:active {
  transform: scale(0.92);
  background-color: var(--brand-tint);
  box-shadow: 0 2rpx 8rpx rgba(46, 47, 51, 0.18);
}

/* v13: 定位图标用 cover-view + CSS 绘制，真机 100% 可见 */
.locate-icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
}

.locate-ring {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border-width: 4rpx;
  border-style: solid;
  border-color: var(--brand);
  background-color: transparent;
}

.locate-center {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: var(--brand);
}

/* v13: 加号图标用 cover-view + CSS 绘制 */
.plus-icon {
  position: relative;
  width: 40rpx;
  height: 40rpx;
}

.plus-h {
  position: absolute;
  top: 18rpx;
  left: 0;
  width: 40rpx;
  height: 4rpx;
  background-color: #E07A5F;
  border-radius: 2rpx;
}

.plus-v {
  position: absolute;
  left: 18rpx;
  top: 0;
  width: 4rpx;
  height: 40rpx;
  background-color: #E07A5F;
  border-radius: 2rpx;
}

/* v12: 添加/编辑出发点按钮 —— 使用品牌色 + 图标 */
.map-home-btn {
  position: absolute;
  right: 24rpx;
  bottom: calc(var(--page-pad-bottom) + 252rpx);
  width: 88rpx;
  height: 88rpx;
  background-color: var(--white);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border-width: 2rpx;
  border-style: solid;
  border-color: var(--line);
  box-shadow: 0 4rpx 16rpx rgba(46, 47, 51, 0.14);
  transition: transform 200ms var(--ease-standard), box-shadow 200ms var(--ease-standard);
}

.map-home-btn:active {
  transform: scale(0.92);
  background-color: var(--brand-tint);
  box-shadow: 0 2rpx 8rpx rgba(46, 47, 51, 0.18);
}

/* v13: home-ico 已由 .plus-icon 替代，此样式保留兼容 */

/* 底部统计条：悬浮胶囊卡片，与自定义 TabBar 风格一致 */
.map-stats-bar {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(var(--page-pad-bottom) + 16rpx);
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(122, 78, 43, 0.08);
  border-radius: 32rpx;
  padding: 20rpx 32rpx;
  box-shadow: 0 8rpx 40rpx rgba(46, 47, 51, 0.12);
  backdrop-filter: blur(20rpx);
  z-index: 100;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.1;
  letter-spacing: 1rpx;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-faint);
}

/* 空状态 */
.map-empty {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.94);
  border-radius: var(--radius-lg);
  padding: 40rpx 56rpx;
  border-width: 2rpx;
  border-style: solid;
  border-color: var(--line);
}

.empty-illust {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 8rpx;
  text-align: center;
}

.empty-sub {
  font-size: 24rpx;
  color: var(--ink-soft);
  text-align: center;
}

.empty-cta {
  margin-top: 28rpx;
  padding: 18rpx 56rpx;
  background-color: var(--brand);
  color: var(--white);
  font-size: 28rpx;
  font-weight: 600;
  border-radius: var(--radius-md);
  text-align: center;
}

/* 标记弹窗 */
.map-popup {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 200rpx;
  background-color: var(--white);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  border-width: 2rpx;
  border-style: solid;
  border-color: var(--line);
}

.popup-inner {
  display: flex;
  flex-direction: column;
}

.popup-type {
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.popup-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.popup-date {
  font-size: 24rpx;
  color: var(--ink-soft);
}

/* ===== B4-B: 重返此地按钮 ===== */
.popup-revisit-btn {
  margin-top: 16rpx;
  padding: 12rpx 24rpx;
  background: #5CBF9E;
  border-radius: 32rpx;
  align-self: flex-start;
}

.popup-revisit-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1;
}

/* ===== B4-B: 情绪筛选切换 ===== */
.mood-toggle {
  background: rgba(255, 255, 255, 0.7);
}

.mood-toggle.active {
  background: #5CBF9E;
}

/* ===== B4-B: 城市关系总结条 ===== */
.map-summary-bar {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 180rpx;
  padding: 16rpx 24rpx;
  background: rgba(46, 47, 51, 0.78);
  border-radius: 16rpx;
  backdrop-filter: blur(8rpx);
}

.summary-text {
  font-size: 24rpx;
  color: #FFFFFF;
  line-height: 1.5;
  text-align: center;
}

/* ===== B4-B: 重返此地确认弹窗 ===== */
.revisit-modal {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.revisit-card {
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.revisit-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.revisit-subtitle {
  font-size: 26rpx;
  color: var(--ink-soft);
  line-height: 1.6;
  text-align: center;
  margin-bottom: 32rpx;
}

.revisit-actions {
  display: flex;
  gap: 24rpx;
  width: 100%;
}

.revisit-cancel {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  background: #F5F3EF;
  font-size: 28rpx;
  color: var(--ink-soft);
}

.revisit-confirm {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  background: #5CBF9E;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* ===== TabBar 占位 ===== */
.tabbar-placeholder {
  height: calc(var(--tabbar-floating-height) + var(--tabbar-bottom-gap) + var(--safe-bottom));
  flex-shrink: 0;
}
