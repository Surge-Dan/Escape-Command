/* ===== 路线回顾页 ===== */
.page-scroll { padding: 0; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 80rpx;
  text-align: center;
}
.empty-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--canvas);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}
.empty-circle image { width: 64rpx; height: 64rpx; }
.empty-title { font-size: 36rpx; font-weight: 700; color: var(--ink); margin-bottom: 16rpx; }
.empty-sub { font-size: 26rpx; color: var(--ink-soft); line-height: 1.5; margin-bottom: 48rpx; }
.empty-back { padding: 0 48rpx; }

.route-body { padding: 24rpx 40rpx 0; }

/* ===== 路线地图卡 ===== */
.map-card {
  background: var(--white);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
  padding: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}
.map-canvas {
  position: relative;
  width: 100%;
  height: 500rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, #F8F6F1 0%, #F1ECE3 100%);
  overflow: hidden;
}

/* 网格线：模拟地图路网 */
.grid-layer { position: absolute; inset: 0; pointer-events: none; }
.grid-line-h {
  position: absolute;
  left: 0;
  right: 0;
  height: 1rpx;
  background: rgba(122, 78, 43, 0.07);
}
.grid-line-v {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 1rpx;
  background: rgba(122, 78, 43, 0.07);
}

/* 水印 */
.map-watermark {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  display: flex;
  flex-direction: column;
  z-index: 1;
}
.wm-city {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 1rpx;
}
.wm-date {
  font-size: 20rpx;
  color: var(--ink-faint);
  margin-top: 4rpx;
}

/* 路线连线（虚线） */
.route-line {
  position: absolute;
  height: 0;
  border-top: 4rpx dashed rgba(200, 149, 110, 0.55);
  transform-origin: 0 50%;
  z-index: 2;
  pointer-events: none;
}

/* 路点 */
.waypoint {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(46, 47, 51, 0.15);
  z-index: 3;
}
.waypoint.wp-start,
.waypoint.wp-end {
  width: 48rpx;
  height: 48rpx;
  box-shadow: 0 6rpx 18rpx rgba(46, 47, 51, 0.2);
}
.wp-label {
  color: var(--white);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}
.wp-pulse {
  position: absolute;
  inset: -8rpx;
  border-radius: 50%;
  opacity: 0.25;
}

/* 图例 */
.map-legend {
  position: absolute;
  bottom: 20rpx;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  gap: 24rpx;
  z-index: 4;
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 14rpx;
  background: rgba(255, 255, 255, 0.78);
  border-radius: var(--radius-pill);
  backdrop-filter: blur(8px);
}
.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}
.legend-text {
  font-size: 20rpx;
  color: var(--ink-soft);
}

/* ===== 通用 Section Card ===== */
.section-card {
  background: var(--white);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}
.section-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.section-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.section-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 2rpx;
}

/* ===== 时间轴 ===== */
.timeline {
  padding-left: 4rpx;
}
.tl-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  min-height: 96rpx;
}
.tl-marker {
  position: relative;
  width: 24rpx;
  display: flex;
  justify-content: center;
  padding-top: 6rpx;
  flex-shrink: 0;
}
.tl-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 4rpx solid var(--white);
  box-shadow: 0 0 0 2rpx rgba(122, 78, 43, 0.1);
  z-index: 2;
}
.tl-tail {
  position: absolute;
  top: 30rpx;
  bottom: -64rpx;
  left: 50%;
  width: 2rpx;
  background: rgba(122, 78, 43, 0.1);
  transform: translateX(-50%);
}
.tl-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-bottom: 28rpx;
}
.tl-item:last-child .tl-content { padding-bottom: 0; }
.tl-time {
  font-size: 22rpx;
  color: var(--ink-faint);
  margin-bottom: 4rpx;
}
.tl-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
}
.tl-sub {
  font-size: 22rpx;
  color: var(--ink-soft);
  margin-top: 4rpx;
}

/* ===== 路线统计 ===== */
.stats-grid {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}
.stats-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 4rpx;
}
.stats-num-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-bottom: 8rpx;
}
.stats-value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1;
}
.stats-unit {
  font-size: 22rpx;
  color: var(--ink-faint);
}
.stats-label {
  font-size: 22rpx;
  color: var(--ink-soft);
}

/* ===== 详情按钮 ===== */
.detail-btn {
  width: 100%;
  margin-top: 8rpx;
}
.detail-btn:active { transform: scale(0.97); }

.bottom-spacer { height: 80rpx; }
