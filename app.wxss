/* ===== 出逃指令 v3.0 全局设计系统 · 浅雾蓝主题 ===== */
/* 设计基准：pages/index/index（首页已锁定，以下Token全部从首页精确提取） */

page {
  /* ===== 品牌主色 ===== */
  --brand: #5B8FB9;
  --brand-dark: #4A7A9E;
  --brand-strong: #4A7A9E;
  --brand-tint: #E8F4FC;
  --brand-weak: #F0F7FC;
  --brand-light: #7BAFD4;
  --brand-pill: #C9F0FA;

  /* ===== 画布与文字 ===== */
  --canvas: #E8F4FC;
  --canvas-soft: #F0F7FC;
  --white: #FFFFFF;
  --ink: #2D5A7B;
  --ink-soft: #5B8FB9;
  --ink-faint: #8BB0CC;

  /* ===== 线条、边框、阴影 ===== */
  --line: rgba(91, 143, 185, 0.10);
  --border-soft: rgba(91, 143, 185, 0.12);
  --shadow-card: 0 4rpx 16rpx rgba(91, 143, 185, 0.06);
  --shadow-elevated: 0 4rpx 20rpx rgba(91, 143, 185, 0.08);
  --shadow-popup: 0 -8rpx 32rpx rgba(45, 90, 123, 0.15);
  --shadow-float: 0 8rpx 24rpx rgba(91, 143, 185, 0.12);
  --shadow-btn: 0 8rpx 24rpx rgba(91, 143, 185, 0.35);
  --shadow-dice: 0 20rpx 44rpx rgba(45, 90, 123, 0.32);
  --border: 2rpx solid rgba(91, 143, 185, 0.12);

  /* ===== 语义色（红/紫/绿仅作品牌骰子/状态强调色，禁止大面积使用） ===== */
  --accent: #5CBF9E;
  --accent-tint: rgba(92, 191, 158, 0.12);
  --danger: #E05555;
  --danger-tint: rgba(224, 85, 85, 0.12);
  --warning: #E8A752;
  --warning-tint: rgba(232, 167, 82, 0.15);
  --success: #5CBF9E;
  --heal-tint: rgba(92, 191, 158, 0.10);
  --gold: #D4A056;
  --gold-tint: #FFF4D6;
  --lemon-tint: #FFF4C7;
  --sun: #FFD36B;
  --dice-micro: #7BAE7F;
  --dice-sync: #5CBF9E;
  --dice-breakthrough: #9B7BB8;
  --dice-red: #D05050;
  --dice-purple: #9B7BB8;
  --dice-green: #5CBF9E;

  /* ===== 场景/类型色（保持原有语义，但以蓝色为主轴） ===== */
  --cloud: #9AA8BA;
  --rain: #7EC8F5;
  --night: #9B8EC4;
  --type-color: #5B8FB9;
  --type-walk: #5B8FB9;
  --type-sense: #9B7BB8;
  --type-collect: #D4A056;
  --type-food: #D98A5C;
  --type-culture: #5CBF9E;

  /* ===== 圆角等级 ===== */
  --radius-xs: 8rpx;
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 20rpx;
  --radius-xl: 24rpx;
  --radius-2xl: 32rpx;
  --radius-pill: 100rpx;

  /* ===== 字体 ===== */
  --serif: 'SourceHanSerifBold', 'SourceHanSerif', "Source Han Serif SC", "Noto Serif SC", "Songti SC", "STSong", "SimSun", "FangSong", serif;
  --sans: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  --ink-italic: #5B8FB9;

  /* ===== 动效 ===== */
  --ease-standard: cubic-bezier(0.25, 0.1, 0.25, 1.0);
  --ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1.0);
  --ease-out: cubic-bezier(0.0, 0.0, 0.2, 1.0);
  --dur-fast: 180ms;
  --dur-base: 260ms;

  /* ===== 安全区 ===== */
  --safe-top: env(safe-area-inset-top, 0px);
  --safe-bottom: env(safe-area-inset-bottom, 0px);
  --tabbar-floating-height: 100rpx;
  --tabbar-bottom-gap: 20rpx;
  --page-pad-top: calc(var(--safe-top) + 24rpx);
  --page-pad-bottom: calc(var(--tabbar-floating-height) + var(--tabbar-bottom-gap) + var(--safe-bottom) + 24rpx);

  /* ===== 页面背景 ===== */
  --bg-gradient: linear-gradient(180deg, #E8F4FC 0%, #E8F4FC 100%);

  background: var(--bg-gradient);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: var(--sans);
  -webkit-font-smoothing: antialiased;
}

view, text, button, input, textarea, scroll-view, image {
  box-sizing: border-box;
}

/* ===== 主题切换：保留主题机制，但覆盖为蓝色基调的变体 ===== */

/* 深夜墨蓝主题 */
.theme-dark {
  --canvas: #152331;
  --canvas-soft: #1D3042;
  --white: #1D3042;
  --ink: #E8F0F7;
  --ink-soft: #9BB8CC;
  --ink-faint: #6888A3;
  --brand-tint: #1A3146;
  --brand-weak: #152331;
  --line: rgba(255, 255, 255, 0.08);
  --border-soft: rgba(255, 255, 255, 0.08);
  --shadow-card: 0 2rpx 16rpx rgba(0, 0, 0, 0.25);
  --shadow-elevated: 0 4rpx 24rpx rgba(0, 0, 0, 0.32);
  --shadow-popup: 0 -8rpx 32rpx rgba(0, 0, 0, 0.40);
  --shadow-float: 0 8rpx 24rpx rgba(0, 0, 0, 0.30);
  --border: 2rpx solid rgba(255, 255, 255, 0.08);
  --bg-gradient: linear-gradient(180deg, #0F1C28 0%, #152331 100%);
  background: var(--bg-gradient);
  color: var(--ink);
}

/* 黄昏粉蓝主题（原暖橙的温柔替代） */
.theme-warm-orange {
  --canvas: #F5F0F8;
  --brand: #9B7BB8;
  --brand-dark: #7B5B98;
  --brand-strong: #7B5B98;
  --brand-tint: #E8DFF5;
  --brand-weak: #F2EAF8;
  --brand-light: #B095C8;
  --brand-pill: #E8DFF5;
  --accent: #B095C8;
  --accent-tint: #EFE5F7;
  --bg-gradient: linear-gradient(180deg, #F0E8F7 0%, #F5F0F8 100%);
  background: var(--bg-gradient);
  color: var(--ink);
}

/* 薰衣草夜主题保留 */
.theme-lavender {
  --canvas: #F0F0FA;
  --brand: #7B8CC8;
  --brand-dark: #5C6EA8;
  --brand-strong: #5C6EA8;
  --brand-tint: #E0E3F7;
  --brand-weak: #EAEDFB;
  --brand-light: #9BAAE0;
  --brand-pill: #E0E3F7;
  --bg-gradient: linear-gradient(180deg, #E5E8F7 0%, #F0F0FA 100%);
  background: var(--bg-gradient);
  color: var(--ink);
}

/* ===== 基础重置 ===== */
button {
  padding: 0;
  margin: 0;
  border: 0;
  background: transparent;
  line-height: 1.5;
}
button::after { border: 0; }

input, textarea {
  font-family: var(--sans);
}

/* ===== 页面容器 ===== */
.page-container {
  min-height: 100vh;
  background: var(--bg-gradient);
}

/* ===== 卡片公共类 ===== */
.solid-card {
  background: var(--white);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
}

.glass-card {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(24px) saturate(1.5);
  -webkit-backdrop-filter: blur(24px) saturate(1.5);
  border: var(--border);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-card);
}

.soft-card {
  background: linear-gradient(135deg, #EAF4FB 0%, #FFFFFF 100%);
  border-radius: var(--radius-lg);
  border: 1rpx solid rgba(91, 143, 185, 0.10);
  box-shadow: var(--shadow-card);
}

/* ===== 按钮 ===== */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 48rpx;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-light) 100%);
  color: var(--white);
  border-radius: var(--radius-md);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: var(--shadow-btn);
  transition: all var(--dur-fast) var(--ease-standard);
  border: none;
}
.btn-primary::after { border: none; }
.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 48rpx;
  background: var(--brand-weak);
  color: var(--brand);
  border-radius: var(--radius-md);
  font-size: 30rpx;
  font-weight: 600;
  transition: all var(--dur-fast) var(--ease-standard);
}
.btn-secondary::after { border: none; }
.btn-secondary:active {
  background: var(--brand-tint);
  transform: scale(0.98);
}

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 48rpx;
  background: transparent;
  color: var(--brand);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 500;
  transition: all var(--dur-fast) ease;
}
.btn-ghost:active {
  background: var(--brand-weak);
}

.btn-text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
  background: transparent;
  color: var(--brand);
  font-size: 26rpx;
  font-weight: 500;
}
.btn-text:active { opacity: 0.6; }

/* 药丸按钮（全圆角） */
.btn-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 36rpx;
  background: var(--brand);
  color: var(--white);
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: 600;
  transition: all var(--dur-fast) ease;
}
.btn-pill:active { transform: scale(0.96); opacity: 0.9; }

.btn-pill-soft {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 36rpx;
  background: var(--brand-weak);
  color: var(--brand);
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: 600;
  transition: all var(--dur-fast) ease;
}
.btn-pill-soft:active { background: var(--brand-tint); transform: scale(0.96); }

/* ===== 文字层级 ===== */
.h1 { font-size: 44rpx; font-weight: 700; line-height: 1.25; color: var(--ink); font-family: var(--serif); }
.h2 { font-size: 36rpx; font-weight: 700; line-height: 1.3; color: var(--ink); }
.h3 { font-size: 32rpx; font-weight: 600; line-height: 1.4; color: var(--ink); }
.h4 { font-size: 30rpx; font-weight: 600; line-height: 1.4; color: var(--ink); }
.body-text { font-size: 28rpx; font-weight: 400; line-height: 1.6; color: var(--ink-soft); }
.caption-text { font-size: 24rpx; font-weight: 400; line-height: 1.5; color: var(--ink-faint); }
.small-text { font-size: 22rpx; font-weight: 400; line-height: 1.4; color: var(--ink-faint); }
.num-display, .font-mono {
  font-family: "SF Mono", "Menlo", "Consolas", monospace;
  font-variant-numeric: tabular-nums;
}
.meta-text { font-size: 22rpx; color: var(--ink-faint); }
.sub-text { font-size: 24rpx; color: var(--ink-soft); }

/* 主标题（编辑感衬线） */
.title-serif {
  font-family: var(--serif);
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 4rpx;
}

/* ===== TabBar / 底部占位 ===== */
.tabbar-placeholder {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

.bottom-spacer {
  height: calc(140rpx + env(safe-area-inset-bottom));
}

/* ===== 通用装饰 ===== */
.dot-sep {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--ink-faint);
  opacity: 0.5;
}

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 0;
}

/* 点击缩放反馈 */
.tap-feedback {
  transition: transform 150ms var(--ease-standard);
}
.tap-feedback:active {
  transform: scale(0.97);
}

/* 文本截断 */
.ellipsis-1 {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 居中flex */
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}
.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ===== 标签/胶囊Chip ===== */
.chip {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-xs);
  font-size: 22rpx;
  font-weight: 600;
  background: var(--brand-weak);
  color: var(--brand);
}
.chip-pill {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  background: var(--brand-weak);
  color: var(--brand);
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}
.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}
.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 8rpx;
}
.empty-desc {
  font-size: 24rpx;
  color: var(--ink-faint);
  text-align: center;
  line-height: 1.5;
  margin-bottom: 32rpx;
}

/* ===== 自定义导航栏（页面直接使用，无需组件） ===== */
.status-bar {
  background: transparent;
  flex-shrink: 0;
}

.nav-header {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  height: 80rpx;
  padding: 0 32rpx;
  background: transparent;
  position: relative;
  z-index: 10;
  margin-bottom: 16rpx;
}

.nav-header-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  left: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255,255,255,0.7);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  transition: all 200ms ease;
}
.nav-header-back:active {
  background: var(--brand-weak);
  transform: translateY(-50%) scale(0.92);
}
.nav-header-back image { width: 32rpx; height: 32rpx; }

.nav-header-title {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-family: var(--serif);
  letter-spacing: 2rpx;
}

.nav-header-right {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  flex-shrink: 0;
  height: 100%;
}

.nav-header-divider {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 1rpx;
  background: var(--line);
  z-index: 11;
}

/* ===== 区块标题 ===== */
.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  font-family: var(--serif);
  letter-spacing: 2rpx;
}
.section-sub {
  font-size: 24rpx;
  color: var(--ink-faint);
  font-weight: 400;
}
.section-more {
  font-size: 24rpx;
  color: var(--brand);
}

/* ===== 输入框 ===== */
.input-field {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 28rpx;
  background: var(--white);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--border-soft);
  font-size: 28rpx;
  color: var(--ink);
}
.input-field .input-label {
  font-size: 28rpx;
  color: var(--ink-soft);
  margin-right: 16rpx;
  flex-shrink: 0;
}
.input-field input,
.input-field .input-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}
.input-field .input-placeholder {
  color: var(--ink-faint);
}
.input-field .input-arrow {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.4;
  margin-left: 12rpx;
}

.textarea-field {
  width: 100%;
  padding: 24rpx;
  background: var(--white);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--border-soft);
  font-size: 28rpx;
  color: var(--ink);
  min-height: 200rpx;
  line-height: 1.6;
}

/* ===== 列表项（设置/帮助类分组列表） ===== */
.list-group {
  background: var(--white);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
  margin-bottom: 24rpx;
  overflow: hidden;
}
.list-group-title {
  padding: 24rpx 32rpx 8rpx;
  font-size: 22rpx;
  color: var(--ink-faint);
  font-weight: 500;
  letter-spacing: 1rpx;
}
.list-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--line);
  transition: background 150ms ease;
  min-height: 88rpx;
}
.list-item:last-child { border-bottom: none; }
.list-item:active { background: var(--brand-weak); }
.list-item-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-weak);
}
.list-item-icon image { width: 24rpx; height: 24rpx; }
.list-item-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.list-item-title {
  font-size: 30rpx;
  color: var(--ink);
  font-weight: 500;
}
.list-item-desc {
  font-size: 22rpx;
  color: var(--ink-faint);
}
.list-item-value {
  font-size: 26rpx;
  color: var(--ink-faint);
  flex-shrink: 0;
}
.list-item-arrow {
  width: 20rpx;
  height: 20rpx;
  opacity: 0.35;
  flex-shrink: 0;
}

/* ===== 底部面板（Bottom Sheet） ===== */
.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(45, 90, 123, 0.5);
  z-index: 1000;
  animation: maskIn var(--dur-base) var(--ease-out);
}
@keyframes maskIn { from { opacity: 0; } to { opacity: 1; } }

.sheet-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--white);
  border-radius: var(--radius-2xl) var(--radius-2xl) 0 0;
  padding: 16rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-shadow: var(--shadow-popup);
  animation: sheetUp 320ms var(--ease-bounce);
}
@keyframes sheetUp { from { transform: translateY(100%); } to { transform: translateY(0); } }

.sheet-handle {
  width: 56rpx;
  height: 6rpx;
  background: var(--brand-tint);
  border-radius: 3rpx;
  margin: 0 auto 24rpx;
}
.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid var(--line);
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 0.5rpx;
}
.sheet-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--ink-faint);
  border-radius: 50%;
  background: var(--brand-weak);
}
.sheet-close:active { background: var(--brand-tint); }
.sheet-cancel {
  margin-top: 16rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-weak);
  border-radius: var(--radius-md);
  font-size: 30rpx;
  color: var(--brand);
  font-weight: 600;
}
.sheet-cancel:active { background: var(--brand-tint); }

/* ===== 头像 ===== */
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--brand-tint);
  overflow: hidden;
  flex-shrink: 0;
}
.avatar image { width: 100%; height: 100%; }
.avatar-sm { width: 64rpx; height: 64rpx; }
.avatar-lg { width: 140rpx; height: 140rpx; border: 4rpx solid var(--white); box-shadow: var(--shadow-float); }

/* ===== 徽标/数字角标 ===== */
.badge-dot {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: var(--danger);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* ===== 加载 ===== */
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--brand-tint);
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ===== 渐隐入场动画（给页面内容用） */
.fade-in {
  animation: fadeIn 300ms var(--ease-out) both;
}
@keyframes fadeIn { from { opacity: 0; transform: translateY(12rpx); } to { opacity: 1; transform: none; } }
