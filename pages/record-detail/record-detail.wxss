/* ===== 单条记录详情页 ===== */
.page-scroll { width: 100%; }
.rd-body { padding: 32rpx 40rpx 0; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 80rpx;
  text-align: center;
}
.empty-illust { width: 160rpx; height: 160rpx; margin-bottom: 32rpx; }
.empty-title { font-size: 32rpx; font-weight: 700; color: var(--ink); font-family: var(--serif); }
.empty-desc { margin-top: 12rpx; font-size: 26rpx; color: var(--ink-soft); line-height: 1.6; letter-spacing: 0.3rpx; }
.empty-btn {
  margin-top: 32rpx;
  min-width: 200rpx;
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
  color: var(--white);
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: var(--shadow-btn);
}

/* 拍立得大卡 */
.polaroid-card {
  width: 580rpx;
  margin: 16rpx auto 0;
  padding: 24rpx 24rpx 32rpx;
  border-radius: var(--radius-lg);
  background: var(--white);
  box-shadow: 0 12rpx 40rpx rgba(91, 143, 185, 0.18);
  border: 1rpx solid var(--border-soft);
  animation: polaroidIn 500ms var(--ease-bounce);
}

@keyframes polaroidIn {
  from { opacity: 0; transform: scale(0.92) rotate(-1.5deg); }
  to { opacity: 1; }
}

.polaroid-photo-area {
  position: relative;
  width: 100%;
  height: 400rpx;
  border-radius: var(--radius-xl);
  overflow: hidden;
  background: var(--canvas);
}
.polaroid-photo { width: 100%; height: 100%; }
.filter-rain .polaroid-photo { filter: saturate(0.8) contrast(0.95) brightness(0.96); }
.filter-flash .polaroid-photo { filter: saturate(1.1) contrast(1.08) brightness(1.08); }
.filter-vintage .polaroid-photo { filter: sepia(0.4) saturate(1.1) contrast(0.95); }
.filter-mono .polaroid-photo { filter: grayscale(1) contrast(1.05); }
.filter-film .polaroid-photo { filter: sepia(0.2) contrast(1.1) brightness(0.95) saturate(1.15); }

.photo-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: var(--canvas);
}
.placeholder-ico { width: 96rpx; height: 96rpx; opacity: 0.5; }
.placeholder-text { font-size: 24rpx; color: var(--ink-faint); }

.mood-sticker {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 8rpx 18rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  font-weight: 600;
  background: var(--white);
  box-shadow: var(--shadow-float);
}

.feeling-text {
  display: block;
  margin-top: 24rpx;
  padding: 0 8rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  line-height: 1.6;
}

.polaroid-meta {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 0 8rpx;
  font-size: 20rpx;
  color: var(--ink-faint);
}

/* 区块 */
.section { margin-top: 48rpx; }
.section-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  font-family: var(--serif);
}

/* v6: 元信息栏 4 项均匀，图标在上文字在下 */
.meta-grid {
  display: flex;
  padding: 28rpx 16rpx;
}
.meta-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 8rpx;
  min-width: 0;
}
.meta-cell-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.7;
}
.meta-cell-val {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.3;
  word-break: break-all;
}
.meta-cell-label {
  font-size: 22rpx;
  color: var(--ink-faint);
  line-height: 1.2;
}

/* 完成的指令卡 */
.cmd-card {
  padding: 28rpx;
  background: var(--white);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
}
.cmd-type {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  font-weight: 600;
}
.cmd-title {
  display: block;
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.4;
  font-family: var(--serif);
}
.cmd-content {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--ink-soft);
  line-height: 1.6;
}

/* C-12: 同频记录 - 和朋友一起 */
.group-card {
  padding: 28rpx;
  background: var(--white);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
}
.group-members-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.group-member-tag {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  background: var(--heal-tint);
  color: var(--success);
  font-size: 24rpx;
  font-weight: 600;
}
.group-timeline {
  border-top: 1rpx solid var(--line);
  padding-top: 20rpx;
}
.timeline-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 12rpx 0;
}
.timeline-dot {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--brand-weak);
  color: var(--ink-faint);
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.timeline-dot.done {
  background: var(--brand);
  color: var(--white);
}
.timeline-body {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}
.timeline-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink-soft);
  line-height: 1.5;
}
.timeline-time {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--ink-faint);
}

.bottom-spacer { height: calc(280rpx + var(--safe-bottom)); }

/* 底部操作栏：3 按钮均分，图标在上文字在下 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  padding: 24rpx 40rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--white);
  border-top: 1rpx solid var(--line);
  box-shadow: 0 -2rpx 16rpx rgba(91, 143, 185, 0.06);
}
.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-height: 88rpx;
  border-radius: var(--radius-md);
  font-size: 22rpx;
  font-weight: 600;
  transition: all 150ms var(--ease-standard);
}
.action-btn image { width: 48rpx; height: 48rpx; }
.action-btn:active { transform: scale(0.97); }
.fav-btn {
  background: var(--canvas);
  color: var(--ink-soft);
}
.fav-btn.active {
  background: var(--brand-tint);
  color: var(--brand);
}
.share-btn {
  background: var(--canvas);
  color: var(--ink-soft);
}
.share-btn::after { border: 0; }
.delete-btn {
  background: var(--danger-tint);
  color: var(--danger);
}
