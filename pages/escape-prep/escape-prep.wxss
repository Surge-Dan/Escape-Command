/* ===== 出逃准备页 · 浅雾蓝设计系统 ===== */
.page-scroll { width: 100%; }
.prep-body { padding: 32rpx 40rpx 0; }

/* 通用白色卡片容器 */
.brief-card, .weather-card, .checklist-card, .route-card {
  background: var(--white);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 80rpx;
  text-align: center;
}
.empty-illust { width: 160rpx; height: 160rpx; margin-bottom: 32rpx; opacity: 0.7; }
.empty-title { font-size: 32rpx; font-weight: 700; color: var(--ink); font-family: var(--serif); }
.empty-desc { margin-top: 12rpx; font-size: 26rpx; color: var(--ink-soft); line-height: 1.6; letter-spacing: 0.3rpx; }
.empty-btn {
  margin-top: 32rpx;
  min-width: 200rpx;
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
  color: var(--white);
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: var(--shadow-btn);
}

/* 指令简述卡 */
.brief-card { padding: 28rpx; }
.brief-type {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  background: var(--brand-weak);
  color: var(--brand-strong);
}
.brief-type-ico { width: 28rpx; height: 28rpx; }
.brief-title {
  display: block;
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.4;
  font-family: var(--serif);
  letter-spacing: 0.5rpx;
}
.brief-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 14rpx;
}
.meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--ink-soft);
  letter-spacing: 0.3rpx;
}
.meta-item image { width: 24rpx; height: 24rpx; opacity: 0.7; }

/* 区块 */
.section { margin-top: 40rpx; }
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.section-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  font-family: var(--serif);
  letter-spacing: 1rpx;
}
.section-head .section-title { margin-bottom: 0; }
.section-sub { color: var(--ink-faint); font-size: 22rpx; letter-spacing: 0.5rpx; }

/* 天气卡 */
.weather-card { padding: 28rpx; }
.weather-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.weather-icon-wrap {
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--brand-tint) 0%, var(--white) 100%);
  border: 3rpx solid rgba(255,255,255,0.8);
  box-shadow: 0 4rpx 16rpx rgba(91, 143, 185, 0.12);
}
.weather-icon { width: 64rpx; height: 64rpx; }
.weather-text { flex: 1; }
.weather-temp-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}
.weather-temp {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.1;
  font-family: var(--serif);
}
.weather-unit {
  font-size: 28rpx;
  color: var(--ink-soft);
}
.weather-desc {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
}
.weather-suggestion {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.6;
  letter-spacing: 0.3rpx;
}

/* 物品清单卡 */
.checklist-card { padding: 12rpx 28rpx; }
.check-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
}
.check-row + .check-row { border-top: 1rpx solid var(--line); }
.check-row:active { opacity: 0.6; }
.check-box {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid var(--ink-faint);
  background: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 200ms var(--ease-standard);
}
.check-box.on {
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
  border-color: var(--brand);
  box-shadow: 0 4rpx 12rpx rgba(91, 143, 185, 0.3);
}
.check-ico { width: 28rpx; height: 28rpx; }
.check-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.5;
  transition: all 200ms var(--ease-standard);
  letter-spacing: 0.3rpx;
}
.check-text.on { color: var(--ink-faint); text-decoration: line-through; }

/* 路线预览卡 */
.route-card { padding: 0; overflow: hidden; }
.route-illus {
  position: relative;
  width: 100%;
  height: 280rpx;
  background: linear-gradient(180deg, var(--brand-weak) 0%, var(--canvas) 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 56rpx;
}
.route-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.4;
}
.route-pin {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.pin-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
  border: 6rpx solid var(--white);
  box-shadow: var(--shadow-float);
}
.pin-label {
  font-size: 20rpx;
  color: var(--brand-strong);
  background: var(--white);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
  font-weight: 600;
  box-shadow: var(--shadow-card);
}
.pin-ico { width: 56rpx; height: 56rpx; }
.route-dash {
  flex: 1;
  height: 0;
  border-top: 4rpx dashed var(--brand);
  margin: 0 24rpx;
  position: relative;
  z-index: 2;
  opacity: 0.6;
}
.route-text-row {
  display: flex;
  align-items: center;
  padding: 28rpx;
}
.route-end-point {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.route-end-point:last-child { align-items: flex-end; }
.route-label {
  font-size: 20rpx;
  color: var(--ink-faint);
  letter-spacing: 0.5rpx;
}
.route-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  font-family: var(--serif);
}
.route-arrow {
  width: 32rpx;
  height: 32rpx;
  margin: 0 24rpx;
  opacity: 0.5;
}
.route-tip {
  display: block;
  padding: 0 28rpx 24rpx;
  font-size: 22rpx;
  color: var(--ink-faint);
  letter-spacing: 0.3rpx;
}

.bottom-spacer { height: 200rpx; }

/* 底部出发按钮 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(232, 244, 252, 0) 0%, var(--canvas) 40%);
  border-top: none;
}
.depart-btn {
  width: 100%;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
  color: var(--white);
  border-radius: var(--radius-pill);
  font-weight: 600;
  box-shadow: var(--shadow-btn);
  letter-spacing: 1rpx;
}
.depart-btn:active { transform: scale(0.97); }
.depart-btn image { width: 32rpx; height: 32rpx; }
