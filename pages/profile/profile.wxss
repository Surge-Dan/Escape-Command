.profile-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: var(--bg-gradient);
}

.status-bar { flex-shrink: 0; background: transparent; }
.profile-page .nav-header {
  flex-shrink: 0;
  background: transparent;
  border-bottom: none;
}

.profile-scroll {
  flex: 1;
  height: 0;
}

.profile-body {
  padding: 24rpx 40rpx 0;
}

/* ===== 用户信息卡：毛玻璃 ===== */
.profile-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx 32rpx;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(20px) saturate(1.4);
  -webkit-backdrop-filter: blur(20px) saturate(1.4);
  border-radius: var(--radius-xl);
  border: 1rpx solid rgba(255,255,255,0.8);
  box-shadow: var(--shadow-elevated);
  margin-bottom: 24rpx;
}

.avatar-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255,255,255,0.9);
  box-shadow: 0 8rpx 24rpx rgba(91, 143, 185, 0.22);
  background: var(--brand-tint);
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.user-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
  padding-right: 88rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  font-family: var(--serif);
  letter-spacing: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-code {
  font-size: 24rpx;
  color: var(--ink-faint);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0.5rpx;
}

.edit-btn {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-weak);
  border: 1rpx solid var(--border-soft);
  box-shadow: var(--shadow-card);
  flex-shrink: 0;
  transition: all 180ms var(--ease-bounce);
}

.edit-btn:active { transform: translateY(-50%) scale(0.9); background: var(--brand-tint); }

.ico-pencil {
  width: 28rpx;
  height: 28rpx;
}

/* ===== 会员卡 ===== */
.member-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #FFF8E0 0%, #FFEFBF 100%);
  border-radius: var(--radius-xl);
  border: 1rpx solid rgba(212, 160, 86, 0.2);
  box-shadow: 0 4rpx 16rpx rgba(212, 160, 86, 0.12);
  margin-bottom: 24rpx;
  transition: transform 200ms var(--ease-standard);
}

.member-card:active { transform: scale(0.98); }

.member-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.member-icon {
  width: 60rpx;
  height: 60rpx;
}

.member-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.member-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #8C6028;
  letter-spacing: 1rpx;
}

.member-sub {
  font-size: 22rpx;
  color: #B08B4C;
}

.member-cta {
  padding: 10rpx 22rpx;
  background: rgba(255,255,255,0.6);
  color: #8C6028;
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* ===== 数据统计 ===== */
.stats-card {
  background: var(--white);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
  padding: 32rpx 16rpx;
  margin-bottom: 32rpx;
  display: flex;
  justify-content: space-around;
}

.stats-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  flex: 1;
}

.stats-num-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.stats-value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.1;
  font-family: var(--serif);
  letter-spacing: 1rpx;
}

.stats-unit {
  font-size: 20rpx;
  color: var(--ink-faint);
  margin-left: 2rpx;
}

.stats-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-faint);
  letter-spacing: 0.5rpx;
}

/* ===== 分类卡片 ===== */
.categories-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.category-card {
  position: relative;
  background: var(--white);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
  transition: transform 200ms var(--ease-standard);
  overflow: hidden;
}

.category-card:active { transform: scale(0.99); }

.category-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 28rpx 16rpx;
}

.category-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: linear-gradient(135deg, var(--brand-weak) 0%, var(--brand-tint) 100%);
}

.category-icon {
  width: 40rpx;
  height: 40rpx;
}

.category-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.category-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
  letter-spacing: 1rpx;
  font-family: var(--serif);
}
.category-sub {
  font-size: 22rpx;
  color: var(--ink-faint);
  line-height: 1.4;
}

.category-items {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 4rpx;
  padding: 4rpx 16rpx 24rpx;
}

.cat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 8rpx;
  border-radius: var(--radius-md);
  transition: all 180ms var(--ease-standard);
  gap: 10rpx;
}
.cat-item:active {
  background: var(--brand-weak);
  transform: scale(0.95);
}

.cat-item-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--brand-weak);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 180ms var(--ease-standard);
}
.cat-item:active .cat-item-icon-wrap {
  background: var(--brand-tint);
}
.cat-item-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.85;
}

.cat-item-label {
  font-size: 22rpx;
  color: var(--ink-soft);
  text-align: center;
  line-height: 1.3;
  letter-spacing: 0.5rpx;
}

.bottom-spacer {
  height: calc(var(--tabbar-floating-height) + var(--tabbar-bottom-gap) + var(--safe-bottom) + 16rpx);
}

.tabbar-placeholder {
  height: calc(var(--tabbar-floating-height) + var(--tabbar-bottom-gap) + var(--safe-bottom));
}
