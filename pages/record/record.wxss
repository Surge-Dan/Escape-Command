/* v3 重跑：.nav-header 迁移 + 9 照片横滑 + 6 滤镜(inline) + 贴纸库(两组) + 位置卡 + 手写感受 */
.record-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: var(--canvas);
}

.status-bar { width: 100%; }

/* 顶部导航已迁移至全局 .nav-header */

.record-scroll { flex: 1; height: 0; }
.record-body { padding: 32rpx 40rpx; }

/* ===== 拍立得卡片 ===== */
.polaroid-card {
  width: 560rpx;
  margin: 0 auto;
  padding: 28rpx 28rpx 36rpx;
  border-radius: var(--radius-md);
  background: var(--white);
  box-shadow: var(--shadow-popup);
  transform: rotate(-1.5deg);
  animation: polaroidIn 500ms var(--ease-bounce);
  border: var(--border);
}

@keyframes polaroidIn {
  from { opacity: 0; transform: scale(0.9) rotate(-1.5deg); }
  to { opacity: 1; transform: scale(1) rotate(-1.5deg); }
}

.polaroid-photo-area {
  position: relative;
  height: 480rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--canvas);
}

.polaroid-photo { width: 100%; height: 100%; }

/* 心情贴纸角标 */
.photo-mood-sticker {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-float);
  border: var(--border);
}

.photo-mood-sticker image { width: 44rpx; height: 44rpx; }

/* v3: emoji 贴纸叠加层（点击移除） */
.photo-emoji-sticker {
  position: absolute;
  transform: translate(-50%, -50%);
  font-size: 56rpx;
  line-height: 1;
  z-index: 5;
  filter: drop-shadow(0 2rpx 6rpx rgba(0, 0, 0, 0.25));
  transition: transform 150ms var(--ease-standard);
  /* 让触摸拖拽跟手：取消默认 touch 高亮 + 阻止长按菜单 */
  -webkit-tap-highlight-color: transparent;
  touch-action: none;
}

/* 拖拽中：放大 1.2 倍 + 取消过渡让跟手即时 */
.photo-emoji-sticker.dragging {
  transform: translate(-50%, -50%) scale(1.25);
  transition: none;
  z-index: 8;
  filter: drop-shadow(0 4rpx 12rpx rgba(0, 0, 0, 0.35));
}

.photo-emoji-sticker:active { transform: translate(-50%, -50%) scale(0.85); }

/* v3: 感受输入（inline on polaroid，手写风） */
.feeling-input {
  width: 100%;
  min-height: 96rpx;
  margin-top: 20rpx;
  padding: 0 8rpx;
  font-size: 30rpx;
  color: var(--ink);
  line-height: 1.5;
  font-style: italic;
  font-family: "Kaiti", "STKaiti", "Songti SC", "Noto Serif SC", "Caveat", cursive;
}

.polaroid-meta {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 14rpx;
  padding: 0 8rpx;
  font-size: 20rpx;
  color: var(--ink-faint);
}

/* ===== v3: 位置卡片 ===== */
.location-card {
  margin: 24rpx auto 0;
  width: 560rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 24rpx;
  border-radius: var(--radius-lg);
  background: var(--white);
  border: var(--border);
  box-shadow: var(--shadow-card);
}

.location-card image { width: 32rpx; height: 32rpx; flex-shrink: 0; }

.location-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ===== Section 通用 ===== */
.section { margin-top: 48rpx; }

.section-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

/* v3: 照片缩略图横滑条 */
.photo-strip { width: 100%; }

.photo-strip-list {
  display: flex;
  gap: 12rpx;
  padding: 4rpx 6rpx;
}

.photo-strip-thumb {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--canvas);
  border: 3rpx solid transparent;
  flex-shrink: 0;
  transition: all 150ms var(--ease-standard);
}

.photo-strip-thumb.active {
  border-color: var(--brand);
  box-shadow: var(--shadow-card);
}

.photo-strip-thumb:active { transform: scale(0.95); }

.photo-strip-thumb image { width: 100%; height: 100%; }

.photo-strip-remove {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(46, 47, 51, 0.65);
  color: var(--white);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.photo-strip-add {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-md);
  border: 2rpx dashed var(--ink-faint);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-soft);
  font-size: 48rpx;
  flex-shrink: 0;
  transition: all 150ms var(--ease-standard);
}

.photo-strip-add:active {
  background: var(--brand-tint);
  border-color: var(--brand);
  transform: scale(0.97);
}

/* ===== v3: 滤镜选择（120rpx 缩略图预览 + 名称） ===== */
.filter-row { width: 100%; }

.filter-row-list {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 6rpx;
}

.filter-thumb {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  transition: all 200ms var(--ease-standard);
}

.filter-thumb-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-md);
  background: var(--canvas);
  border: 3rpx solid transparent;
  overflow: hidden;
  transition: all 200ms var(--ease-standard);
}

.filter-thumb.active .filter-thumb-img {
  border-color: var(--brand);
  box-shadow: var(--shadow-card);
  transform: scale(1.03);
}

.filter-thumb:active .filter-thumb-img { transform: scale(0.95); }

.filter-thumb-name {
  font-size: 22rpx;
  color: var(--ink-soft);
}

.filter-thumb.active .filter-thumb-name {
  color: var(--brand-dark);
  font-weight: 600;
}

/* ===== v3: emoji 贴纸库（单组横滑，64rpx emoji） ===== */
.sticker-row { width: 100%; }

.sticker-list {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 6rpx;
}

.sticker-item {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
  background: var(--white);
  border: var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  line-height: 1;
  flex-shrink: 0;
  transition: all 150ms var(--ease-standard);
}

.sticker-item:active {
  background: var(--brand-tint);
  transform: scale(0.92);
}

/* ===== 心情贴纸 ===== */
.mood-row {
  display: flex;
  justify-content: space-between;
}

.mood-item {
  min-width: 96rpx;
  min-height: 128rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
  transition: all 200ms var(--ease-standard);
}

.mood-circle {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid transparent;
  transition: all 200ms var(--ease-standard);
}

.mood-circle.picked {
  border-color: var(--brand);
  transform: scale(1.12);
}

.mood-circle:active { transform: scale(0.92); }
.mood-circle image { width: 44rpx; height: 44rpx; }

.mood-item.active {
  color: var(--brand-dark);
  font-weight: 600;
}

/* ===== 底部保存按钮 ===== */
.save-bar {
  padding: 24rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--canvas);
}

.save-btn {
  width: 100%;
  min-height: 88rpx;
  border-radius: var(--radius-pill);
  background: var(--brand);
  color: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 150ms var(--ease-standard);
}

.save-btn.loading { opacity: 0.75; }
.save-btn:active {
  background: var(--brand-dark);
  transform: scale(0.97);
}
.save-btn image { width: 32rpx; height: 32rpx; }

/* ===== 分享画布 ===== */
/* Canvas 2D 内部坐标系使用 px，定位也统一用 px 避免 rpx/px 混用 */
.share-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 600px;
  height: 900px;
}

/* ===== 保存成功弹层 ===== */
.saved-overlay {
  position: fixed;
  inset: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 64rpx;
  background: rgba(46, 47, 51, 0.45);
}

.saved-card {
  width: 100%;
  padding: 48rpx;
  border-radius: var(--radius-xl);
  background: var(--white);
  box-shadow: var(--shadow-popup);
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: savedPop 350ms var(--ease-bounce);
}

@keyframes savedPop {
  from { opacity: 0; transform: scale(0.92); }
  to { opacity: 1; transform: scale(1); }
}

.saved-check {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
}

.saved-check image { width: 48rpx; height: 48rpx; }

.saved-title {
  margin-top: 24rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
}

.saved-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
}

.saved-actions {
  width: 100%;
  display: flex;
  gap: 16rpx;
  margin-top: 36rpx;
}

.saved-btn {
  flex: 1;
  min-height: 88rpx;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  transition: transform 150ms var(--ease-standard);
}

.saved-btn:active { transform: scale(0.97); }
.saved-btn.ghost { background: transparent; color: var(--brand); border: 2rpx solid var(--brand); }
.saved-btn.primary { background: var(--brand); color: var(--white); }

.saved-later {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  color: var(--ink-faint);
  font-size: 28rpx;
}

.bottom-spacer { height: 24rpx; }
