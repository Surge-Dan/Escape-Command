<view class="profile-page paper-texture">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

  <view class="nav-header" style="{{navHeaderStyle}}">
    <view class="nav-header-back" bindtap="goBack">
      <image src="/assets/icons/chevron-left-ink.svg" mode="aspectFit"></image>
    </view>
    <text class="nav-header-title">破圈画像</text>
    <view class="nav-header-divider"></view>
  </view>

  <scroll-view scroll-y class="scroll-area" enhanced show-scrollbar="{{false}}">
    <view class="body">
      <!-- 头部说明 -->
      <view class="header-section">
        <text class="header-title">先了解你，再帮你破圈</text>
        <text class="header-desc">5 个问题，30 秒完成。答案决定了每次破圈摇到什么。</text>
      </view>

      <!-- 问题 1：运动频率 -->
      <view class="question-card">
        <text class="question-label">1. 你的运动频率？</text>
        <view class="option-row">
          <view
            wx:for="{{sportOpts}}" wx:key="value"
            class="option-pill {{form.sportFreq === item.value ? 'active' : ''}}"
            data-field="sportFreq" data-value="{{item.value}}"
            bindtap="onSelect"
          >{{item.label}}</view>
        </view>
      </view>

      <!-- 问题 2：社交倾向 -->
      <view class="question-card">
        <text class="question-label">2. 你的社交倾向？</text>
        <view class="option-row">
          <view
            wx:for="{{socialOpts}}" wx:key="value"
            class="option-pill {{form.socialTendency === item.value ? 'active' : ''}}"
            data-field="socialTendency" data-value="{{item.value}}"
            bindtap="onSelect"
          >{{item.label}}</view>
        </view>
      </view>

      <!-- 问题 3：日常活动范围 -->
      <view class="question-card">
        <text class="question-label">3. 你的日常活动范围？</text>
        <view class="option-row">
          <view
            wx:for="{{rangeOpts}}" wx:key="value"
            class="option-pill {{form.dailyRange === item.value ? 'active' : ''}}"
            data-field="dailyRange" data-value="{{item.value}}"
            bindtap="onSelect"
          >{{item.label}}</view>
        </view>
      </view>

      <!-- 问题 4：主要爱好 -->
      <view class="question-card">
        <text class="question-label">4. 你的主要爱好？（可多选）</text>
        <view class="option-row">
          <view
            wx:for="{{hobbyOpts}}" wx:key="value"
            class="option-pill multi {{hobbyMap[item.value] ? 'active' : ''}}"
            data-field="hobbies" data-value="{{item.value}}"
            bindtap="onToggleHobby"
          >{{item.label}}</view>
        </view>
      </view>

      <!-- 问题 5：想破圈的方向 -->
      <view class="question-card">
        <text class="question-label">5. 你最想尝试什么类型的破圈？</text>
        <view class="option-row">
          <view
            wx:for="{{wantOpts}}" wx:key="value"
            class="option-pill multi {{wantMap[item.value] ? 'active' : ''}}"
            data-field="wants" data-value="{{item.value}}"
            bindtap="onToggleWant"
          >{{item.label}}</view>
        </view>
      </view>
    </view>

    <view class="bottom-area">
      <view class="save-btn {{allDone ? '' : 'disabled'}}" bindtap="onSave">
        <text>{{allDone ? '完成画像，去破圈' : '请回答全部 5 个问题'}}</text>
      </view>
    </view>
  </scroll-view>
</view>
