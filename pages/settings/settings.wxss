.settings-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: var(--bg-gradient);
}

.settings-page .status-bar { flex-shrink: 0; background: transparent; }
.settings-page .nav-header { flex-shrink: 0; }

.settings-scroll {
  flex: 1;
  height: 0;
  padding: 8rpx 40rpx 0;
}

.settings-section {
  margin-bottom: 40rpx;
}

.section-label {
  display: block;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--ink-faint);
  letter-spacing: 2rpx;
  margin-bottom: 14rpx;
  padding-left: 8rpx;
}

.setting-group {
  background: var(--white);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  min-height: 96rpx;
  transition: background 150ms ease;
}

.setting-item:active {
  background: var(--brand-weak);
}

.setting-item.active {
  background: var(--brand-tint);
}

.setting-text {
  flex: 1;
  min-width: 0;
}

.setting-name {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
}

.setting-desc {
  display: block;
  font-size: 22rpx;
  color: var(--ink-faint);
  margin-top: 6rpx;
  line-height: 1.4;
}

.setting-divider {
  margin: 0 32rpx;
  height: 1rpx;
  background: var(--line);
}

.danger-item {
  background: transparent;
}
.danger-item:active {
  background: var(--danger-tint);
}
.danger-text {
  color: var(--danger);
  font-weight: 500;
}

.check-ico {
  width: 36rpx;
  height: 36rpx;
  background: linear-gradient(135deg, var(--brand), var(--brand-light));
  border-radius: 50%;
  padding: 8rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(91, 143, 185, 0.3);
}

.arrow-ico {
  width: 20rpx;
  height: 20rpx;
  flex-shrink: 0;
  opacity: 0.4;
}

.version-info {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-faint);
  margin-top: 32rpx;
  letter-spacing: 1rpx;
}

.bottom-spacer {
  height: calc(40rpx + var(--safe-bottom));
}

/* ===== 通知偏好行 ===== */
.notification-item {
  align-items: center;
}

.notification-controls {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
}

.time-picker {
  background: var(--brand-weak);
  border-radius: var(--radius-pill);
  padding: 10rpx 24rpx;
  transition: background 150ms ease;
}
.time-picker:active {
  background: var(--brand-tint);
}

.time-display {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--brand);
  line-height: 1.4;
}

/* ===== 主题卡片 ===== */
.theme-cards {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.theme-card {
  position: relative;
  display: flex;
  align-items: center;
  background: var(--white);
  border-radius: var(--radius-xl);
  border: 2rpx solid var(--border-soft);
  box-shadow: var(--shadow-card);
  padding: 28rpx;
  transition: all 200ms var(--ease-standard);
}

.theme-card.active {
  border-color: var(--brand);
  background: var(--brand-tint);
  box-shadow: var(--shadow-float);
}

.theme-preview {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 2rpx solid rgba(91, 143, 185, 0.15);
  box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, 0.6), 0 4rpx 12rpx rgba(91, 143, 185, 0.15);
}

.theme-card-body {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.theme-card-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.5rpx;
}

.theme-card-desc {
  display: block;
  font-size: 22rpx;
  color: var(--ink-faint);
  margin-top: 4rpx;
  line-height: 1.4;
}

.theme-check {
  width: 36rpx;
  height: 36rpx;
  background: linear-gradient(135deg, var(--brand), var(--brand-light));
  border-radius: 50%;
  padding: 8rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(91, 143, 185, 0.3);
}

.theme-check image {
  width: 100%;
  height: 100%;
}
