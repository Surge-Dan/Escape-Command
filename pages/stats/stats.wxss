/* ===== 数据统计页 ===== */
.page-scroll { padding: 0; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 80rpx;
  text-align: center;
}
.empty-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--canvas);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}
.empty-circle image { width: 64rpx; height: 64rpx; }
.empty-title { font-size: 36rpx; font-weight: 700; color: var(--ink); margin-bottom: 16rpx; }
.empty-sub { font-size: 26rpx; color: var(--ink-soft); line-height: 1.5; margin-bottom: 48rpx; }
.empty-back { padding: 0 48rpx; }

.stats-body { padding: 24rpx 40rpx 0; }

/* ===== 顶部总览 ===== */
.summary-card {
  background: linear-gradient(135deg, #FFFFFF 0%, #F0FAF6 100%);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.summary-card::after {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(200, 149, 110, 0.18) 0%, transparent 70%);
  pointer-events: none;
}
.summary-eyebrow {
  display: block;
  font-size: 24rpx;
  color: var(--ink-soft);
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
  position: relative;
}
.summary-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
  position: relative;
}
.summary-big {
  font-size: 88rpx;
  font-weight: 700;
  color: var(--brand-strong);
  line-height: 1;
}
.summary-mid {
  font-size: 32rpx;
  color: var(--ink);
  font-weight: 600;
}
.summary-sub {
  display: block;
  font-size: 24rpx;
  color: var(--ink-soft);
  position: relative;
}

/* ===== 图表卡 ===== */
.chart-card {
  background: var(--white);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
  padding: 28rpx 24rpx 24rpx;
  margin-bottom: 24rpx;
}
.chart-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}
.chart-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 2rpx;
}
.chart-meta {
  font-size: 22rpx;
  color: var(--ink-faint);
}

/* ===== 1. 时长分布（横向柱状图） ===== */
.hbar-list { display: flex; flex-direction: column; gap: 20rpx; }
.hbar-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.hbar-label {
  width: 130rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
  text-align: right;
  flex-shrink: 0;
}
.hbar-track {
  flex: 1;
  height: 28rpx;
  background: var(--canvas);
  border-radius: 14rpx;
  overflow: hidden;
}
.hbar-fill {
  height: 100%;
  border-radius: 14rpx;
  transition: width 600ms var(--ease-standard);
  min-width: 4rpx;
}
.hbar-count {
  width: 48rpx;
  font-size: 24rpx;
  color: var(--ink);
  font-weight: 600;
  text-align: left;
  flex-shrink: 0;
}

/* ===== 通用纵向柱状图 ===== */
.vbar-chart {
  display: flex;
  height: 320rpx;
  padding: 0 4rpx;
}
.vbar-yaxis {
  width: 56rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 8rpx 0 36rpx;
  text-align: right;
  padding-right: 8rpx;
  flex-shrink: 0;
}
.vbar-y-label {
  font-size: 20rpx;
  color: var(--ink-faint);
  line-height: 1;
}
.vbar-area {
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  position: relative;
  padding-bottom: 36rpx;
}
.vbar-grid {
  position: absolute;
  top: 8rpx;
  left: 0;
  right: 0;
  bottom: 36rpx;
  pointer-events: none;
  background-image:
    linear-gradient(to bottom, rgba(122, 78, 43, 0.08), rgba(122, 78, 43, 0.08) 1rpx, transparent 1rpx, transparent 49%, rgba(122, 78, 43, 0.08) 49%, rgba(122, 78, 43, 0.08) 50%, transparent 50%, transparent 99%, rgba(122, 78, 43, 0.08) 99%);
  background-size: 100% 100%;
  background-repeat: no-repeat;
}
.vbar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  max-width: 80rpx;
  position: relative;
  z-index: 2;
}
.vbar-bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  position: relative;
}
.vbar-bar {
  width: 70%;
  border-radius: 8rpx 8rpx 2rpx 2rpx;
  transition: height 600ms var(--ease-standard);
  min-height: 4rpx;
}
.vbar-bar-count {
  position: absolute;
  top: -28rpx;
  font-size: 20rpx;
  color: var(--ink-soft);
  font-weight: 600;
  white-space: nowrap;
}
.vbar-x-label {
  position: absolute;
  bottom: 0;
  font-size: 20rpx;
  color: var(--ink-faint);
  white-space: nowrap;
}
.vbar-col.current .vbar-x-label {
  color: var(--brand-strong);
  font-weight: 600;
}

.month-chart .vbar-col { max-width: 50rpx; }
.month-chart .vbar-bar { width: 60%; }

/* ===== 图例 ===== */
.chart-legend {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 12rpx 4rpx 0;
  border-top: 1rpx solid var(--line);
}
.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
}
.legend-dot.ghost { opacity: 0.6; }
.legend-text {
  font-size: 22rpx;
  color: var(--ink-faint);
  margin-right: 8rpx;
}

/* ===== 4. 热力日历 ===== */
.heatmap-wrap {
  display: flex;
  gap: 12rpx;
  padding: 4rpx 0 8rpx;
}
.heatmap-day-labels {
  width: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
  flex-shrink: 0;
}
.heat-day-label {
  font-size: 18rpx;
  color: var(--ink-faint);
  line-height: 1;
}
.heatmap-grid {
  flex: 1;
  display: grid;
  gap: 6rpx;
  grid-auto-flow: column;
  height: 280rpx;
}
.heat-cell {
  border-radius: 4rpx;
  background: var(--canvas);
  transition: transform 150ms var(--ease-standard);
}
.heat-cell:active { transform: scale(1.15); }
.heat-cell.heat-level--1 { background: transparent; }
.heat-cell.heat-level-0 { background: rgba(122, 78, 43, 0.05); }
.heat-cell.heat-level-1 { background: rgba(200, 149, 110, 0.35); }
.heat-cell.heat-level-2 { background: rgba(200, 149, 110, 0.65); }
.heat-cell.heat-level-3 { background: var(--brand-strong); box-shadow: 0 0 8rpx rgba(168, 123, 82, 0.4); }

.legend-dot.heat-level-0 { background: rgba(122, 78, 43, 0.05); }
.legend-dot.heat-level-1 { background: rgba(200, 149, 110, 0.35); }
.legend-dot.heat-level-2 { background: rgba(200, 149, 110, 0.65); }
.legend-dot.heat-level-3 { background: var(--brand-strong); }

.bottom-spacer { height: 80rpx; }
