/* ===== 出逃指令 v2.0 全局基础层 ===== */
page {
  --brand: #C8956E;
  --brand-dark: #A87B52;
  --brand-strong: #A87B52;
  --brand-tint: #F5E6D8;
  --brand-weak: #FAF3ED;
  --canvas: #F5F3EF;
  --white: #FFFFFF;
  --ink: #2E2F33;
  --ink-soft: #6B7280;
  --ink-faint: #A8ADB5;
  --line: rgba(122, 78, 43, 0.06);
  --accent: #D48A5A;
  --accent-tint: #FFF0E6;
  --danger: #E05555;
  --danger-tint: #FFECEC;
  --heal-tint: #F4EDFF;
  --gold: #C9B037;
  --gold-tint: #FFF0D4;
  --lemon-tint: #FFF4C7;
  --sun: #FFD36B;
  --cloud: #9AA8BA;
  --rain: #7EC8F5;
  --night: #9B8EC4;
  --type-color: #5B8FB9;
  --type-walk: #D98A5C;
  --type-sense: #9B7BB8;
  --type-collect: #C9B037;
  --type-food: #A67C52;
  --type-culture: #5CBF9E;
  --radius-xs: 6rpx;
  --radius-sm: 10rpx;
  --radius-md: 16rpx;
  --radius-lg: 20rpx;
  --radius-xl: 24rpx;
  --radius-pill: 100rpx;
  --shadow-card: 0 2rpx 16rpx rgba(46, 47, 51, 0.04);
  --shadow-elevated: 0 4rpx 24rpx rgba(46, 47, 51, 0.08);
  --shadow-popup: 0 8rpx 40rpx rgba(46, 47, 51, 0.12);
  --shadow-float: 0 2rpx 12rpx rgba(46, 47, 51, 0.06);
  --border: 2rpx solid rgba(122, 78, 43, 0.06);
  --ease-standard: cubic-bezier(0.25, 0.1, 0.25, 1.0);
  --ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1.0);
  --ease-out: cubic-bezier(0.0, 0.0, 0.2, 1.0);

  /* v8: 参考风格 —— 暖橙 hero 渐变 + 衬线字体 token */
  --hero-warm-start: #FFD7B5;
  --hero-warm-mid: #FFE8D6;
  --hero-warm-end: #FFF7F0;
  --serif: "Cormorant Garamond", "Playfair Display", "Times New Roman", "STZhongsong", "Songti SC", serif;
  --serif-italic: "Cormorant Garamond Italic", "Playfair Display Italic", "Times New Roman", "STZhongsong", "Songti SC", serif;
  --ink-italic: #B8623F;

  /* v7: 安全区 + TabBar + 按钮阴影 token（之前缺失，导致多处 calc 失效） */
  --safe-top: env(safe-area-inset-top, 0px);
  --safe-bottom: env(safe-area-inset-bottom, 0px);
  --tabbar-floating-height: 100rpx;
  --tabbar-bottom-gap: 24rpx;
  --page-pad-top: calc(var(--safe-top) + 24rpx);
  --page-pad-bottom: calc(var(--tabbar-floating-height) + var(--tabbar-bottom-gap) + var(--safe-bottom) + 24rpx);
  --shadow-button: 0 4rpx 12rpx rgba(160, 110, 70, 0.25);

  background: linear-gradient(180deg, #FFF6F0 0%, #F5F3EF 60%, #F5F3EF 100%);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, button, input, textarea, scroll-view {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  border: 0;
  background: transparent;
  line-height: 1.5;
}

button::after { border: 0; }

.page-container {
  min-height: 100vh;
}

/* .paper-texture 不再覆盖背景色，页面背景由 page 统一渐变提供 */

.solid-card {
  background: var(--white);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
}

.glass-card {
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(24px) saturate(1.5);
  -webkit-backdrop-filter: blur(24px) saturate(1.5);
  border: var(--border);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-card);
}

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 48rpx;
  background: var(--brand);
  color: var(--white);
  border-radius: var(--radius-md);
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: var(--shadow-button);
  transition: all 150ms var(--ease-standard);
}

.btn-primary:active {
  background: var(--brand-dark);
  opacity: 0.88;
  transform: scale(0.97);
}

.btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 48rpx;
  background: transparent;
  color: var(--brand);
  border: 2rpx solid var(--brand);
  border-radius: var(--radius-md);
  font-size: 30rpx;
  font-weight: 600;
  transition: all 150ms var(--ease-standard);
}

.btn-secondary:active {
  background: var(--brand-tint);
  opacity: 0.88;
  transform: scale(0.97);
}

.h1 { font-size: 44rpx; font-weight: 700; line-height: 1.2; }
.h2 { font-size: 36rpx; font-weight: 700; line-height: 1.3; }
.h3 { font-size: 30rpx; font-weight: 600; line-height: 1.4; }
.body-text { font-size: 28rpx; font-weight: 400; line-height: 1.5; }
.caption-text { font-size: 24rpx; font-weight: 400; line-height: 1.4; color: var(--ink-soft); }
.small-text { font-size: 22rpx; font-weight: 400; line-height: 1.4; color: var(--ink-faint); }

.num-display,
.font-mono {
  font-family: "SF Mono", "Menlo", "Consolas", monospace;
  font-variant-numeric: tabular-nums;
}

.meta-text { font-size: 22rpx; color: var(--ink-faint); }
.sub-text { font-size: 24rpx; color: var(--ink-soft); }

.tabbar-placeholder {
  height: calc(100rpx + env(safe-area-inset-bottom));
}

.bottom-spacer {
  height: calc(100rpx + env(safe-area-inset-bottom));
}

.dot-sep {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--ink-faint);
  opacity: 0.5;
}

/* ===== v3.1 导航头部：降低高度、右侧元素避让胶囊、不再贴顶 ===== */
/* v9: 导航栏背景交给页面根容器渐变，自身透明，底部用独立 divider */
.status-bar {
  background: transparent;
}
.nav-header {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  height: 80rpx;
  padding: 0 32rpx;
  background: transparent;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  position: relative;
  z-index: 10;
  /* 导航栏下方留白，避免分隔线与下方首个模块重叠 */
  margin-bottom: 24rpx;
}
.nav-header-back {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  left: 16rpx;
  top: 50%;
  transform: translateY(-50%);
}
.nav-header-back:active { background: var(--canvas); }
.nav-header-back image { width: 36rpx; height: 36rpx; }
.nav-header-title {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
  max-width: 360rpx;
  padding-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* v10: 标题下方细横线分隔，贴导航栏底边（不溢出到内容区） */
.nav-header-divider {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 1rpx;
  background: rgba(122, 78, 43, 0.10);
  z-index: 11;
}
/* v8: 右侧操作区改为 flex 流式布局，与标题同中线；通过父级 navHeaderStyle 的 padding-right 保持与胶囊按钮的安全距离 */
.nav-header-right {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  flex-shrink: 0;
  height: 100%;
  box-sizing: border-box;
}
