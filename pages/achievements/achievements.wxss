/* ===== 成就系统页 ===== */
.page-scroll { padding: 0; }
.ach-body { padding: 24rpx 40rpx 0; }

/* ===== 顶部总览卡 ===== */
.overview-card {
  position: relative;
  background: linear-gradient(135deg, #FFFFFF 0%, #F0FAF6 100%);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
  padding: 40rpx 32rpx;
  margin-bottom: 40rpx;
  overflow: hidden;
  text-align: center;
}
.overview-glow {
  position: absolute;
  top: -100rpx;
  right: -80rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(200, 149, 110, 0.22) 0%, transparent 70%);
  filter: blur(20rpx);
  pointer-events: none;
}
.overview-eyebrow {
  display: block;
  font-size: 24rpx;
  color: var(--ink-soft);
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 2;
}
.overview-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 2;
}
.overview-big {
  font-size: 96rpx;
  font-weight: 700;
  color: var(--brand-strong);
  line-height: 1;
}
.overview-unit {
  font-size: 28rpx;
  color: var(--ink-soft);
}
.overview-sub {
  display: block;
  font-size: 24rpx;
  color: var(--ink-soft);
  position: relative;
  z-index: 2;
}

/* ===== Section 标题 ===== */
.section-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 8rpx 4rpx 20rpx;
}
.section-title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 2rpx;
}
.section-title-meta {
  font-size: 24rpx;
  color: var(--ink-faint);
  font-family: "SF Mono", "Menlo", monospace;
}

/* ===== 里程碑卡 ===== */
.milestone-list { display: flex; flex-direction: column; gap: 20rpx; margin-bottom: 40rpx; }

.milestone-card {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 28rpx 24rpx;
  border-radius: var(--radius-xl);
  background: var(--white);
  border: var(--border);
  box-shadow: var(--shadow-card);
  transition: transform 150ms var(--ease-standard);
}
.milestone-card.unlocked {
  background: linear-gradient(135deg, #FFFBF0 0%, #FFFFFF 100%);
  border: 2rpx solid rgba(201, 176, 55, 0.32);
  box-shadow: 0 4rpx 20rpx rgba(201, 176, 55, 0.12);
}
.milestone-card:active { transform: scale(0.99); }

.milestone-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: inset 0 0 0 2rpx rgba(122, 78, 43, 0.06);
}
.milestone-card.unlocked .milestone-icon-wrap {
  box-shadow: 0 4rpx 16rpx rgba(255, 211, 107, 0.4);
}
.milestone-icon-wrap image { width: 44rpx; height: 44rpx; }

.milestone-body { flex: 1; min-width: 0; }
.milestone-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}
.milestone-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
}
.milestone-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  background: var(--gold-tint);
  color: var(--gold);
  font-weight: 600;
  flex-shrink: 0;
}
.milestone-tag.ghost {
  background: var(--canvas);
  color: var(--ink-faint);
  font-family: "SF Mono", "Menlo", monospace;
}
.milestone-desc {
  display: block;
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.5;
  margin-bottom: 12rpx;
}
.milestone-progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.milestone-track {
  flex: 1;
  height: 12rpx;
  background: var(--canvas);
  border-radius: 6rpx;
  overflow: hidden;
}
.milestone-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--brand), var(--brand-strong));
  border-radius: 6rpx;
  transition: width 600ms var(--ease-standard);
}
.milestone-percent {
  font-size: 22rpx;
  color: var(--ink-faint);
  width: 64rpx;
  text-align: right;
}
.milestone-date {
  display: block;
  font-size: 22rpx;
  color: var(--gold);
  margin-top: 4rpx;
}

/* ===== 连击记录卡 ===== */
.streak-card {
  background: var(--white);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
  padding: 32rpx 28rpx;
  margin-bottom: 40rpx;
}
.streak-top {
  display: flex;
  align-items: stretch;
  margin-bottom: 32rpx;
}
.streak-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.streak-divider {
  width: 2rpx;
  background: var(--line);
  margin: 0 24rpx;
}
.streak-label {
  font-size: 24rpx;
  color: var(--ink-soft);
}
.streak-num-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}
.streak-num {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--brand-strong);
  line-height: 1;
}
.streak-num-unit {
  font-size: 26rpx;
  color: var(--ink-soft);
}

.streak-week {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 4rpx 0;
}
.streak-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.streak-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(122, 78, 43, 0.06);
  transition: transform 200ms var(--ease-bounce);
}
.streak-dot image { width: 28rpx; height: 28rpx; }
.streak-day.on .streak-dot {
  box-shadow: 0 4rpx 14rpx rgba(200, 149, 110, 0.36);
}
.streak-day-label {
  font-size: 20rpx;
  color: var(--ink-faint);
}

/* ===== 统计数据网格 ===== */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 40rpx;
}
.stats-cell {
  width: calc(50% - 8rpx);
  background: var(--white);
  border-radius: var(--radius-lg);
  border: var(--border);
  box-shadow: var(--shadow-card);
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}
.stats-value {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1;
}
.stats-value-sub {
  font-size: 22rpx;
  color: var(--ink-faint);
  margin-top: -4rpx;
}
.stats-label {
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-top: 4rpx;
}

.bottom-spacer { height: 80rpx; }
