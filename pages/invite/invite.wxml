<view class="page-container paper-texture">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

  <view class="nav-header" style="{{navHeaderStyle}}">
    <view class="nav-header-back" bindtap="goBack">
      <image src="/assets/icons/chevron-left-ink.svg" mode="aspectFit"></image>
    </view>
    <text class="nav-header-title">邀请好友</text>
  </view>

  <scroll-view scroll-y class="page-scroll" style="height: calc(100vh - {{statusBarHeight}}px - 72rpx);">

    <!-- Hero -->
    <view class="invite-hero">
      <text class="hero-title">邀请朋友，一起出逃</text>
      <text class="hero-sub">开启双人模式，把一个人的漫游变成两个人的冒险</text>
    </view>

    <!-- Polaroid 邀请卡预览 -->
    <view class="polaroid">
      <view class="polaroid-inner">
        <view class="polaroid-head">
          <text class="polaroid-name">{{escapeName}}</text>
          <text class="polaroid-code">邀请码 · {{escapeCode}}</text>
        </view>
        <view class="polaroid-command">
          <text class="command-label">今日双人指令</text>
          <text class="command-text">{{sampleCommand}}</text>
        </view>
        <view class="qr-mini">
          <view wx:for="{{qrMiniGrid}}" wx:key="index" class="qr-mini-cell {{item ? 'on' : ''}}"></view>
        </view>
        <text class="polaroid-footer">扫码加入 TA 的出逃计划</text>
      </view>
    </view>

    <!-- 三种分享方式 -->
    <view class="share-row">
      <button class="share-method" open-type="share">
        <image class="share-ico" src="/assets/icons/share-2-ink-soft.svg" mode="aspectFit"></image>
        <text class="share-label">微信好友</text>
      </button>
      <view class="share-method" bindtap="generatePoster">
        <image class="share-ico" src="/assets/icons/camera-ink-soft.svg" mode="aspectFit"></image>
        <text class="share-label">生成海报</text>
      </view>
      <view class="share-method" bindtap="copyInviteCode">
        <image class="share-ico" src="/assets/icons/bookmark.svg" mode="aspectFit"></image>
        <text class="share-label">复制邀请码</text>
      </view>
    </view>

    <!-- 邀请统计 -->
    <view class="stats-card">
      <view class="stat-cell">
        <text class="stat-num">{{invitedCount}}</text>
        <text class="stat-label">已邀请</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-cell">
        <text class="stat-num">{{escapeCount}}</text>
        <text class="stat-label">成功出逃</text>
      </view>
    </view>

    <!-- 兼容二维码 -->
    <view class="qr-section">
      <text class="section-label">我的邀请二维码</text>
      <view class="qr-card">
        <view class="qr-grid">
          <view wx:for="{{qrGrid}}" wx:key="index" class="qr-cell {{item ? 'on' : ''}}"></view>
        </view>
        <text class="qr-code-display">{{escapeCode}}</text>
        <text class="qr-tip">让朋友扫一扫，加入你的出逃计划</text>
      </view>
    </view>

    <!-- 邀请规则 -->
    <view class="rules-section">
      <text class="section-label">邀请规则</text>
      <view class="rules-card">
        <view class="rule-row">
          <view class="rule-num"><text class="rule-num-text">1</text></view>
          <view class="rule-text">
            <text class="rule-title">分享邀请码</text>
            <text class="rule-desc">把邀请码或海报发给朋友，TA 即可加入你的双人出逃。</text>
          </view>
        </view>
        <view class="rule-row">
          <view class="rule-num"><text class="rule-num-text">2</text></view>
          <view class="rule-text">
            <text class="rule-title">共同完成指令</text>
            <text class="rule-desc">两人各自领取同一份双人指令，一起出发、一起记录。</text>
          </view>
        </view>
        <view class="rule-row">
          <view class="rule-num"><text class="rule-num-text">3</text></view>
          <view class="rule-text">
            <text class="rule-title">解锁双人徽章</text>
            <text class="rule-desc">完成 5 次双人出逃即可解锁「双人冒险家」徽章。</text>
          </view>
        </view>
      </view>
    </view>

    <view class="bottom-spacer"></view>
  </scroll-view>
</view>
