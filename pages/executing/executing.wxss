/* v4 重构：步骤改手动完成 + 必须 4 步全完才能跳；圆角统一收紧 */
.executing-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

.status-bar { flex-shrink: 0; }

.ex-scroll {
  flex: 1;
  height: 0;
  /* 顶部呼吸距离：避免计时卡/勇气卡压住 nav-header-divider（项目规范：内容区 32rpx） */
  padding-top: 32rpx;
  padding-left: 40rpx;
  padding-right: 40rpx;
}

/* 卡片通用 */
.timer-card,
.step-card,
.photo-card,
.tip-card,
.step-count-card {
  background: var(--white);
  border: var(--border);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-card);
  padding: 32rpx 40rpx;
  margin-bottom: 20rpx;
}

/* 计时卡 */
.timer-head {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.timer-label {
  font-size: 28rpx;
  color: var(--ink-soft);
}

.timer-num {
  font-size: 60rpx;
  font-weight: 700;
  color: var(--brand);
  line-height: 1.1;
  font-family: var(--serif);
}

.timer-unit {
  font-size: 28rpx;
  color: var(--ink-soft);
}

.progress-bar-bg {
  margin-top: 20rpx;
  height: 20rpx;
  border-radius: var(--radius-pill);
  overflow: hidden;
  background: var(--line);
}

.progress-bar-fill {
  height: 100%;
  border-radius: var(--radius-pill);
  background: var(--brand);
  transition: width 500ms var(--ease-standard);
}

.timer-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
}

/* v3: 步数统计卡 */
.step-count-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.step-count-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md);
  background: var(--brand-tint);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step-count-icon image { width: 40rpx; height: 40rpx; }

.step-count-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.step-count-label {
  font-size: 24rpx;
  color: var(--ink-soft);
}

.step-count-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.2;
  font-family: var(--serif);
}

/* 步骤卡 */
.step-card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 20rpx;
  font-family: var(--serif);
}

.step-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 12rpx;
  position: relative;
  transition: all 250ms var(--ease-standard);
}

.step-row + .step-row { border-top: 2rpx solid var(--line); }

/* v4: 步骤编号 —— 16rpx 圆角矩形 */
.step-mark {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--canvas);
  color: var(--ink-faint);
  border: 2rpx solid var(--line);
  transition: all 250ms var(--ease-standard);
}

.step-mark-num {
  font-size: 24rpx;
  font-weight: 700;
  font-family: "SF Mono", "Menlo", "Consolas", monospace;
  line-height: 1;
}

.step-mark-check {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--white);
  line-height: 1;
}

/* 已完成态：类型色底 + 白字 */
.step-row.finished .step-mark {
  background: var(--step-color, var(--brand));
  border-color: var(--step-color, var(--brand));
  color: var(--white);
}

/* 进行中态：脉冲 + 类型色描边 */
.step-row.current .step-mark {
  background: var(--white);
  border-color: var(--step-color, var(--brand));
  color: var(--step-color, var(--brand));
  animation: stepPulse 1400ms ease-in-out infinite;
}

.step-row.current {
  background: var(--brand-tint);
  border-radius: var(--radius-md);
  margin: 0 -12rpx;
  padding: 20rpx 12rpx;
}

@keyframes stepPulse {
  0%, 100% { box-shadow: 0 0 0 0 var(--step-color, rgba(91, 143, 185, 0.4)); }
  50% { box-shadow: 0 0 0 12rpx rgba(91, 143, 185, 0); }
}

/* 步骤内容 */
.step-content { flex: 1; display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }
.step-label { font-size: 22rpx; color: var(--ink-faint); }
.step-text { font-size: 28rpx; color: var(--ink); line-height: 1.5; word-break: break-word; overflow-wrap: break-word; }
.step-row.current .step-text { color: var(--brand-dark); font-weight: 600; }
.step-row.finished .step-text { color: var(--ink-soft); text-decoration: line-through; text-decoration-color: var(--ink-faint); }

/* v4: 完成按钮（步骤行右侧） */
.step-finish-btn {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 56rpx;
  padding: 0 24rpx;
  background: var(--brand);
  color: var(--white);
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  transition: all 200ms var(--ease-standard);
  box-shadow: 0 2rpx 8rpx rgba(91, 143, 185, 0.32);
}

.step-finish-ico {
  width: 24rpx;
  height: 24rpx;
}

.step-finish-arrow {
  font-size: 24rpx;
  line-height: 1;
}

.step-finish-btn:active {
  background: var(--brand-dark);
  transform: scale(0.94);
  box-shadow: 0 1rpx 4rpx rgba(91, 143, 185, 0.24);
}

/* v4: 已完成右侧勾标 */
.step-done-mark {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-done-mark image {
  width: 100%;
  height: 100%;
}

/* 拍照卡 */
.photo-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.photo-title { font-size: 30rpx; font-weight: 600; color: var(--ink); font-family: var(--serif); }
.photo-count { font-size: 24rpx; color: var(--ink-soft); }

/* v3: 横向滚动缩略图条 */
.photo-list {
  margin-top: 20rpx;
  white-space: nowrap;
}

.photo-thumb, .photo-add {
  display: inline-block;
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--canvas);
  vertical-align: top;
  margin-right: 12rpx;
}

.photo-thumb {
  box-shadow: var(--shadow-card);
  transition: transform 150ms var(--ease-standard);
}

.photo-thumb:active { transform: scale(0.95); }
.photo-thumb image { width: 100%; height: 100%; }

.photo-add {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
  border: 4rpx dashed var(--ink-faint);
  opacity: 0.4;
  transition: all 200ms var(--ease-standard);
}

.photo-add:active {
  background: var(--brand-tint);
  border-color: var(--brand);
  opacity: 1;
  transform: scale(0.97);
}

.photo-add image { width: 48rpx; height: 48rpx; }

/* 小贴士 */
.tip-card { background: linear-gradient(135deg, var(--brand-weak) 0%, var(--white) 100%); }

.tip-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tip-icon-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--brand);
}

.tip-label { font-size: 22rpx; font-weight: 400; color: var(--brand-dark); }
.tip-text { display: block; margin-top: 8rpx; font-size: 28rpx; color: var(--ink-soft); line-height: 1.5; word-break: break-word; overflow-wrap: break-word; }

/* 完成按钮：底部安全区 */
.ex-actions {
  padding: 24rpx 40rpx calc(var(--safe-bottom, 0px) + var(--tabbar-floating-height) + var(--tabbar-bottom-gap));
  background: var(--canvas);
  box-shadow: 0 -4rpx 16rpx rgba(45, 90, 123, 0.05);
}

.finish-btn {
  width: 100%;
  height: 104rpx;
  border-radius: var(--radius-xl);
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
  color: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  transition: all 200ms var(--ease-standard);
  box-shadow: var(--shadow-btn);
}

.finish-btn:active {
  background: var(--brand-dark);
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(91, 143, 185, 0.24);
}

.finish-btn.disabled {
  background: var(--line);
  color: var(--ink-faint);
  box-shadow: none;
}

.finish-btn.disabled:active {
  background: var(--line);
  transform: none;
  box-shadow: none;
}

.finish-btn image { width: 36rpx; height: 36rpx; }
.bottom-spacer { height: calc(24rpx + var(--safe-bottom)); }

/* ===== 破圈模式专属样式 ===== */
.bt-courage-card {
  background: linear-gradient(135deg, #F0EAF8, #F8F4FC);
  border: 2rpx solid #9B7BB8;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-card);
  padding: 36rpx 40rpx;
  margin-bottom: 24rpx;
}
.bt-courage-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}
.bt-courage-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #7B3FAF;
  font-family: var(--serif);
}
.bt-courage-count {
  font-size: 40rpx;
  font-weight: 700;
  color: #9B7BB8;
  font-family: var(--serif);
}
.bt-courage-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #A55FA5;
  text-align: center;
}
.bt-courage-steps {
  display: flex;
  justify-content: center;
  gap: 28rpx;
}
.bt-courage-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  background: var(--brand-weak);
  color: var(--ink-faint);
  border: 2rpx solid var(--border-soft);
}
.bt-courage-dot.done {
  background: #9B7BB8;
  color: #FFFFFF;
  border-color: #9B7BB8;
}
.bt-courage-dot.current {
  border-color: #A55FA5;
  color: #A55FA5;
  animation: btPulse 1400ms ease-in-out infinite;
}
@keyframes btPulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(165, 95, 165, 0.4); }
  50% { box-shadow: 0 0 0 16rpx rgba(165, 95, 165, 0); }
}

/* 破圈步骤行：竖向布局，更多呼吸空间 */
.step-row.current .bt-step-badge {
  background: #FFFFFF;
  border-color: #A55FA5;
  color: #A55FA5;
}

/* 破圈步骤专属布局：从flex row改成flex column让文字不拥挤 */
.step-row.bt-step-row {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
  padding: 28rpx 20rpx;
}
.step-row.bt-step-row .step-row-inner {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  width: 100%;
}
.step-row.bt-step-row .step-finish-btn {
  margin-top: 8rpx;
  align-self: center;
  width: 100%;
  justify-content: center;
}

/* 破圈步骤标签 */
.bt-step-badge {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  background: #F3E8FF;
  border: 2rpx solid #9B7BB8;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #7B3FAF;
  text-align: center;
  white-space: nowrap;
}
.step-row.bt-step-row.finished .bt-step-badge {
  background: #9B7BB8;
  border-color: #9B7BB8;
  color: #FFFFFF;
}
.step-row.bt-step-row.finished .step-text {
  text-decoration: line-through;
  text-decoration-color: var(--ink-faint);
}
.step-row.bt-step-row.current {
  background: #F8F0FF;
  border-radius: var(--radius-md);
  margin: 0 -8rpx;
  padding: 24rpx 28rpx;
}

/* 破圈tip图标 */
.tip-icon-dot.bt {
  background: #9B7BB8;
}

/* ===== B-安全: 安全提示卡（PRD §15） ===== */
.safety-card {
  background: var(--white);
  border: var(--border);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-card);
  padding: 28rpx 32rpx 24rpx;
  margin-bottom: 20rpx;
}

/* 三档视觉：info 蓝灰 / warn 琥珀 / danger 警示红 */
.safety-card.safety-info {
  background: linear-gradient(135deg, var(--brand-weak) 0%, var(--white) 60%);
  border-color: rgba(91, 143, 185, 0.25);
}
.safety-card.safety-warn {
  background: linear-gradient(135deg, #FFF6E8 0%, var(--white) 60%);
  border-color: #E8C896;
}
.safety-card.safety-danger {
  background: linear-gradient(135deg, #FFEFEC 0%, var(--white) 60%);
  border-color: #E8B4AE;
}

.safety-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.safety-icon-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--brand);
  flex-shrink: 0;
}

.safety-card.safety-warn .safety-icon-dot { background: var(--warning); }
.safety-card.safety-danger .safety-icon-dot { background: var(--danger); }

.safety-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
  font-family: var(--serif);
}

.safety-card.safety-warn .safety-title { color: #A66A38; }
.safety-card.safety-danger .safety-title { color: #B5522E; }

.safety-text {
  display: block;
  font-size: 26rpx;
  color: var(--ink-soft);
  line-height: 1.55;
  word-break: break-word;
  overflow-wrap: break-word;
}

/* 安全操作按钮：分享位置 / 紧急退出 并排 */
.safety-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 18rpx;
}

.safety-btn {
  flex: 1;
  height: 64rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  transition: all 200ms var(--ease-standard);
}

.safety-btn.share {
  background: var(--brand-tint);
  color: var(--brand-dark);
  border: 2rpx solid var(--brand);
}

.safety-btn.share:active {
  transform: scale(0.97);
  background: var(--brand);
  color: var(--white);
}

.safety-btn.exit {
  background: var(--danger-tint);
  color: var(--danger);
  border: 2rpx solid rgba(224, 85, 85, 0.3);
}

.safety-btn.exit:active {
  transform: scale(0.97);
  background: var(--danger);
  color: var(--white);
  border-color: var(--danger);
}

/* 破圈完成按钮紫色 */
.finish-btn.bt-purple {
  background: linear-gradient(135deg, #9B7BB8, #7B3FAF);
  box-shadow: 0 4rpx 16rpx rgba(123,63,175,0.3);
}
.finish-btn.bt-purple:active {
  background: linear-gradient(135deg, #8A6BA8, #6B3095);
}

/* ===== B1 安全合规：安全工具栏（含紧急退出） ===== */
.safety-toolbar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.safety-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 12rpx;
  background: var(--white);
  border: 1rpx solid var(--border-soft);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-card);
  transition: all 200ms var(--ease-standard);
}

.safety-btn:active {
  transform: scale(0.97);
  background: var(--brand-tint);
}

.safety-btn image {
  width: 32rpx;
  height: 32rpx;
}

.safety-btn text {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--ink);
  letter-spacing: 1rpx;
}

/* 紧急退出按钮：红色强调 */
.safety-exit-btn {
  background: #FFF6F6;
  border-color: rgba(224, 85, 85, 0.3);
}

.safety-exit-btn text {
  color: #E05555;
}

.safety-exit-btn:active {
  background: #FFECEC;
  transform: scale(0.97);
}

/* ===== B2 阶段感设计 ===== */
.step-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.step-card-phase-tag {
  font-size: 22rpx;
  color: var(--ink-soft);
  background: var(--brand-tint);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-pill);
  letter-spacing: 1rpx;
}

.step-card-phase-tag.arrived {
  background: var(--heal-tint);
  color: var(--success);
}

/* 到达确认按钮 */
.arrive-confirm-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, var(--success), #3A8C6F);
  border-radius: var(--radius-xl);
  box-shadow: 0 4rpx 16rpx rgba(92, 191, 158, 0.3);
  transition: all 200ms var(--ease-standard);
  animation: arrivePulse 2s ease-in-out infinite;
}

.arrive-confirm-btn:active {
  transform: scale(0.97);
}

.arrive-confirm-btn image {
  width: 36rpx;
  height: 36rpx;
}

.arrive-confirm-btn text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--white);
  letter-spacing: 2rpx;
}

@keyframes arrivePulse {
  0%, 100% { box-shadow: 0 4rpx 16rpx rgba(92, 191, 158, 0.3); }
  50% { box-shadow: 0 4rpx 24rpx rgba(92, 191, 158, 0.5); }
}

/* 完成仪式感动画 */
.finish-btn.celebrate {
  animation: celebrate 0.6s ease-out;
}

@keyframes celebrate {
  0% { transform: scale(1); }
  30% { transform: scale(1.08); }
  60% { transform: scale(0.96); }
  100% { transform: scale(1); }
}
