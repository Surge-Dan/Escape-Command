.status-bar { flex-shrink: 0; }

.page-scroll {
  padding: 0 40rpx;
  box-sizing: border-box;
}

/* ===== Hero ===== */
.partner-hero {
  padding: 32rpx 8rpx 28rpx;
  text-align: center;
}

.hero-num {
  display: block;
  font-size: 72rpx;
  font-weight: 700;
  color: var(--brand-dark);
  font-family: "SF Mono", "Menlo", "Consolas", monospace;
  line-height: 1.1;
}

.hero-label {
  display: block;
  font-size: 26rpx;
  color: var(--ink-soft);
  margin-top: 12rpx;
}

/* ===== 统计汇总 ===== */
.stats-summary {
  display: flex;
  align-items: center;
  background: var(--white);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
  padding: 28rpx 0;
  margin-bottom: 32rpx;
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.stat-cell-name {
  padding: 0 12rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--brand-dark);
  font-family: "SF Mono", "Menlo", "Consolas", monospace;
}

.stat-num-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-label {
  font-size: 22rpx;
  color: var(--ink-soft);
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: var(--line);
}

/* ===== 空态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-ico {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-bottom: 32rpx;
}

.empty-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 48rpx;
  background: var(--brand);
  color: var(--white);
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: 600;
  transition: all 150ms var(--ease-standard);
}

.empty-btn:active {
  background: var(--brand-dark);
  transform: scale(0.97);
}

/* ===== 搭档卡片 ===== */
.partner-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.partner-card {
  display: flex;
  align-items: center;
  background: var(--white);
  border-radius: var(--radius-xl);
  border: var(--border);
  box-shadow: var(--shadow-card);
  padding: 24rpx 28rpx;
  transition: transform 150ms var(--ease-standard), background 150ms var(--ease-standard);
}

.partner-card:active {
  transform: scale(0.97);
  background: var(--brand-weak);
}

.rank-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.rank-badge-text {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--white);
}

.rank-gold {
  background: linear-gradient(135deg, #FFE08A, var(--gold));
  box-shadow: 0 2rpx 8rpx rgba(201, 176, 55, 0.3);
}

.rank-silver {
  background: linear-gradient(135deg, #E4E8EE, #B7BFCB);
  box-shadow: 0 2rpx 8rpx rgba(154, 168, 186, 0.3);
}

.rank-bronze {
  background: linear-gradient(135deg, #F0C9A6, #C08856);
  box-shadow: 0 2rpx 8rpx rgba(192, 136, 86, 0.3);
}

.rank-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--canvas);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.rank-num-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-faint);
}

.partner-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: var(--brand-tint);
  border: 2rpx solid var(--white);
}

.partner-info {
  flex: 1;
  min-width: 0;
}

.partner-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.partner-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  margin-right: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mode-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.partner-meta {
  font-size: 22rpx;
  color: var(--ink-soft);
}

.arrow-ico {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.bottom-spacer { height: 64rpx; }
