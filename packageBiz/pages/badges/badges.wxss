.status-bar { flex-shrink: 0; }

.badges-scroll {
  padding: 0 32rpx;
  box-sizing: border-box;
}

/* ===== 进度概览 ===== */
.badges-progress {
  text-align: center;
  padding: 24rpx 0 12rpx;
}

.progress-text {
  font-size: 28rpx;
  color: var(--ink-soft);
  margin-bottom: 16rpx;
}

.progress-text .num {
  font-size: 40rpx;
  color: var(--brand);
  font-weight: 600;
}

.progress-bar-wrap {
  width: 320rpx;
  height: 10rpx;
  background: var(--brand-tint);
  border-radius: 10rpx;
  margin: 0 auto;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, var(--brand), var(--brand-dark));
  border-radius: 10rpx;
  transition: width 0.5s var(--ease-standard);
}

/* ===== 分组 ===== */
.badge-section {
  margin-top: 32rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  position: relative;
  padding-left: 16rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 24rpx;
  background: var(--brand);
  border-radius: 4rpx;
}

.section-count {
  font-size: 24rpx;
  color: var(--ink-faint);
}

/* ===== 徽章网格 ===== */
.badge-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 0 4rpx;
}

.badge-item {
  width: calc((100% - 40rpx) / 3);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  background: var(--white);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  transition: transform 200ms var(--ease-standard);
  animation: badgeFadeIn 400ms var(--ease-standard) backwards;
}

@keyframes badgeFadeIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.badge-item:active { transform: scale(0.96); }
.badge-item.locked { opacity: 0.55; }

.badge-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  background: var(--canvas);
  box-shadow: var(--shadow-float);
}

.badge-item.unlocked .badge-icon-wrap {
  /* gradient is set inline */
  box-shadow: var(--shadow-elevated);
}

.badge-icon { width: 48rpx; height: 48rpx; }

.badge-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
  text-align: center;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.badge-date {
  font-size: 20rpx;
  color: var(--ink-faint);
  margin-top: 4rpx;
}

.bottom-spacer {
  height: 64rpx;
}
