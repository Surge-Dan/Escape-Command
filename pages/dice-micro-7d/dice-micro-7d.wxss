/* pages/dice-micro-7d/dice-micro-7d.wxss */
/* 微逃骰子（7 维度版）- 条件选择页样式 */

.page {
  min-height: 100vh;
  background: #f7f5f0;
  padding: 0 32rpx 200rpx;
  box-sizing: border-box;
}

.hero {
  padding: 80rpx 0 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.hero__tag {
  font-size: 20rpx;
  color: #d4a574;
  letter-spacing: 6rpx;
  margin-bottom: 32rpx;
  font-weight: 500;
}

.hero__dice {
  font-size: 80rpx;
  margin-bottom: 40rpx;
  line-height: 1;
}

.hero__dice--rolling {
  animation: diceShake 0.5s ease-in-out infinite;
}

@keyframes diceShake {
  0%, 100% { transform: rotate(0deg) scale(1); }
  25% { transform: rotate(-15deg) scale(0.9); }
  75% { transform: rotate(15deg) scale(1.1); }
}

.hero__title {
  font-size: 56rpx;
  color: #1a1f2e;
  font-weight: 600;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.hero__desc {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.5;
  padding: 0 40rpx;
}

.form {
  margin-top: 40rpx;
}

.form-group {
  margin-bottom: 44rpx;
}

.form-group__label {
  display: flex;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.form-group__label-text {
  font-size: 30rpx;
  color: #1a1f2e;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.form-group__required {
  font-size: 26rpx;
  color: #d4a574;
  margin-left: 8rpx;
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 2rpx solid #e5e7eb;
  transition: all 0.2s ease;
}

.chip--hover {
  transform: scale(0.96);
  opacity: 0.9;
}

.chip__text {
  font-size: 26rpx;
  color: #1a1f2e;
  font-weight: 500;
}

.chip--active {
  background: #1a1f2e;
  border-color: #1a1f2e;
  box-shadow: 0 6rpx 20rpx rgba(26, 31, 46, 0.2);
}

.chip--active .chip__text {
  color: #f7f5f0;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(247, 245, 240, 0) 0%, #f7f5f0 30%);
  pointer-events: none;
}

.cta,
.footer__hint {
  pointer-events: auto;
}

.cta {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1a1f2e 0%, #2d3548 100%);
  box-shadow: 0 12rpx 32rpx rgba(26, 31, 46, 0.3);
  transition: all 0.2s ease;
}

.cta--hover {
  transform: scale(0.98);
  opacity: 0.95;
}

.cta--disabled {
  background: #d1d5db;
  box-shadow: none;
}

.cta--rolling {
  background: linear-gradient(135deg, #d4a574 0%, #e8c9a0 100%);
  box-shadow: 0 12rpx 32rpx rgba(212, 165, 116, 0.4);
}

.cta__icon {
  font-size: 36rpx;
  margin-right: 12rpx;
  line-height: 1;
}

.cta__text {
  font-size: 30rpx;
  color: #f7f5f0;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.cta--disabled .cta__icon,
.cta--disabled .cta__text {
  color: #9ca3af;
}

.footer__hint {
  text-align: center;
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 16rpx;
  letter-spacing: 1rpx;
}
