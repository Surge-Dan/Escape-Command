<view class="page-container group-room-page">
  <!-- 统一导航栏：标题居中 + 底部 1rpx 分割线 -->
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  <view class="nav-header" style="{{navHeaderStyle}}">
    <view class="nav-header-back" bindtap="onBackTap">
      <image src="/assets/icons/chevron-left-ink.svg" mode="aspectFit"></image>
    </view>
    <text class="nav-header-title">同频组局</text>
    <view class="nav-header-divider"></view>
  </view>

  <!-- loading -->
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading-dot"></view>
    <view class="loading-dot"></view>
    <view class="loading-dot"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 房间不存在 -->
  <view wx:if="{{!loading && !room}}" class="empty-container">
    <text class="empty-text">房间不存在或已关闭</text>
    <view class="empty-back-btn" bindtap="onBackTap">返回首页</view>
  </view>

  <!-- 房间内容 -->
  <scroll-view wx:if="{{!loading && room}}" scroll-y class="room-scroll" enhanced show-scrollbar="{{false}}">

    <!-- ===== 顶部信息（所有阶段都显示）===== -->
    <view class="room-hero">
      <text class="room-id-label" bindtap="onCopyRoomId">{{room.roomId}}</text>
      <text class="room-id-hint">{{isHostView ? '点击复制' : '你已加入'}}</text>
      <text class="room-topic">{{room.topic}}</text>
      <view class="room-meta">
        <view class="room-status-tag" style="background: {{statusColor}}1A; color: {{statusColor}};">
          <view class="status-dot" style="background: {{statusColor}};"></view>
          <text>{{statusText}}</text>
        </view>
        <text class="room-max-members">{{room.maxMembers}} 人组局</text>
      </view>
      <!-- C-P3 联动：任务大厅出逃地点（仅来自任务大厅时展示） -->
      <view wx:if="{{hallPoi && hallPoi.name}}" class="room-poi">
        <text class="room-poi-label">出逃地点</text>
        <text class="room-poi-name">{{hallPoi.name}}</text>
        <text wx:if="{{hallPoi.address}}" class="room-poi-address">{{hallPoi.address}}</text>
      </view>
    </view>

    <!-- ===== 阶段 1: 等待成员 ===== -->
    <view wx:if="{{room.status === 'waiting_members'}}" class="stage-section">

      <!-- 成员位 -->
      <view class="members-section">
        <text class="section-title">成员（{{membersCount}}/{{room.maxMembers}}）</text>
        <view class="members-grid">
          <view wx:for="{{memberSlots}}" wx:key="index" class="member-slot {{item.nickname ? 'filled' : 'empty'}}">
            <view wx:if="{{item.nickname}}" class="member-avatar" style="background: {{item.isHost ? '#5CBF9E' : '#D98A5C'}};">
              <text wx:if="{{item.isHost}}" class="member-icon">★</text>
              <text wx:else class="member-icon">●</text>
            </view>
            <view wx:else class="member-avatar empty-avatar">
              <text class="member-icon">?</text>
            </view>
            <text class="member-name">{{item.nickname || '等待加入'}}</text>
          </view>
        </view>
        <view class="waiting-hint">
          <text class="waiting-dot">·</text>
          <text class="waiting-dot">·</text>
          <text class="waiting-dot">·</text>
          <text class="waiting-text">{{isHostView ? '等待朋友加入...' : '等待其他朋友...'}}</text>
        </view>
      </view>

      <!-- host 操作区 -->
      <view wx:if="{{isHostView}}" class="actions-section">
        <!-- v11: 邀请按钮降级 —— 个人小程序无 open-type=share 权限，改为弹窗让用户复制房间号 -->
        <view class="invite-btn" bindtap="onInviteTap" hover-class="none">
          <text class="invite-icon">↗</text>
          <text>邀请朋友</text>
        </view>

        <view wx:if="{{!allMembersReady}}" class="demo-actions">
          <view class="demo-btn" bindtap="onAddMockMember">+ 模拟1人加入</view>
          <view class="demo-btn outline" bindtap="onFillMockMembers">一键到齐</view>
        </view>

        <!-- C-09: 人齐了，开始（>=2 人可点，未满员也可确认进入小队模式）-->
        <view class="start-vote-btn {{membersCount < 2 ? 'disabled' : ''}}" bindtap="onConfirmReady">
          <text>人齐了，开始</text>
          <text class="arrow">→</text>
        </view>
        <view wx:if="{{membersCount < 2}}" class="vote-hint">至少 2 人才能开始</view>

        <view class="cancel-btn" bindtap="onCancelTap">{{cancelling ? '取消中...' : '取消组局'}}</view>
      </view>

      <!-- 成员操作区 -->
      <view wx:else class="actions-section">
        <view class="invite-btn" bindtap="onInviteTap" hover-class="none">
          <text class="invite-icon">↗</text>
          <text>也邀请其他朋友</text>
        </view>
        <view class="cancel-btn" bindtap="onExitRoom">退出房间</view>
      </view>
    </view>

    <!-- ===== 阶段 1.5: 已到齐，等待开始投票（C-09 READY）===== -->
    <view wx:if="{{room.status === 'ready'}}" class="stage-section">
      <view class="ready-banner">
        <text class="ready-title">人已到齐</text>
        <text class="ready-sub">{{membersCount}} 位朋友就位，可以开始投票了</text>
      </view>

      <view class="members-grid">
        <view wx:for="{{memberSlots}}" wx:key="index" class="member-slot {{item.nickname ? 'filled' : 'empty'}}">
          <view wx:if="{{item.nickname}}" class="member-avatar" style="background: {{item.isHost ? '#5CBF9E' : '#D98A5C'}};">
            <text wx:if="{{item.isHost}}" class="member-icon">★</text>
            <text wx:else class="member-icon">●</text>
          </view>
          <view wx:else class="member-avatar empty-avatar">
            <text class="member-icon">?</text>
          </view>
          <text class="member-name">{{item.nickname || '等待加入'}}</text>
        </view>
      </view>

      <view wx:if="{{isHostView}}" class="actions-section">
        <view class="start-vote-btn" bindtap="onStartVoting">
          <text>开始投票</text>
          <text class="arrow">→</text>
        </view>
        <view class="cancel-btn" bindtap="onCancelTap">{{cancelling ? '取消中...' : '取消组局'}}</view>
      </view>
      <view wx:else class="actions-section">
        <view class="cancel-btn" bindtap="onExitRoom">退出房间</view>
      </view>
    </view>

    <!-- ===== 阶段 2: 投票中 ===== -->
    <view wx:if="{{room.status === 'voting'}}" class="stage-section">

      <!-- C-04: 匿名偏好提交 -->
      <view class="preference-section">
        <text class="section-title">你的偏好（匿名）</text>
        <text class="section-subtitle">选 1-3 个你感兴趣的方向</text>
        <view class="interest-grid">
          <view wx:for="{{preferenceOptions.interests}}" wx:key="value"
                class="interest-tag {{interestSelectedMap[item.value] ? 'selected' : ''}}"
                data-value="{{item.value}}"
                bindtap="onPreferenceInterestTap">
            <text>{{item.label}}</text>
          </view>
        </view>

        <text class="section-subtitle" style="margin-top: 32rpx;">出逃强度</text>
        <view class="intensity-row">
          <view wx:for="{{preferenceOptions.intensity}}" wx:key="value"
                class="intensity-tag {{myPreference.intensity === item.value ? 'selected' : ''}}"
                data-value="{{item.value}}"
                bindtap="onPreferenceIntensityTap">
            <text>{{item.label}}</text>
          </view>
        </view>

        <view class="submit-pref-btn" bindtap="onSubmitPreference">提交偏好</view>
      </view>

      <!-- C-05: 时间投票 -->
      <view class="vote-card">
        <text class="vote-title">出逃时间</text>
        <view class="vote-options">
          <view wx:for="{{voteOptions.time}}" wx:key="value"
                class="vote-option {{myVotes.time === item.value ? 'selected' : ''}}"
                data-value="{{item.value}}"
                bindtap="onVoteTime">
            <text class="vote-option-icon">{{item.icon}}</text>
            <text class="vote-option-label">{{item.label}}</text>
            <text wx:if="{{voteStats && voteStats.time[item.value]}}" class="vote-count">{{voteStats.time[item.value]}}票</text>
          </view>
        </view>
      </view>

      <!-- C-06: 预算投票 -->
      <view class="vote-card">
        <text class="vote-title">出逃预算</text>
        <view class="vote-options">
          <view wx:for="{{voteOptions.budget}}" wx:key="value"
                class="vote-option {{myVotes.budget === item.value ? 'selected' : ''}}"
                data-value="{{item.value}}"
                bindtap="onVoteBudget">
            <text class="vote-option-label">{{item.label}}</text>
            <text class="vote-option-desc">{{item.desc}}</text>
            <text wx:if="{{voteStats && voteStats.budget[item.value]}}" class="vote-count">{{voteStats.budget[item.value]}}票</text>
          </view>
        </view>
      </view>

      <!-- C-07: 风格投票 -->
      <view class="vote-card">
        <text class="vote-title">出逃风格</text>
        <view class="vote-options">
          <view wx:for="{{voteOptions.style}}" wx:key="value"
                class="vote-option {{myVotes.style === item.value ? 'selected' : ''}}"
                data-value="{{item.value}}"
                bindtap="onVoteStyle">
            <text class="vote-option-label">{{item.label}}</text>
            <text class="vote-option-desc">{{item.desc}}</text>
            <text wx:if="{{voteStats && voteStats.style[item.value]}}" class="vote-count">{{voteStats.style[item.value]}}票</text>
          </view>
        </view>
      </view>

      <!-- 投票进度 -->
      <view class="vote-progress">
        <text class="progress-text">投票进度 {{voteStats ? voteStats.votedMembers : 0}} / {{membersCount}}</text>
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{voteStats ? (membersCount > 0 ? (voteStats.votedMembers / membersCount * 100) : 0) : 0}}%;"></view>
        </view>
      </view>

      <!-- 生成剧本 -->
      <view wx:if="{{allVoted && isHostView}}" class="generate-btn {{generatingScript ? 'disabled' : ''}}" bindtap="onGenerateScript">
        <text>{{generatingScript ? '生成中...' : '生成出逃剧本'}}</text>
        <text wx:if="{{!generatingScript}}" class="arrow">→</text>
      </view>
      <view wx:if="{{!allVoted}}" class="vote-hint">等待所有人完成投票后可生成剧本</view>
    </view>

    <!-- ===== 阶段 3: 剧本已生成 ===== -->
    <view wx:if="{{room.status === 'finished' && script}}" class="stage-section script-stage">

      <view class="script-card">
        <view class="script-badge">出逃剧本</view>
        <text class="script-title">{{script.title}}</text>

        <view class="script-meta">
          <view class="meta-item">
            <text class="meta-label">时长</text>
            <text class="meta-value">{{script.duration}} 分钟</text>
          </view>
          <view class="meta-item">
            <text class="meta-label">预算</text>
            <text class="meta-value">{{script.budgetLabel}}</text>
          </view>
          <view class="meta-item">
            <text class="meta-label">风格</text>
            <text class="meta-value">{{script.styleLabel}}</text>
          </view>
          <view class="meta-item">
            <text class="meta-label">时间</text>
            <text class="meta-value">{{script.timeLabel}}</text>
          </view>
        </view>

        <view class="script-steps">
          <text class="steps-title">出逃步骤</text>
          <view wx:for="{{script.steps}}" wx:key="index" class="step-item">
            <view class="step-num">{{index + 1}}</view>
            <text class="step-text">{{item}}</text>
          </view>
        </view>

        <view class="script-members">
          <text class="steps-title">一起出逃的人</text>
          <view class="script-members-row">
            <text wx:for="{{script.members}}" wx:key="index" class="script-member-tag">{{item}}</text>
          </view>
        </view>
      </view>

      <view class="script-cta">
        <view class="start-escape-btn" bindtap="onStartEscape">
          <text>确认剧本，开始出逃</text>
          <text class="arrow">→</text>
        </view>
      </view>

      <!-- C-12: 本次同频出逃记录入口（已完成同频出逃后展示）-->
      <view wx:if="{{groupRecordId}}" class="view-record-cta" bindtap="onViewGroupRecord">
        <text>本次出逃记录</text>
        <text class="arrow">→</text>
      </view>

      <view class="script-actions">
        <view class="regenerate-btn" bindtap="onRegenerateScript">重新生成</view>
        <view class="back-home-btn" bindtap="onBackTap">返回首页</view>
      </view>
    </view>

    <!-- ===== C-P4: Tab 区（ready/voting/generating/finished 展示）===== -->
    <view wx:if="{{showTabs}}" class="cp4-tab-section">
      <view class="cp4-tab-bar">
        <view class="cp4-tab {{activeTab === 'members' ? 'active' : ''}}" data-tab="members" bindtap="onTabTap">
          <text>成员</text>
        </view>
        <view class="cp4-tab {{activeTab === 'chat' ? 'active' : ''}}" data-tab="chat" bindtap="onTabTap">
          <text>聊天</text>
        </view>
        <view class="cp4-tab {{activeTab === 'record' ? 'active' : ''}}" data-tab="record" bindtap="onTabTap">
          <text>记录</text>
        </view>
      </view>

      <!-- 成员 Tab -->
      <view wx:if="{{activeTab === 'members'}}" class="cp4-panel cp4-members-panel">
        <view wx:for="{{room.members}}" wx:key="openId" class="cp4-member-row">
          <view class="cp4-member-avatar" style="background: {{item.isHost ? '#5CBF9E' : '#D98A5C'}};">
            <text class="cp4-member-icon">{{item.isHost ? '★' : '●'}}</text>
          </view>
          <view class="cp4-member-info">
            <text class="cp4-member-name">{{item.nickname}}</text>
            <text wx:if="{{memberTrustMap[item.openId].label}}" class="cp4-trust-tag cp4-trust-{{memberTrustMap[item.openId].tier}}">{{memberTrustMap[item.openId].label}}</text>
          </view>
          <!-- finished 后展示评价/举报入口（排除自己） -->
          <view wx:if="{{room.status === 'finished' && item.openId !== currentOpenId}}" class="cp4-member-actions">
            <text class="cp4-action-btn" data-openid="{{item.openId}}" bindtap="onReviewTap">评价</text>
            <text class="cp4-action-btn ghost" data-openid="{{item.openId}}" bindtap="onReportTap">举报</text>
          </view>
        </view>
        <view wx:if="{{room.status === 'finished'}}" class="cp4-review-hint">任务已完成，可评价同房间搭子</view>
      </view>

      <!-- 聊天 Tab -->
      <view wx:if="{{activeTab === 'chat'}}" class="cp4-panel cp4-chat-panel">
        <scroll-view scroll-y class="cp4-chat-scroll" scroll-into-view="{{chatScrollIntoView}}" enhanced show-scrollbar="{{false}}">
          <view wx:if="{{messages.length === 0}}" class="cp4-chat-empty">还没有消息，发条消息聊聊集合点吧</view>
          <view wx:for="{{messages}}" wx:key="_id" class="cp4-msg-row {{item.senderOpenId === currentOpenId ? 'mine' : 'other'}}">
            <view class="cp4-msg-bubble">
              <text wx:if="{{item.senderOpenId !== currentOpenId}}" class="cp4-msg-nickname">{{item.senderNickname || '搭子'}}</text>
              <text class="cp4-msg-content">{{item.content}}</text>
              <text wx:if="{{item.isLocal}}" class="cp4-msg-pending">发送中</text>
            </view>
          </view>
          <view id="chat-msg-last"></view>
        </scroll-view>
        <view class="cp4-chat-input-bar">
          <input class="cp4-chat-input" placeholder="说点什么..." value="{{inputContent}}" bindinput="onChatInput" confirm-type="send" bindconfirm="onSendTap" maxlength="200" />
          <view class="cp4-chat-send {{(!inputContent || chatSending) ? 'disabled' : ''}}" bindtap="onSendTap">{{chatSending ? '...' : '发送'}}</view>
        </view>
      </view>

      <!-- 记录 Tab -->
      <view wx:if="{{activeTab === 'record'}}" class="cp4-panel cp4-record-panel">
        <view wx:if="{{groupRecordId}}" class="cp4-record-entry" bindtap="onViewGroupRecord">
          <text>本次出逃记录</text>
          <text class="arrow">→</text>
        </view>
        <view wx:else class="cp4-record-empty">
          <text>{{room.status === 'finished' ? '出逃完成后可在此查看记录' : '出逃完成后可查看记录'}}</text>
        </view>
      </view>
    </view>

  </scroll-view>

  <!-- v11: 邀请朋友弹窗（个人小程序无 open-type=share 权限，降级为复制 + 提示） -->
  <view wx:if="{{showInvitePopup}}" class="invite-mask" bindtap="onInvitePopupClose">
    <view class="invite-popup" catchtap="noop">
      <view class="invite-popup-title">邀请朋友加入</view>
      <view class="invite-popup-desc">把下方房间号发给朋友，他们打开小程序后会自动进入</view>

      <view class="invite-room-card">
        <text class="invite-room-label">房间号</text>
        <text class="invite-room-id" user-select="true">{{room.roomId}}</text>
      </view>

      <view class="invite-actions">
        <view class="invite-action primary" bindtap="onCopyRoomIdFromPopup">
          <text>复制房间号</text>
        </view>
        <view class="invite-action ghost" bindtap="onCopyInviteLink">
          <text>复制邀请链接</text>
        </view>
      </view>

      <view class="invite-hint">个人小程序暂不支持微信内直接分享卡片，请用其他聊天工具发送房间号</view>

      <view class="invite-close" bindtap="onInvitePopupClose">×</view>
    </view>
  </view>

  <!-- C-P4: 评价弹窗 -->
  <view wx:if="{{showReviewModal}}" class="cp4-modal-mask" bindtap="onReviewModalClose">
    <view class="cp4-modal" catchtap="onReviewPanelTap">
      <view class="cp4-modal-title">评价搭子</view>
      <view wx:if="{{reviewTarget}}" class="cp4-modal-target">{{reviewTarget.nickname}}</view>

      <view class="cp4-stars">
        <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="cp4-star {{reviewRating >= item ? 'on' : ''}}" data-value="{{item}}" bindtap="onReviewRatingTap">★</text>
      </view>

      <view class="cp4-tag-row">
        <text wx:for="{{reviewTags}}" wx:key="*this" class="cp4-tag-chip {{reviewSelectedTagMap[item] ? 'selected' : ''}}" data-value="{{item}}" bindtap="onReviewTagTap">{{item}}</text>
      </view>

      <textarea class="cp4-textarea" placeholder="说说这位搭子（选填，≤100字）" value="{{reviewComment}}" bindinput="onReviewCommentInput" maxlength="100"></textarea>

      <view class="cp4-modal-actions">
        <view class="cp4-modal-btn ghost" bindtap="onReviewModalClose">取消</view>
        <view class="cp4-modal-btn primary {{reviewSubmitting ? 'disabled' : ''}}" bindtap="onSubmitReview">{{reviewSubmitting ? '提交中...' : '提交评价'}}</view>
      </view>
      <view class="cp4-modal-close" bindtap="onReviewModalClose">×</view>
    </view>
  </view>

  <!-- C-P4: 举报弹窗 -->
  <view wx:if="{{showReportModal}}" class="cp4-modal-mask" bindtap="onReportModalClose">
    <view class="cp4-modal" catchtap="onReportPanelTap">
      <view class="cp4-modal-title">举报搭子</view>
      <view wx:if="{{reportTarget}}" class="cp4-modal-target">{{reportTarget.nickname}}</view>

      <view class="cp4-reason-list">
        <view wx:for="{{reportReasons}}" wx:key="*this" class="cp4-reason-item {{reportSelectedReason === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="onReportReasonTap">
          <text>{{item}}</text>
        </view>
      </view>

      <view class="cp4-modal-actions">
        <view class="cp4-modal-btn ghost" bindtap="onReportModalClose">取消</view>
        <view class="cp4-modal-btn danger {{reportSubmitting ? 'disabled' : ''}}" bindtap="onSubmitReport">{{reportSubmitting ? '提交中...' : '提交举报'}}</view>
      </view>
      <view class="cp4-modal-close" bindtap="onReportModalClose">×</view>
    </view>
  </view>
</view>
